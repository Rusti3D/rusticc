+    /// A web UI addon file (loader, panel scripts and their assets) from
+    /// the first addons_path root that has it
+    fn addon_file(req: &HttpRequest, roots: &[String], path: &str) -> HttpResponse {
+        if req.method != "GET" {
+            return error_response(&HttpError::new(405), None);
+        }
+        let rel = percent_encoding::percent_decode_str(path).decode_utf8_lossy().to_string();
+        let rel = Path::new(&rel);
+        if rel.components().any(|c| !matches!(c, std::path::Component::Normal(_))) {
+            return error_response(&HttpError::new(404), None);
+        }
+        for root in roots {
+            let full = Path::new(root).join(rel);
+            if !full.is_file() {
+                continue;
+            }
+            return match std::fs::read(&full) {
+                Ok(data) => {
+                    let ctype = crate::pymimetypes::guess_type(&full.to_string_lossy()).0;
+                    let mut resp = HttpResponse::new(200);
+                    resp.set_header("Content-Type", ctype.unwrap_or_else(|| "application/octet-stream".into()));
+                    // addon files are small and change on updates
+                    resp.set_header("Cache-Control", "no-cache");
+                    resp.set_body(data);
+                    resp
+                }
+                Err(_) => error_response(&HttpError::new(500), None),
+            };
+        }
+        error_response(&HttpError::new(404), None)
+    }
+
+    /// The installed addon panels: <root>/panels/<name>/panel.js of every
+    /// root, the first root winning a name, sorted by name
+    fn addon_manifest(req: &HttpRequest, roots: &[String]) -> HttpResponse {
+        if req.method != "GET" {
+            return error_response(&HttpError::new(405), None);
+        }
+        let mut panels = std::collections::BTreeMap::new();
+        for root in roots {
+            let Ok(dir) = std::fs::read_dir(Path::new(root).join("panels")) else { continue };
+            for entry in dir.flatten() {
+                let name = entry.file_name().to_string_lossy().to_string();
+                if !panels.contains_key(&name) && entry.path().join("panel.js").is_file() {
+                    let script = format!("/addons/panels/{}/panel.js", name);
+                    panels.insert(name.clone(), json!({"name": name, "script": script}));
+                }
+            }
+        }
+        let mut resp = HttpResponse::new(200);
+        resp.set_header("Content-Type", "application/json; charset=UTF-8");
+        resp.set_header("Cache-Control", "no-cache");
+        resp.set_body(json!({"panels": panels.into_values().collect::<Vec<_>>()}).to_string());
+        resp
+    }
+

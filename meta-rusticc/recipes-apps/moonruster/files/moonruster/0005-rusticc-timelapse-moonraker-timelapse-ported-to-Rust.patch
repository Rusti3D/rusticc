+#[cfg(test)]
+mod tests {
+    // the frame numbers python's regex finds in these lines (checked with CPython)
+    #[test]
+    fn progress_frame_as_python() {
+        let line = "frame=  120 fps= 15 q=28.0 size=     256kB time=00:00:04.00 bitrate= 524.3kbits/s speed=0.5x";
+        assert_eq!(super::progress_frame(line), Some(120.0));
+        assert_eq!(super::progress_frame("Input #0, image2, from frame%6d.jpg:"), None);
+        assert_eq!(super::progress_frame("  Stream #0:0: Video: mjpeg, yuvj420p(pc), 1280x720, 30 fps"), Some(0.0));
+    }

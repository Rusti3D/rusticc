+/// str.split(None, 1)
+fn py_split_maxsplit1(l: &str) -> Vec<String> {
+    let t = l.trim_start();
+    if t.is_empty() {
+        return vec![];
+    }
+    match t.find(char::is_whitespace) {
+        Some(i) => vec![t[..i].to_string(), t[i..].trim_start().to_string()],
+        None => vec![t.to_string()],
+    }
+}

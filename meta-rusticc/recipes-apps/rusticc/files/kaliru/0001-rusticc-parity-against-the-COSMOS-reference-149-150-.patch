+            let got = got.as_ref().map(|((c, m), n)| (*c, m.as_str(), n.iter().map(String::as_str).collect::<Vec<_>>()));
+            let want = want.map(|(c, m, n)| (c, m, n.to_vec()));
+            assert_eq!(got, want, "{}", src);
+        }
     }
 }

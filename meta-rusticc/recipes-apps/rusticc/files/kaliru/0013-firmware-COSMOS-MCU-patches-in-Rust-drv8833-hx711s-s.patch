new file mode 100644
index 0000000..6d560dd
--- /dev/null
+++ b/firmware/src/sensor_hx711s.rs
@@ -0,0 +1,398 @@
+// Support for multi-sensor HX711 and HX717 ADC chips (COSMOS
+// 0007-Add-HX711s-load-cell-probe-driver, src/sensor_hx711s.c)
+//
+// Copyright (C) 2026 James Turton <james.turton@gmx.com>
+// Original HX711 driver Copyright (C) 2024 Gareth Farrington <gareth@waves.ky>
+//
+// This file may be distributed under the terms of the GNU GPLv3 license.
+use crate::basecmd::{oid_alloc, oid_lookup, OidType};
+use crate::board::{
+    gpio_in_read, gpio_in_setup, gpio_out_setup, gpio_out_toggle_noirq, gpio_out_write, irq_disable, irq_enable, irq_poll, timer_from_us,
+    timer_is_before, timer_read_time, GpioIn, GpioOut,
+};
+use crate::command::Args;
+use crate::config::CONFIG_MACH_AVR;
+use crate::ctr::Global;
+use crate::load_cell_probe::{load_cell_probe_oid_lookup, load_cell_probe_report_sample, LoadCellProbe};
+use crate::sched::{sched_add_timer, sched_check_wake, sched_del_timer, sched_wake_task, TaskWake, Timer, R, SF_RESCHEDULE};
+use crate::sensor_bulk::{sensor_bulk_report, sensor_bulk_reset, sensor_bulk_status, SensorBulk};
+use crate::{decl_command, decl_task, shutdown};
+use core::mem::size_of;
+
+const MAX_SENSORS: usize = 4;
+
+// Each chip runs its own read state machine. The chips free-run on their
+// own oscillators with no way to synchronise them, so a chip is polled and
+// read on its own data ready edge and never waits on a sibling. Reading a
+// chip only when every chip is ready would leave the earliest one holding
+// its result until the drift between oscillators pushed that wait onto its
+// next conversion, tearing the frame being clocked out.
+#[repr(C)]
+struct Hx711sChip {
+    timer: Timer,
+    adc: *mut Hx711sAdc, // the sensor this chip belongs to
+    dout: GpioIn,        // pin used to receive data from the hx711s
+    sclk: GpioOut,       // pin used to generate clock for the hx711s
+    counts: i32,         // most recent reading, held until the chip is read again
+    counts_ticks: u32,   // when counts was last refreshed
+    index: u8,
+    flags: u8,
+    settle_remaining: u8, // conversions still to discard after a wake
+}
+
+#[repr(C)]
+struct Hx711sAdc {
+    gain_channel: u8, // the gain+channel selection (1-4)
+    sensor_count: u8, // number of chips in use (1-4)
+    sample_bytes: u8, // bytes in one multi-channel sample
+    chip_mask: u8,    // bit per configured chip
+    have_counts: u8,  // chips that have produced a reading
+    rest_ticks: u32,
+    last_error: u32,
+    chips: [Hx711sChip; MAX_SENSORS],
+    sb: SensorBulk,
+    lce: *mut LoadCellProbe,
+}
+
+const HX_PENDING: u8 = 1 << 0;
+const HX_OVERFLOW: u8 = 1 << 1;
+
+const BYTES_PER_SAMPLE: u8 = 4;
+const SETTLE_CONVERSIONS: u8 = 4;
+const STALE_CONVERSIONS: u32 = 3;
+const SAMPLE_ERROR_DESYNC: u32 = 1 << 31;
+const SAMPLE_ERROR_READ_TOO_LONG: u32 = 1 << 30;
+
+static WAKE_HX711S: Global<TaskWake> = Global::new(TaskWake::new());
+
+fn oid_type() -> OidType {
+    command_config_hx711s as *const ()
+}
+
+/****************************************************************
+ * Low-level bit-banging
+ ****************************************************************/
+
+fn min_pulse_time() -> u32 {
+    nsecs_to_ticks(200)
+}
+
+fn nsecs_to_ticks(ns: u32) -> u32 {
+    timer_from_us(ns.wrapping_mul(1000)) / 1000000
+}
+
+// Pause for 200ns
+fn hx711s_delay_noirq() {
+    if CONFIG_MACH_AVR {
+        // Optimize avr, as calculating time takes longer than needed delay
+        unsafe { core::arch::asm!("nop", "nop") };
+        return;
+    }
+    let end = timer_read_time().wrapping_add(min_pulse_time());
+    while timer_is_before(timer_read_time(), end) {}
+}
+
+// Pause for a minimum of 200ns
+fn hx711s_delay() -> R {
+    if CONFIG_MACH_AVR {
+        // Optimize avr, as calculating time takes longer than needed delay
+        return Ok(());
+    }
+    let end = timer_read_time().wrapping_add(min_pulse_time());
+    while timer_is_before(timer_read_time(), end) {
+        irq_poll()?;
+    }
+    Ok(())
+}
+
+// Read 'num_bits' from one chip
+fn hx711s_raw_read(dout: GpioIn, sclk: GpioOut, num_bits: u32) -> R<u32> {
+    let mut bits_read: u32 = 0;
+    for _ in 0..num_bits {
+        irq_disable();
+        gpio_out_toggle_noirq(sclk);
+        hx711s_delay_noirq();
+        gpio_out_toggle_noirq(sclk);
+        let bit = gpio_in_read(dout);
+        irq_enable();
+        hx711s_delay()?;
+        bits_read = (bits_read << 1) | bit as u32;
+    }
+    Ok(bits_read)
+}
+
+/****************************************************************
+ * Multi-sensor HX711 and HX717 Support
+ ****************************************************************/
+
+// Check if data is ready
+fn hx711s_is_data_ready(chip: &Hx711sChip) -> bool {
+    gpio_in_read(chip.dout) == 0
+}
+
+// Event handler that wakes wake_hx711s() periodically. One timer per chip,
+// so a chip that is slow to convert cannot delay polling of the others.
+unsafe fn hx711s_event(timer: *mut Timer) -> R<u8> {
+    // (the timer is the chip's first field: container_of)
+    let chip = &mut *(timer as *mut Hx711sChip);
+    let hx711s = &mut *chip.adc;
+    let mut rest_ticks = hx711s.rest_ticks;
+    let flags = chip.flags;
+    if flags & HX_PENDING != 0 {
+        hx711s.sb.possible_overflows = hx711s.sb.possible_overflows.wrapping_add(1);
+        chip.flags = HX_PENDING | HX_OVERFLOW;
+        rest_ticks = rest_ticks.wrapping_mul(4);
+    } else if hx711s_is_data_ready(chip) {
+        // New sample pending
+        chip.flags = HX_PENDING;
+        sched_wake_task(WAKE_HX711S.ptr());
+        rest_ticks = rest_ticks.wrapping_mul(8);
+    }
+    chip.timer.waketime = chip.timer.waketime.wrapping_add(rest_ticks);
+    Ok(SF_RESCHEDULE)
+}
+
+// The load cell is the sum of every chip, the value the probe triggers on
+fn hx711s_sum(hx711s: &Hx711sAdc) -> i32 {
+    let mut sum: i32 = 0;
+    for i in 0..hx711s.sensor_count as usize {
+        sum = sum.wrapping_add(hx711s.chips[i].counts);
+    }
+    sum
+}
+
+// Emit one sample carrying the latest reading from every chip
+fn add_sample(hx711s: &mut Hx711sAdc, oid: u8, force_flush: bool) -> R {
+    for i in 0..hx711s.sensor_count as usize {
+        let mut counts = hx711s.chips[i].counts as u32;
+
+        // forever send errors until reset
+        if hx711s.last_error != 0 {
+            counts = hx711s.last_error;
+        }
+
+        // Add measurement to buffer
+        let dc = hx711s.sb.data_count as usize;
+        hx711s.sb.data[dc..dc + 4].copy_from_slice(&counts.to_le_bytes());
+        hx711s.sb.data_count += BYTES_PER_SAMPLE;
+    }
+
+    if hx711s.sb.data_count as usize + hx711s.sample_bytes as usize > hx711s.sb.data.len() || force_flush {
+        sensor_bulk_report(&mut hx711s.sb, oid)?;
+    }
+    Ok(())
+}
+
+// hx711s ADC query
+fn hx711s_read_adc(hx711s: &mut Hx711sAdc, i: usize) -> R {
+    // Read from sensor
+    let gain_channel = hx711s.gain_channel as u32;
+    let (dout, sclk) = (hx711s.chips[i].dout, hx711s.chips[i].sclk);
+    let adc = hx711s_raw_read(dout, sclk, 24 + gain_channel)?;
+
+    // Clear pending flag (and note if an overflow occurred)
+    irq_disable();
+    let flags = hx711s.chips[i].flags;
+    hx711s.chips[i].flags = 0;
+    irq_enable();
+
+    // Discard the first 4 conversions after a wake as it hasn't settled yet
+    let chip = &mut hx711s.chips[i];
+    if chip.settle_remaining != 0 {
+        chip.settle_remaining -= 1;
+        return Ok(());
+    }
+
+    // Extract report from raw data
+    let mut counts = adc >> gain_channel;
+    if counts & 0x800000 != 0 {
+        counts |= 0xFF000000;
+    }
+
+    // Check for errors
+    let extras_mask = (1u32 << gain_channel) - 1;
+    if (adc & extras_mask) != extras_mask {
+        // Transfer did not complete correctly
+        hx711s.last_error = SAMPLE_ERROR_DESYNC;
+    } else if flags & HX_OVERFLOW != 0 {
+        // Transfer took too long
+        hx711s.last_error = SAMPLE_ERROR_READ_TOO_LONG;
+    } else {
+        let chip = &mut hx711s.chips[i];
+        chip.counts = counts as i32;
+        chip.counts_ticks = timer_read_time();
+        hx711s.have_counts |= 1 << chip.index;
+    }
+    Ok(())
+}
+
+// Create a hx711s sensor
+pub fn command_config_hx711s(args: &Args) -> R {
+    let hx711s = unsafe { &mut *(oid_alloc(args[0] as u8, oid_type(), size_of::<Hx711sAdc>() as u16)? as *mut Hx711sAdc) };
+    let sensor_count = args[1] as u8;
+    if !(1..=MAX_SENSORS as u8).contains(&sensor_count) {
+        shutdown!("HX711S sensor count out of range 1-4");
+    }
+    hx711s.sensor_count = sensor_count;
+    hx711s.sample_bytes = sensor_count * BYTES_PER_SAMPLE;
+    hx711s.chip_mask = ((1u32 << sensor_count) - 1) as u8;
+    let gain_channel = args[2] as u8;
+    if !(1..=4).contains(&gain_channel) {
+        shutdown!("HX711S gain/channel out of range 1-4");
+    }
+    hx711s.gain_channel = gain_channel;
+    let adc: *mut Hx711sAdc = hx711s;
+    for i in 0..sensor_count as usize {
+        let chip = &mut hx711s.chips[i];
+        chip.timer.func = Some(hx711s_event);
+        chip.adc = adc;
+        chip.index = i as u8;
+    }
+    Ok(())
+}
+decl_command!(
+    command_config_hx711s,
+    concat!("config_hx711s oid=%c sensor_count=%c", " gain_channel=%c")
+);
+
+fn lookup(oid: u8) -> R<&'static mut Hx711sAdc> {
+    Ok(unsafe { &mut *(oid_lookup(oid, oid_type())? as *mut Hx711sAdc) })
+}
+
+// Assign the pins of one chip
+pub fn command_add_hx711s(args: &Args) -> R {
+    let oid = args[0] as u8;
+    let hx711s = lookup(oid)?;
+    let index = args[1] as u8;
+    if index >= hx711s.sensor_count {
+        shutdown!("HX711S sensor index out of range");
+    }
+    let chip = &mut hx711s.chips[index as usize];
+    chip.dout = gpio_in_setup(args[2], 1)?;
+    chip.sclk = gpio_out_setup(args[3], 0)?;
+    gpio_out_write(chip.sclk, 1); // put chip in power down state
+    Ok(())
+}
+decl_command!(
+    command_add_hx711s,
+    concat!("add_hx711s oid=%c index=%c", " dout_pin=%u sclk_pin=%u")
+);
+
+pub fn hx711s_attach_load_cell_probe(args: &Args) -> R {
+    let oid = args[0] as u8;
+    let hx711s = lookup(oid)?;
+    hx711s.lce = load_cell_probe_oid_lookup(args[1] as u8)?;
+    Ok(())
+}
+decl_command!(
+    hx711s_attach_load_cell_probe,
+    concat!("hx711s_attach_load_cell_probe", " oid=%c load_cell_probe_oid=%c")
+);
+
+// start/stop capturing ADC data
+pub fn command_query_hx711s(args: &Args) -> R {
+    let oid = args[0] as u8;
+    let hx711s = lookup(oid)?;
+    for i in 0..hx711s.sensor_count as usize {
+        sched_del_timer(&mut hx711s.chips[i].timer);
+        hx711s.chips[i].flags = 0;
+    }
+    hx711s.last_error = 0;
+    hx711s.have_counts = 0;
+    hx711s.rest_ticks = args[1];
+    if hx711s.rest_ticks == 0 {
+        // End measurements
+        for i in 0..hx711s.sensor_count as usize {
+            gpio_out_write(hx711s.chips[i].sclk, 1); // power down state
+        }
+        return Ok(());
+    }
+    // Start new measurements
+    for i in 0..hx711s.sensor_count as usize {
+        gpio_out_write(hx711s.chips[i].sclk, 0); // wake chip from power down
+    }
+    sensor_bulk_reset(&mut hx711s.sb);
+    irq_disable();
+    let waketime = timer_read_time().wrapping_add(hx711s.rest_ticks);
+    for i in 0..hx711s.sensor_count as usize {
+        let chip = &mut hx711s.chips[i];
+        chip.settle_remaining = SETTLE_CONVERSIONS;
+        chip.counts_ticks = waketime;
+        chip.timer.waketime = waketime;
+        sched_add_timer(&mut chip.timer)?;
+    }
+    irq_enable();
+    Ok(())
+}
+decl_command!(command_query_hx711s, "query_hx711s oid=%c rest_ticks=%u");
+
+pub fn command_query_hx711s_status(args: &Args) -> R {
+    let oid = args[0] as u8;
+    let hx711s = lookup(oid)?;
+    irq_disable();
+    let start_t = timer_read_time();
+    // The primary chip paces the sample stream, so only a conversion pending
+    // on that chip is a sample the host has not been sent yet
+    let is_data_ready = hx711s_is_data_ready(&hx711s.chips[0]);
+    irq_enable();
+    let pending_bytes = if is_data_ready { hx711s.sample_bytes } else { 0 };
+    sensor_bulk_status(&hx711s.sb, oid, start_t, 0, pending_bytes as u32)
+}
+decl_command!(command_query_hx711s_status, "query_hx711s_status oid=%c");
+
+// Background task that performs measurements
+pub fn hx711s_capture_task() -> R {
+    if !sched_check_wake(WAKE_HX711S.ptr()) {
+        return Ok(());
+    }
+    let mut oid: u8 = 255;
+    loop {
+        let p = crate::basecmd::oid_next(&mut oid, oid_type());
+        if p.is_null() {
+            break;
+        }
+        let hx711s = unsafe { &mut *(p as *mut Hx711sAdc) };
+        // Read every chip holding data before emitting, so a sample carries
+        // the freshest reading available from each of them
+        let mut read_primary = false;
+        for i in 0..hx711s.sensor_count as usize {
+            if hx711s.chips[i].flags == 0 {
+                continue;
+            }
+            hx711s_read_adc(hx711s, i)?;
+            if i == 0 {
+                read_primary = true;
+            }
+        }
+        // Drop a chip that has stopped producing readings. Its held counts
+        // are stale and a sum missing a cell reads low, which would trigger
+        // the probe late or not at all. A poll is a tenth of a conversion.
+        let stale_ticks = hx711s.rest_ticks.wrapping_mul(10).wrapping_mul(STALE_CONVERSIONS);
+        let now = timer_read_time();
+        for i in 0..hx711s.sensor_count as usize {
+            if timer_is_before(hx711s.chips[i].counts_ticks.wrapping_add(stale_ticks), now) {
+                hx711s.have_counts &= !(1 << i);
+            }
+        }
+        // The primary chip sets the sample rate. Its conversions are evenly
+        // spaced, which is what the host clock tracking assumes, while the
+        // remaining channels are held at their most recent reading. Wait for
+        // every chip to report once so no sample carries an unset channel.
+        if read_primary && (hx711s.last_error != 0 || hx711s.have_counts == hx711s.chip_mask) {
+            // probe is optional, report if enabled. Reporting here rather
+            // than on each chip read keeps the probe's filter running at the
+            // rate its coefficients were designed for. A bad frame is still
+            // reported: the held counts are at most one conversion old, far
+            // too little to move the force past the trigger, and withholding
+            // reports would starve the probe watchdog and abort the homing
+            // move instead.
+            if hx711s.last_error == 0 && !hx711s.lce.is_null() {
+                load_cell_probe_report_sample(hx711s.lce, hx711s_sum(hx711s))?;
+            }
+            // Add measurement to buffer
+            add_sample(hx711s, oid, false)?;
+        }
+    }
+    Ok(())
+}
+decl_task!(hx711s_capture_task);

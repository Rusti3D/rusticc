@@ -95,6 +95,34 @@ use port::*;
 
 const CR1_FLAGS: u32 = USART_CR1_UE | USART_CR1_RE | USART_CR1_TE | USART_CR1_RXNEIE;
 
+// (COSMOS 0005-stm32-serial-rs485-de-pin: drive an RS-485 transceiver's
+// enable pin while transmitting)
+#[cfg(CONFIG_STM32_SERIAL_RS485)]
+mod rs485 {
+    use super::*;
+    use crate::board::GpioOut;
+    use crate::config::CONFIG_STM32_SERIAL_RS485_DE_PIN;
+    use crate::ctr::Global;
+    decl_constant_str!("RESERVE_PINS_serial_de", CONFIG_STM32_SERIAL_RS485_DE_PIN);
+    // Parse "PA12" style pin names; the compiler folds this to a constant
+    const DE_STR: &[u8] = CONFIG_STM32_SERIAL_RS485_DE_PIN.as_bytes();
+    pub const GPIO_DE: u32 = GPIO(
+        DE_STR[1] as char,
+        if DE_STR.len() > 3 { (DE_STR[2] - b'0') as u32 * 10 + (DE_STR[3] - b'0') as u32 } else { (DE_STR[2] - b'0') as u32 },
+    );
+    // Once the buffer drains, wait for the last stop bit before releasing DE
+    pub const CR1_TX_DONE: u32 = CR1_FLAGS | USART_CR1_TCIE;
+    pub static DE_PIN: Global<GpioOut> = Global::new(unsafe { core::mem::zeroed() });
+    // Responder turnaround: after the last received byte, stay off the bus
+    // until the host has had time to release its own driver.
+    pub static LAST_RX_TIME: Global<u32> = Global::new(0);
+    pub static DE_ACTIVE: Global<u8> = Global::new(0);
+}
+#[cfg(not(CONFIG_STM32_SERIAL_RS485))]
+const CR1_TX_DONE: u32 = CR1_FLAGS;
+#[cfg(CONFIG_STM32_SERIAL_RS485)]
+use rs485::*;
+
 #[unsafe(no_mangle)]
 pub unsafe extern "C" fn USARTx_IRQHandler() {
     let usart = &*USARTx;
@@ -102,24 +130,66 @@ pub unsafe extern "C" fn USARTx_IRQHandler() {
     if sr & (USART_SR_RXNE | USART_SR_ORE) != 0 {
         // The ORE flag is automatically cleared by reading SR, followed
         // by reading DR.
+        #[cfg(CONFIG_STM32_SERIAL_RS485)]
+        {
+            *LAST_RX_TIME.get() = crate::board::timer_read_time();
+        }
         serial_rx_byte(usart.DR.read() as u8);
     }
-    if sr & USART_SR_TXE != 0 && usart.CR1.read() & USART_CR1_TXEIE != 0 {
+    #[allow(unused_mut, unused_assignments)]
+    let mut cr1 = usart.CR1.read();
+    if sr & USART_SR_TXE != 0 && cr1 & USART_CR1_TXEIE != 0 {
         let mut data = 0;
         let ret = serial_get_tx_byte(&mut data);
         if ret != 0 {
-            usart.CR1.write(CR1_FLAGS);
+            cr1 = CR1_TX_DONE;
+            usart.CR1.write(cr1);
         } else {
             usart.DR.write(data as u32);
         }
     }
+    #[cfg(CONFIG_STM32_SERIAL_RS485)]
+    {
+        // TC is cleared by the SR read + DR write above, so a set TC here
+        // means the shift register really is empty.
+        if sr & USART_SR_TC != 0 && cr1 & USART_CR1_TCIE != 0 {
+            usart.CR1.write(CR1_FLAGS);
+            crate::board::gpio_out_write(*DE_PIN.get(), 0);
+            *DE_ACTIVE.get() = 0;
+        }
+    }
 }
 
+#[cfg(not(CONFIG_STM32_SERIAL_RS485))]
 pub fn serial_enable_tx_irq() {
     unsafe { &*USARTx }.CR1.write(CR1_FLAGS | USART_CR1_TXEIE);
 }
 
+#[cfg(CONFIG_STM32_SERIAL_RS485)]
+pub fn serial_enable_tx_irq() {
+    use crate::board::{irq_restore, irq_save, timer_from_us, timer_read_time};
+    use crate::config::CONFIG_STM32_SERIAL_RS485_TURNAROUND_US;
+    use core::ptr::read_volatile;
+    if unsafe { read_volatile(DE_ACTIVE.ptr()) } == 0 {
+        // Wait out the turnaround time (irqs enabled; restarts while the
+        // host is still sending)
+        let gap = timer_from_us(CONFIG_STM32_SERIAL_RS485_TURNAROUND_US);
+        while timer_read_time().wrapping_sub(unsafe { read_volatile(LAST_RX_TIME.ptr()) }) < gap {}
+    }
+    // Raise DE and cancel any pending TC release together, so the IRQ
+    // can't drop DE between the two.
+    let flag = irq_save();
+    *DE_ACTIVE.get() = 1;
+    crate::board::gpio_out_write(*DE_PIN.get(), 1);
+    unsafe { &*USARTx }.CR1.write(CR1_FLAGS | USART_CR1_TXEIE);
+    irq_restore(flag);
+}
+
 pub fn serial_init() -> R {
+    #[cfg(CONFIG_STM32_SERIAL_RS485)]
+    {
+        *DE_PIN.get() = crate::board::gpio_out_setup(GPIO_DE, 0)?;
+    }
     let usart = unsafe { &*USARTx };
     enable_pclock(USARTx as u32);
 

diff --git a/firmware/src/drv8833.rs b/firmware/src/drv8833.rs
new file mode 100644
index 0000000..19b9c32
--- /dev/null
+++ b/firmware/src/drv8833.rs
@@ -0,0 +1,372 @@
+// MCU-side DRV8833 hall-based speed controller (COSMOS
+// 0003-drv8833-motor-control, src/drv8833.c)
+//
+// Copyright (C) 2026
+//
+// This file may be distributed under the terms of the GNU GPLv3 license.
+use crate::basecmd::{oid_alloc, oid_lookup, OidType};
+use crate::board::{gpio_in_read, gpio_in_setup, gpio_pwm_setup, gpio_pwm_write, irq_disable, irq_enable, timer_is_before, timer_read_time, GpioIn, GpioPwm};
+use crate::command::Args;
+use crate::config::CONFIG_CLOCK_FREQ;
+use crate::ctr::Global;
+use crate::sched::{sched_add_timer, sched_check_wake, sched_del_timer, sched_wake_task, TaskWake, Timer, R, SF_RESCHEDULE};
+use crate::{decl_command, decl_task, sendf};
+use core::mem::size_of;
+
+const DUTY_SCALE: i32 = 10;
+const DUTY_MAX: i32 = 100 * DUTY_SCALE;
+const SPEED_SMOOTH_DIV: i32 = 8;
+const SPEED_SCALE: i64 = 1000;
+const PID_PARAM_SCALE: i64 = 1000;
+
+#[repr(C)]
+struct Drv8833 {
+    timer: Timer,
+    hall_pin: GpioIn,
+    motor_fwd: GpioPwm,
+    motor_rwd: GpioPwm,
+    poll_ticks: u32,
+    control_ticks: u32,
+    report_ticks: u32,
+    next_control_time: u32,
+    next_report_time: u32,
+    count: u32,
+    stop_count: u32,
+    last_edge_time: u32,
+    last_interval_ticks: u32,
+    hall_resolution: u32,
+    speed_mm_s_x1000: u32,
+    target_speed_mm_s_x1000: u32,
+    integral: i64,
+    previous_error: i32,
+    pid_kp: u32,
+    pid_ki: u32,
+    pid_kd: u32,
+    duty_x10: u16,
+    default_duty_x10: u16,
+    max_duty_step_x10: u16,
+    pwm_max: u16,
+    flags: u8,
+    direction: u8,
+    last_hall_value: u8,
+}
+
+const DF_ACTIVE: u8 = 1 << 0;
+const DF_PENDING: u8 = 1 << 1;
+const DF_MANUAL: u8 = 1 << 2;
+
+static DRV8833_WAKE: Global<TaskWake> = Global::new(TaskWake::new());
+
+fn oid_type() -> OidType {
+    command_config_drv8833 as *const ()
+}
+
+fn drv8833_calc_speed(d: &Drv8833, delta_count: u32, delta_ticks: u32) -> u32 {
+    if delta_count == 0 || delta_ticks == 0 {
+        return 0;
+    }
+    let numer = (delta_count as u64).wrapping_mul(d.hall_resolution as u64).wrapping_mul(CONFIG_CLOCK_FREQ as u64);
+    (numer / (delta_ticks as u64).wrapping_mul(1000)) as u32
+}
+
+fn drv8833_calc_measured_speed(d: &Drv8833, time: u32) -> u32 {
+    if d.last_edge_time == 0 {
+        return 0;
+    }
+    let age_ticks = time.wrapping_sub(d.last_edge_time);
+    let mut measured_interval = if d.last_interval_ticks != 0 { d.last_interval_ticks } else { age_ticks };
+    if age_ticks > measured_interval {
+        measured_interval = age_ticks;
+    }
+    drv8833_calc_speed(d, 1, measured_interval)
+}
+
+fn drv8833_update_speed(d: &mut Drv8833, time: u32) -> u32 {
+    let measured_speed = drv8833_calc_measured_speed(d, time);
+    if d.speed_mm_s_x1000 == 0 {
+        d.speed_mm_s_x1000 = measured_speed;
+    } else {
+        let delta = (measured_speed as i32).wrapping_sub(d.speed_mm_s_x1000 as i32) / SPEED_SMOOTH_DIV;
+        d.speed_mm_s_x1000 = d.speed_mm_s_x1000.wrapping_add(delta as u32);
+    }
+    d.speed_mm_s_x1000
+}
+
+fn drv8833_integral_limit(d: &Drv8833) -> i64 {
+    if d.pid_ki == 0 {
+        return 0x7fffffffffffffff;
+    }
+    (DUTY_MAX as i64 * PID_PARAM_SCALE * SPEED_SCALE * CONFIG_CLOCK_FREQ as i64) / d.pid_ki as i64
+}
+
+fn drv8833_apply_pwm(d: &mut Drv8833) {
+    let mut pwm_value: u32 = 0;
+    if d.flags & DF_ACTIVE != 0 && d.duty_x10 != 0 {
+        pwm_value = (d.duty_x10 as u32 * d.pwm_max as u32 + DUTY_MAX as u32 / 2) / DUTY_MAX as u32;
+    }
+    if d.direction != 0 {
+        gpio_pwm_write(d.motor_fwd, pwm_value as u16);
+        gpio_pwm_write(d.motor_rwd, 0);
+    } else {
+        gpio_pwm_write(d.motor_fwd, 0);
+        gpio_pwm_write(d.motor_rwd, pwm_value as u16);
+    }
+}
+
+fn drv8833_control_update(d: &mut Drv8833, _time: u32) {
+    if d.flags & DF_ACTIVE == 0 || d.flags & DF_MANUAL != 0 {
+        return;
+    }
+
+    if d.target_speed_mm_s_x1000 == 0 {
+        return;
+    }
+
+    let error = (d.target_speed_mm_s_x1000 as i32).wrapping_sub(d.speed_mm_s_x1000 as i32);
+    let derivative = error.wrapping_sub(d.previous_error);
+    let mut next_integral = d.integral.wrapping_add((error as i64).wrapping_mul(d.control_ticks as i64));
+    let integral_limit = drv8833_integral_limit(d);
+    if next_integral < integral_limit.wrapping_neg() {
+        next_integral = integral_limit.wrapping_neg();
+    } else if next_integral > integral_limit {
+        next_integral = integral_limit;
+    }
+
+    let p_term = ((d.pid_kp as i64).wrapping_mul(error as i64) / (PID_PARAM_SCALE * SPEED_SCALE)) as i32;
+    let i_term = ((d.pid_ki as i64).wrapping_mul(next_integral) / (PID_PARAM_SCALE * SPEED_SCALE * CONFIG_CLOCK_FREQ as i64)) as i32;
+    let mut d_term: i32 = 0;
+    if d.control_ticks != 0 {
+        d_term = ((d.pid_kd as i64).wrapping_mul(derivative as i64).wrapping_mul(CONFIG_CLOCK_FREQ as i64)
+            / (PID_PARAM_SCALE * SPEED_SCALE * d.control_ticks as i64)) as i32;
+    }
+
+    let mut target_duty = (d.default_duty_x10 as i32).wrapping_add(p_term).wrapping_add(i_term).wrapping_add(d_term);
+    if target_duty < 0 {
+        target_duty = 0;
+    } else if target_duty > DUTY_MAX {
+        target_duty = DUTY_MAX;
+    }
+
+    if !((target_duty == 0 && error < 0) || (target_duty == DUTY_MAX && error > 0)) {
+        d.integral = next_integral;
+    }
+
+    let mut delta_duty = target_duty.wrapping_sub(d.duty_x10 as i32);
+    if delta_duty < -(d.max_duty_step_x10 as i32) {
+        delta_duty = -(d.max_duty_step_x10 as i32);
+    } else if delta_duty > d.max_duty_step_x10 as i32 {
+        delta_duty = d.max_duty_step_x10 as i32;
+    }
+
+    d.duty_x10 = d.duty_x10.wrapping_add(delta_duty as u16);
+    d.previous_error = error;
+    drv8833_apply_pwm(d);
+}
+
+fn drv8833_reset_state(d: &mut Drv8833) {
+    d.count = 0;
+    d.stop_count = 0;
+    d.last_edge_time = 0;
+    d.last_interval_ticks = 0;
+    d.speed_mm_s_x1000 = 0;
+    d.integral = 0;
+    d.previous_error = 0;
+}
+
+unsafe fn drv8833_event(timer: *mut Timer) -> R<u8> {
+    // (the timer is the first field: container_of)
+    let d = &mut *(timer as *mut Drv8833);
+    let time = d.timer.waketime;
+
+    let hall_value = gpio_in_read(d.hall_pin);
+    if hall_value != d.last_hall_value {
+        d.count = d.count.wrapping_add(1);
+        if d.last_edge_time != 0 {
+            d.last_interval_ticks = time.wrapping_sub(d.last_edge_time);
+        }
+        d.last_edge_time = time;
+        d.last_hall_value = hall_value;
+        if d.flags & DF_ACTIVE != 0 && d.stop_count != 0 && d.count >= d.stop_count {
+            d.flags &= !(DF_ACTIVE | DF_MANUAL);
+            d.target_speed_mm_s_x1000 = 0;
+            d.stop_count = 0;
+            d.integral = 0;
+            d.previous_error = 0;
+            d.duty_x10 = 0;
+            drv8833_apply_pwm(d);
+            d.flags |= DF_PENDING;
+            sched_wake_task(DRV8833_WAKE.ptr());
+        }
+    }
+
+    if !timer_is_before(time, d.next_control_time) {
+        d.next_control_time = time.wrapping_add(d.control_ticks);
+        drv8833_update_speed(d, time);
+        drv8833_control_update(d, time);
+    }
+    if d.flags & DF_ACTIVE != 0 && !timer_is_before(time, d.next_report_time) {
+        d.next_report_time = time.wrapping_add(d.report_ticks);
+        d.flags |= DF_PENDING;
+        sched_wake_task(DRV8833_WAKE.ptr());
+    }
+
+    d.timer.waketime = d.timer.waketime.wrapping_add(d.poll_ticks);
+    Ok(SF_RESCHEDULE)
+}
+
+pub fn command_config_drv8833(args: &Args) -> R {
+    let d = unsafe { &mut *(oid_alloc(args[0] as u8, oid_type(), size_of::<Drv8833>() as u16)? as *mut Drv8833) };
+    d.motor_fwd = gpio_pwm_setup(args[1], args[3], 0)?;
+    d.motor_rwd = gpio_pwm_setup(args[2], args[3], 0)?;
+    d.hall_pin = gpio_in_setup(args[4], args[5] as crate::board::GpioPullUp)?;
+    d.poll_ticks = args[6];
+    d.control_ticks = args[7];
+    d.report_ticks = args[8];
+    d.hall_resolution = args[9];
+    d.pwm_max = args[10] as u16;
+    d.default_duty_x10 = args[11] as u16;
+    d.max_duty_step_x10 = args[12] as u16;
+    d.pid_kp = 0;
+    d.pid_ki = 0;
+    d.pid_kd = 0;
+    d.last_hall_value = gpio_in_read(d.hall_pin);
+    d.direction = 1;
+    d.timer.func = Some(drv8833_event);
+    Ok(())
+}
+decl_command!(
+    command_config_drv8833,
+    concat!(
+        "config_drv8833 oid=%c motor_fwd_pin=%u motor_rwd_pin=%u",
+        " cycle_ticks=%u hall_pin=%u hall_pullup=%c poll_ticks=%u",
+        " control_ticks=%u report_ticks=%u hall_resolution=%u",
+        " pwm_max=%hu default_duty=%hu max_duty_step=%hu"
+    )
+);
+
+fn lookup(oid: u8) -> R<&'static mut Drv8833> {
+    Ok(unsafe { &mut *(oid_lookup(oid, oid_type())? as *mut Drv8833) })
+}
+
+pub fn command_drv8833_set(args: &Args) -> R {
+    let d = lookup(args[0] as u8)?;
+    sched_del_timer(&mut d.timer);
+    d.flags &= !DF_PENDING;
+
+    if args[1] == 0 {
+        d.flags &= !(DF_ACTIVE | DF_MANUAL);
+        d.target_speed_mm_s_x1000 = 0;
+        drv8833_reset_state(d);
+        d.duty_x10 = 0;
+        drv8833_apply_pwm(d);
+        return Ok(());
+    }
+
+    let now = timer_read_time();
+    d.flags = (d.flags & !DF_MANUAL) | DF_ACTIVE | DF_PENDING;
+    d.direction = (args[2] != 0) as u8;
+    d.target_speed_mm_s_x1000 = args[3];
+    drv8833_reset_state(d);
+    d.stop_count = args[4];
+    d.duty_x10 = d.default_duty_x10;
+    d.last_hall_value = gpio_in_read(d.hall_pin);
+    d.next_control_time = now;
+    d.next_report_time = now;
+    drv8833_apply_pwm(d);
+    d.timer.waketime = now.wrapping_add(d.poll_ticks);
+    sched_add_timer(&mut d.timer)?;
+    sched_wake_task(DRV8833_WAKE.ptr());
+    Ok(())
+}
+decl_command!(
+    command_drv8833_set,
+    concat!("drv8833_set oid=%c enable=%c direction=%c target_speed=%u", " stop_ticks=%u")
+);
+
+pub fn command_drv8833_manual(args: &Args) -> R {
+    let d = lookup(args[0] as u8)?;
+
+    if args[1] != 0 && d.flags & DF_ACTIVE != 0 && d.flags & DF_MANUAL != 0 {
+        d.direction = (args[2] != 0) as u8;
+        d.duty_x10 = if args[3] > DUTY_MAX as u32 { DUTY_MAX as u16 } else { args[3] as u16 };
+        drv8833_apply_pwm(d);
+        return Ok(());
+    }
+
+    sched_del_timer(&mut d.timer);
+    d.flags &= !DF_PENDING;
+
+    if args[1] == 0 {
+        d.flags &= !(DF_ACTIVE | DF_MANUAL);
+        d.target_speed_mm_s_x1000 = 0;
+        drv8833_reset_state(d);
+        d.duty_x10 = 0;
+        drv8833_apply_pwm(d);
+        return Ok(());
+    }
+
+    let now = timer_read_time();
+    d.flags |= DF_ACTIVE | DF_PENDING | DF_MANUAL;
+    d.direction = (args[2] != 0) as u8;
+    d.target_speed_mm_s_x1000 = 0;
+    drv8833_reset_state(d);
+    d.duty_x10 = if args[3] > DUTY_MAX as u32 { DUTY_MAX as u16 } else { args[3] as u16 };
+    d.last_hall_value = gpio_in_read(d.hall_pin);
+    d.next_control_time = now;
+    d.next_report_time = now;
+    drv8833_apply_pwm(d);
+    d.timer.waketime = now.wrapping_add(d.poll_ticks);
+    sched_add_timer(&mut d.timer)?;
+    sched_wake_task(DRV8833_WAKE.ptr());
+    Ok(())
+}
+decl_command!(command_drv8833_manual, "drv8833_manual oid=%c enable=%c direction=%c duty=%hu");
+
+pub fn command_drv8833_set_pid(args: &Args) -> R {
+    let d = lookup(args[0] as u8)?;
+    irq_disable();
+    d.pid_kp = args[1];
+    d.pid_ki = args[2];
+    d.pid_kd = args[3];
+    d.integral = 0;
+    d.previous_error = 0;
+    irq_enable();
+    Ok(())
+}
+decl_command!(command_drv8833_set_pid, "drv8833_set_pid oid=%c kp=%u ki=%u kd=%u");
+
+pub fn drv8833_task() -> R {
+    if !sched_check_wake(DRV8833_WAKE.ptr()) {
+        return Ok(());
+    }
+
+    let mut oid: u8 = 255;
+    loop {
+        let p = crate::basecmd::oid_next(&mut oid, oid_type());
+        if p.is_null() {
+            break;
+        }
+        let d = unsafe { &mut *(p as *mut Drv8833) };
+        irq_disable();
+        let flags = d.flags;
+        let count = d.count;
+        let speed = d.speed_mm_s_x1000;
+        let duty = d.duty_x10;
+        d.flags = flags & !DF_PENDING;
+        irq_enable();
+        if flags & DF_PENDING == 0 {
+            continue;
+        }
+        sendf!(
+            "drv8833_status oid=%c active=%c manual=%c count=%u speed=%u duty=%hu",
+            oid,
+            (flags & DF_ACTIVE != 0) as u8,
+            (flags & DF_MANUAL != 0) as u8,
+            count,
+            speed,
+            duty
+        )?;
+    }
+    Ok(())
+}
+decl_task!(drv8833_task);

+// Multi-Sensor HX711 and HX717 Support (port of COSMOS's
+// klippy/extras/load_cell/hx711s.py, 0007-Add-HX711s-load-cell-probe-driver)
+//
+// Copyright (C) 2026 James Turton <james.turton@gmx.com>
+// Original HX711 driver Copyright (C) 2024 Gareth Farrington <gareth@waves.ky>
+//
+// This file may be distributed under the terms of the GNU GPLv3 license.
+use super::{adc_batch, batch_helper, lookup_pin, no_cmd, BulkAdcSensor};
+use crate::configfile::{ConfigWrapper, Dflt};
+use crate::error::{KError, KResult};
+use crate::extras::bulk_sensor::{BatchBulkHelper, ClientCallback, FixedFreqReader};
+use crate::logging;
+use crate::mcu::{CommandWrapper, Mcu};
+use crate::msgproto::Val;
+use crate::printer::Printer;
+use crate::pyfmt::py_round;
+use crate::pyval::PyVal;
+use std::cell::{Cell, RefCell};
+use std::rc::Rc;
+
+// Constants
+const UPDATE_INTERVAL: f64 = 0.10;
+const SAMPLE_ERROR_DESYNC: i64 = -0x80000000;
+const SAMPLE_ERROR_LONG_READ: i64 = 0x40000000;
+
+// Implementation of multiple HX711 and HX717 chips as one load cell
+pub struct HX711SBase {
+    printer: Rc<Printer>,
+    name: String,
+    pub error_count: Cell<i64>,
+    consecutive_fails: Cell<i64>,
+    sensor_type: &'static str,
+    sensor_count: usize,
+    mcu: Rc<Mcu>,
+    oid: i64,
+    sps: i64,
+    ffreader: FixedFreqReader,
+    batch_bulk: RefCell<Option<Rc<BatchBulkHelper>>>,
+    query_hx711s_cmd: RefCell<Option<CommandWrapper>>,
+    attach_probe_cmd: RefCell<Option<CommandWrapper>>,
+}
+
+impl HX711SBase {
+    fn new(
+        config: &ConfigWrapper,
+        sensor_type: &'static str,
+        sample_rate_options: &[(i64, i64)],
+        default_sample_rate: i64,
+        gain_options: &[(&str, i64)],
+        default_gain: &str,
+    ) -> KResult<Rc<dyn BulkAdcSensor>> {
+        let printer = config.get_printer();
+        let name = config.get_name().split_whitespace().last().unwrap_or_default().to_string();
+        // Chip options
+        let pin_names = |option: &str| -> KResult<Vec<String>> {
+            Ok(config.get(option, Dflt::Required)?.split(',').map(|p| crate::pyfmt::py_strip(p).to_string()).collect())
+        };
+        let dout_pin_names = pin_names("dout_pins")?;
+        let sclk_pin_names = pin_names("sclk_pins")?;
+        if dout_pin_names.len() != sclk_pin_names.len() {
+            return Err(KError::config(format!("{}: dout_pins and sclk_pins must have the same number of entries", sensor_type)));
+        }
+        let sensor_count = dout_pin_names.len();
+        if !(1..=4).contains(&sensor_count) {
+            return Err(KError::config(format!("{}: must specify 1 to 4 sensor pin pairs", sensor_type)));
+        }
+        // Resolve all pins and validate they share one MCU
+        let dout_ppins = dout_pin_names.iter().map(|p| lookup_pin(config, p)).collect::<KResult<Vec<_>>>()?;
+        let sclk_ppins = sclk_pin_names.iter().map(|p| lookup_pin(config, p)).collect::<KResult<Vec<_>>>()?;
+        let mcu = dout_ppins[0].0.clone();
+        if dout_ppins[1..].iter().chain(&sclk_ppins).any(|(m, _)| !Rc::ptr_eq(m, &mcu)) {
+            return Err(KError::config(format!("{}: all pins must be on the same MCU", sensor_type)));
+        }
+        // Samples per second choices
+        let sps = config.getchoice_int("sample_rate", sample_rate_options, default_sample_rate)?;
+        // gain/channel choices
+        let gain_channel = config.getchoice("gain", gain_options, default_gain)?;
+        let oid = mcu.create_oid();
+        // Bulk Sensor Setup
+        // Clock tracking
+        let chip_smooth = sps as f64 * UPDATE_INTERVAL * 2.0;
+        let unpack_format = format!("<{}", "i".repeat(sensor_count));
+        let ffreader = FixedFreqReader::new(&mcu, chip_smooth, &unpack_format);
+        let s = Rc::new(HX711SBase {
+            printer: printer.clone(),
+            name,
+            error_count: Cell::new(0),
+            consecutive_fails: Cell::new(0),
+            sensor_type,
+            sensor_count,
+            mcu: mcu.clone(),
+            oid,
+            sps,
+            ffreader,
+            batch_bulk: RefCell::new(None),
+            query_hx711s_cmd: RefCell::new(None),
+            attach_probe_cmd: RefCell::new(None),
+        });
+        // Process messages in batches
+        *s.batch_bulk.borrow_mut() = Some(batch_helper(
+            &printer,
+            &s,
+            HX711SBase::process_batch,
+            HX711SBase::start_measurements,
+            HX711SBase::finish_measurements,
+            UPDATE_INTERVAL,
+        ));
+        // Command Configuration
+        mcu.add_config_cmd(
+            &format!("config_hx711s oid={} sensor_count={} gain_channel={}", oid, sensor_count, gain_channel),
+            false,
+            false,
+        );
+        for (i, ((_, dout), (_, sclk))) in dout_ppins.iter().zip(&sclk_ppins).enumerate() {
+            mcu.add_config_cmd(&format!("add_hx711s oid={} index={} dout_pin={} sclk_pin={}", oid, i, dout, sclk), false, false);
+        }
+        mcu.add_config_cmd(&format!("query_hx711s oid={} rest_ticks=0", oid), false, true);
+        let w = Rc::downgrade(&s);
+        mcu.register_config_callback(Rc::new(move || match w.upgrade() {
+            Some(s) => s.build_config(),
+            None => Ok(()),
+        }));
+        Ok(s)
+    }
+
+    fn build_config(&self) -> KResult<()> {
+        *self.query_hx711s_cmd.borrow_mut() = Some(self.mcu.lookup_command("query_hx711s oid=%c rest_ticks=%u", None)?);
+        *self.attach_probe_cmd.borrow_mut() =
+            Some(self.mcu.lookup_command("hx711s_attach_load_cell_probe oid=%c load_cell_probe_oid=%c", None)?);
+        self.ffreader.setup_query_command("query_hx711s_status oid=%c", self.oid, Some(self.mcu.alloc_command_queue()))
+    }
+
+    // Start, stop, and process message batches
+    fn start_measurements(&self) -> KResult<()> {
+        self.consecutive_fails.set(0);
+        // Start bulk reading
+        let rest_ticks = self.mcu.seconds_to_clock(1.0 / (10.0 * self.sps as f64));
+        self.query_hx711s_cmd.borrow().as_ref().ok_or_else(no_cmd)?.send(&[Val::Int(self.oid), Val::Int(rest_ticks)], 0, 0)?;
+        logging::info(&format!("{} starting '{}' measurements", self.sensor_type, self.name));
+        // Initialize clock tracking
+        self.ffreader.note_start()
+    }
+
+    fn finish_measurements(&self) -> KResult<()> {
+        // don't use serial connection after shutdown
+        if self.printer.is_shutdown() {
+            return Ok(());
+        }
+        // Halt bulk reading
+        self.query_hx711s_cmd.borrow().as_ref().ok_or_else(no_cmd)?.send_wait_ack(&[Val::Int(self.oid), Val::Int(0)], 0, 0)?;
+        self.ffreader.note_end()?;
+        logging::info(&format!("{} finished '{}' measurements", self.sensor_type, self.name));
+        Ok(())
+    }
+
+    fn process_batch(&self, _eventtime: f64) -> KResult<PyVal> {
+        let (samples, overflows) = self.ffreader.pull_samples()?;
+        let (samples, batch_errors) = convert_samples(&self.name, &samples);
+        self.error_count.set(self.error_count.get() + batch_errors);
+        if batch_errors > 0 {
+            logging::error(&format!("{}: Forced sensor restart due to error", self.name));
+            self.finish_measurements()?;
+            self.start_measurements()?;
+        } else if overflows > 0 {
+            self.consecutive_fails.set(self.consecutive_fails.get() + 1);
+            if self.consecutive_fails.get() > 4 {
+                logging::error(&format!("{}: Forced sensor restart due to overflows", self.name));
+                self.finish_measurements()?;
+                self.start_measurements()?;
+            }
+        } else {
+            self.consecutive_fails.set(0);
+        }
+        Ok(adc_batch(samples, batch_errors, overflows))
+    }
+}
+
+impl BulkAdcSensor for HX711SBase {
+    fn get_mcu(&self) -> Rc<Mcu> {
+        self.mcu.clone()
+    }
+
+    fn get_samples_per_second(&self) -> i64 {
+        self.sps
+    }
+
+    // returns a tuple of the minimum and maximum value of the sensor, used to
+    // detect if a data value is saturated
+    fn get_range(&self) -> (i64, i64) {
+        (-0x800000, 0x7FFFFF)
+    }
+
+    fn get_channel_count(&self) -> usize {
+        self.sensor_count
+    }
+
+    // add_client interface, direct pass through to bulk_sensor API
+    fn add_client(&self, callback: ClientCallback) -> KResult<()> {
+        self.batch_bulk.borrow().clone().ok_or_else(no_cmd)?.add_client(callback)
+    }
+
+    fn attach_load_cell_probe(&self, load_cell_probe_oid: i64) -> KResult<()> {
+        self.attach_probe_cmd.borrow().as_ref().ok_or_else(no_cmd)?.send(&[Val::Int(self.oid), Val::Int(load_cell_probe_oid)], 0, 0)
+    }
+}
+
+// Measurement decoding: rows of (time, count, value per chip) and the batch's
+// errors; an error sample ends the batch. (COSMOS's staticmethod logs with
+// self.name, a NameError there; the sensor's name is logged here)
+pub fn convert_samples(name: &str, samples: &[(f64, Vec<i64>)]) -> (Vec<PyVal>, i64) {
+    let adc_factor = 1.0 / (1i64 << 23) as f64;
+    let mut batch_errors = 0;
+    let mut out = vec![];
+    for (ptime, channel_counts) in samples {
+        let val = channel_counts[0];
+        if val == SAMPLE_ERROR_DESYNC {
+            batch_errors += 1;
+            logging::error(&format!("{}: DESYNC at t={:.3}", name, ptime));
+            break; // errors latch in the MCU, the rest are duplicates
+        } else if val == SAMPLE_ERROR_LONG_READ {
+            batch_errors += 1;
+            logging::error(&format!("{}: READ_TOO_LONG at t={:.3}", name, ptime));
+            break; // errors latch in the MCU, the rest are duplicates
+        }
+        let mut converted = vec![PyVal::Float(py_round(*ptime, 6))];
+        for &ch in channel_counts {
+            converted.push(PyVal::Int(ch));
+            converted.push(PyVal::Float(py_round(ch as f64 * adc_factor, 9)));
+        }
+        out.push(PyVal::Tuple(converted));
+    }
+    (out, batch_errors)
+}
+
+pub fn new_hx711s(config: &ConfigWrapper) -> KResult<Rc<dyn BulkAdcSensor>> {
+    HX711SBase::new(
+        config,
+        "hx711s",
+        // HX711 sps options
+        &[(80, 80), (10, 10)],
+        80,
+        // HX711 gain/channel options
+        &[("A-128", 1), ("B-32", 2), ("A-64", 3)],
+        "A-128",
+    )
+}
+
+pub fn new_hx717s(config: &ConfigWrapper) -> KResult<Rc<dyn BulkAdcSensor>> {
+    HX711SBase::new(
+        config,
+        "hx717s",
+        // HX717 sps options
+        &[(320, 320), (80, 80), (20, 20), (10, 10)],
+        320,
+        // HX717 gain/channel options
+        &[("A-128", 1), ("B-64", 2), ("A-64", 3), ("B-8", 4)],
+        "A-128",
+    )
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// _convert_samples as COSMOS's python gives it
+    #[test]
+    fn convert() {
+        let errors = Cell::new(0);
+        let rows = convert_samples("lc", &[(1.23456789, vec![71000, -5, 8388607, -8388608]), (1.2468, vec![1, 2, 3, 4]), (2.0000005, vec![-2147483648, 1, 1, 1]), (3.0, vec![9, 9, 9, 9])], &errors);
+        assert_eq!(rows, vec![PyVal::Tuple(vec![PyVal::Float(1.234568), PyVal::Int(71000), PyVal::Float(0.00846386), PyVal::Int(-5), PyVal::Float(-5.96e-07), PyVal::Int(8388607), PyVal::Float(0.999999881), PyVal::Int(-8388608), PyVal::Float(-1.0)]), PyVal::Tuple(vec![PyVal::Float(1.2468), PyVal::Int(1), PyVal::Float(1.19e-07), PyVal::Int(2), PyVal::Float(2.38e-07), PyVal::Int(3), PyVal::Float(3.58e-07), PyVal::Int(4), PyVal::Float(4.77e-07)])]);
+        assert_eq!(errors.get(), 1);
+        let errors = Cell::new(0);
+        let rows = convert_samples("lc", &[(0.1, vec![123456]), (0.2, vec![1073741824]), (0.3, vec![5])], &errors);
+        assert_eq!(rows, vec![PyVal::Tuple(vec![PyVal::Float(0.1), PyVal::Int(123456), PyVal::Float(0.014717102)])]);
+        assert_eq!(errors.get(), 1);
+        let errors = Cell::new(0);
+        let rows = convert_samples("lc", &[(10.123456789, vec![-71000, 70999])], &errors);
+        assert_eq!(rows, vec![PyVal::Tuple(vec![PyVal::Float(10.123457), PyVal::Int(-71000), PyVal::Float(-0.00846386), PyVal::Int(70999), PyVal::Float(0.00846374)])]);
+        assert_eq!(errors.get(), 0);
+    }
+}

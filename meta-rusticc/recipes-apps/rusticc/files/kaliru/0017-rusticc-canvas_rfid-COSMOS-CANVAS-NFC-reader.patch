+// Elegoo Canvas RFID module (port of COSMOS's klippy/extras/canvas_rfid.py)
+//
+// Copyright (C) 2026  James Turton <james.turton@gmx.com>
+//
+// This file may be distributed under the terms of the GNU GPLv3 license.
+//
+// The reader is an MCU-fronted MFRC522-class NFC-A module on I2C address 0x50,
+// bit-banged from the Canvas MCU. It reads NTAG21x tags only. Tag contents are
+// decoded with the OpenRFID tag processors
+// (https://github.com/suchmememanyskill/OpenRFID), a python library: they run
+// on the plugins' CPython, imported from its tree as COSMOS does.
+//
+//   request: A0 . 00 . seq . CLASS . CMD . len16 . data . XOR(CLASS..data)
+//   reply:   A0 . 00 . seq . CLASS . STATUS . len16 . data . check byte
+//
+// Unimplemented or not-yet-processed commands are answered with a copy of the
+// request, so replies are read after a fixed delay and echoes are retried.
+use crate::configfile::{ConfigWrapper, Lim};
+use crate::error::{KError, KResult};
+use crate::extras::bus::{mcu_i2c_from_config, McuI2c};
+use crate::extras::gcode_macro::{create_template_context, load_gcode_macro, Template};
+use crate::extras::print_stats::PrintStats;
+use crate::gcode::{GCodeCommand, GCodeDispatch};
+use crate::jinja::value::Value;
+use crate::logging;
+use crate::msgproto::Val;
+use crate::plugins::py::{self, PyRef};
+use crate::printer::{PObj, Printer, PrinterObject};
+use crate::pyval::{PyDict, PyVal};
+use crate::reactor::{Reactor, ReactorMutex, Timer, NEVER, NOW};
+use std::cell::{Cell, RefCell};
+use std::rc::Rc;
+
+const FRAME_ADDR: u8 = 0xA0;
+const CLS_MODULE: u8 = 0x01;
+const CLS_NTAG: u8 = 0x03;
+const CMD_MODULE_INFO: u8 = 0x01;
+const CMD_HOT_START: u8 = 0x03;
+const CMD_TAG_ID: u8 = 0x06;
+const CMD_IDENTIFY_PAGE: u8 = 0x09;
+const CMD_MULTI_PAGE_READ: u8 = 0x06;
+const STATUS_OK: u8 = 0x00;
+const REPLY_OVERHEAD: usize = 8; // 7 header bytes + XOR
+// 11 pages = 52-byte reply, the most that fits in one i2c_read_response
+const MAX_READ_PAGES: i64 = 11;
+// Physical page count (incl. header and config pages) by CC size byte
+const PAGE_COUNTS_BY_CC_SIZE: [(u8, i64); 4] = [
+    (0x06, 16),  // MIFARE Ultralight
+    (0x12, 45),  // NTAG213
+    (0x3E, 135), // NTAG215
+    (0x6D, 231), // NTAG216
+];
+// NTAG213 incl. config pages, used when the capability container is unknown
+const DEFAULT_LAST_PAGE: i64 = 44;
+const READ_RETRY_TIME: f64 = 5.0;
+const ELEGOO_MAGIC: [u8; 4] = [0x36, 0xEE, 0xEE, 0xEE];
+
+// OpenRFID processors for tags this module can read (NTAG / Ultralight)
+const PROCESSORS: [(&str, &str, &str); 6] = [
+    ("elegoo", "tag.elegoo.processor", "ElegooTagProcessor"),
+    ("tigertag", "tag.tigertag.processor", "TigerTagProcessor"),
+    ("openspool", "tag.openspool.processor", "OpenspoolTagProcessor"),
+    ("opentag3d", "tag.opentag3d.processor", "OpenTag3DTagProcessor"),
+    ("spoolease", "tag.spoolease.processor", "SpooleaseTagProcessor"),
+    ("anycubic", "tag.anycubic.processor", "AnycubicTagProcessor"),
+];
+
+fn xor8(data: &[u8]) -> u8 {
+    data.iter().fold(0, |c, b| c ^ b)
+}
+
+fn build_frame(cls: u8, cmd: u8, data: &[u8], seq: u8) -> Vec<u8> {
+    let mut body = vec![cls, cmd, (data.len() >> 8) as u8, data.len() as u8];
+    body.extend_from_slice(data);
+    let mut frame = vec![FRAME_ADDR, 0, seq];
+    frame.extend_from_slice(&body);
+    frame.push(xor8(&body));
+    frame
+}
+
+/// (status, data), or None if the reply is an echo of the request (not
+/// processed yet), a stale reply to another command, or fails its checks
+fn parse_reply(frame: &[u8], rx: &[u8]) -> Option<(u8, Vec<u8>)> {
+    if rx.len() < REPLY_OVERHEAD || rx[..frame.len().min(rx.len())] == *frame {
+        return None;
+    }
+    let n = ((rx[5] as usize) << 8) | rx[6] as usize;
+    if rx[0] != FRAME_ADDR || rx[3] != frame[3] {
+        return None;
+    }
+    if rx.len() < n + REPLY_OVERHEAD {
+        return None;
+    }
+    Some((rx[4], rx[7..7 + n].to_vec()))
+}
+
+fn tag_last_page(head: &[u8]) -> i64 {
+    // Capability container (page 3): E1 . version . NDEF area size / 8 . access.
+    // The NDEF area can be smaller than the user memory (NTAG215/216), so map
+    // the factory CC size to the chip's physical page count, as OpenRFID does
+    let cc = head.get(12..16).unwrap_or(&[]);
+    if cc.len() == 4 && cc[0] == 0xE1 {
+        if let Some((_, pages)) = PAGE_COUNTS_BY_CC_SIZE.iter().find(|(size, _)| *size == cc[2]) {
+            return pages - 1;
+        }
+    }
+    DEFAULT_LAST_PAGE
+}
+
+/// bytes(data) as a python object
+fn py_bytes(data: &[u8]) -> KResult<PyRef> {
+    let items: Vec<PyRef> = data.iter().map(|b| py::py_int(*b as i64)).collect();
+    py::lookup("builtins", "bytes")?.call(&[&py::py_list(items)])
+}
+
+/// The OpenRFID tag processors, imported from an OpenRFID src tree
+struct OpenRfid {
+    scan_result: PyRef,
+    ultralight: PyRef,
+    processors: Vec<PyRef>,
+}
+
+impl OpenRfid {
+    fn new(path: &str, names: &[String]) -> KResult<OpenRfid> {
+        crate::plugins::ensure_started()?;
+        let sys_path = py::lookup("sys", "path")?;
+        if !sys_path.call_method("__contains__", &[&py::py_str(path)])?.is_true()? {
+            sys_path.call_method("append", &[&py::py_str(path)])?;
+        }
+        let scan_result = py::import("reader.scan_result")?.getattr("ScanResult")?;
+        let ultralight = py::import("tag.tag_types")?.getattr("TagType")?.getattr("MifareUltralight")?;
+        let mut processors = vec![];
+        for name in names {
+            let (_, module, cls) = PROCESSORS.iter().find(|(n, _, _)| n == name).expect("checked in CanvasRfid::new");
+            let proc = py::import(module)?.getattr(cls)?;
+            let mut arg = PyDict::default();
+            arg.insert("__name".into(), PyVal::Str(name.clone()));
+            processors.push(proc.call(&[&py::from_pyval(&PyVal::Dict(arg))])?);
+        }
+        Ok(OpenRfid { scan_result, ultralight, processors })
+    }
+
+    /// the filament dict of the first processor that recognises the tag
+    fn identify(&self, uid: &str, data: &[u8]) -> KResult<Option<PyVal>> {
+        let fromhex = py::lookup("builtins", "bytes")?.getattr("fromhex")?;
+        let scan = self.scan_result.call(&[
+            &self.ultralight,
+            &fromhex.call(&[&py::py_str(uid)])?,
+            &py_bytes(&[0x00, 0x44])?,
+            &py_bytes(&[])?,
+            &py_bytes(&[0x00])?,
+        ])?;
+        let data = py_bytes(data)?;
+        for proc in &self.processors {
+            let filament = match proc.call_method("process_tag", &[&scan, &data]) {
+                Ok(f) => f,
+                Err(e) => {
+                    let name = proc.getattr("name").and_then(|n| n.str()).unwrap_or_default();
+                    logging::info(&format!("canvas_rfid: {} processor: {}", name, e.message()));
+                    continue;
+                }
+            };
+            if filament.is_none() {
+                continue;
+            }
+            let mut result = py::to_pyval(&filament.call_method("to_dict", &[])?)?;
+            if let PyVal::Dict(d) = &mut result {
+                let rgb = d.get("rgb").and_then(|v| v.as_i64()).unwrap_or(0);
+                d.insert("color_hex".into(), PyVal::Str(format!("{:06X}", rgb)));
+            }
+            return Ok(Some(result));
+        }
+        Ok(None)
+    }
+}
+
+pub struct CanvasRfid {
+    printer: Rc<Printer>,
+    reactor: Rc<Reactor>,
+    name: String,
+    i2c: Rc<McuI2c>,
+    use_seq: bool,
+    init_module: bool,
+    poll_interval: f64,
+    poll_while_printing: bool,
+    reply_delay: f64,
+    retries: i64,
+    max_pages: i64,
+    openrfid: OpenRfid,
+    tag_gcode: Option<Rc<Template>>,
+    seq: Cell<u8>,
+    lock: Rc<ReactorMutex>,
+    initialized: Cell<bool>,
+    version: RefCell<Option<String>>,
+    print_stats: RefCell<Option<Rc<PrintStats>>>,
+    failed_uid: RefCell<Option<String>>,
+    failed_until: Cell<f64>,
+    uid: RefCell<Option<String>>,
+    /// Result of the last tag read; kept after the tag is removed
+    filament: RefCell<Option<PyVal>>,
+    scan_id: Cell<i64>,
+    scan_time: Cell<f64>,
+    errors: Cell<i64>,
+    poll_timer: RefCell<Option<Timer>>,
+}
+
+const CMD_QUERY_CANVAS_RFID_HELP: &str = "Report the spool tag on a Canvas RFID reader";
+const CMD_CANVAS_RFID_DUMP_HELP: &str = "Dump the pages of the tag on a Canvas reader";
+
+impl CanvasRfid {
+    fn new(config: &ConfigWrapper) -> KResult<Rc<Self>> {
+        let printer = config.get_printer();
+        let reactor = printer.get_reactor();
+        let name = config.get_name().split_whitespace().last().unwrap_or_default().to_string();
+        let i2c = mcu_i2c_from_config(config, Some(0x50), 100000)?;
+        let variant = config.getchoice("variant", &[("cc1", "cc1"), ("cc2", "cc2")], "cc1")?;
+        // This command filter all tags to a specific manufacturer which we don't
+        // want to do
+        let init_module = config.getboolean("init_module", false)?;
+        let poll_interval = config.getfloat("poll_interval", 1.0, Lim::new().min(0.2))?;
+        let poll_while_printing = config.getboolean("poll_while_printing", false)?;
+        let reply_delay = config.getfloat("reply_delay", 0.05, Lim::new().min(0.01).max(1.0))?;
+        let retries = config.getint("retries", 3, Lim::new().min(0))?;
+        let max_pages = config.getint("max_pages", 231, Lim::new().min(MAX_READ_PAGES).max(256))?;
+        let default_names = PyVal::List(PROCESSORS.iter().map(|(n, _, _)| PyVal::from(*n)).collect());
+        let names = config.getlist("openrfid_processors", default_names, ",", None)?.unwrap_or_default();
+        for n in &names {
+            if !PROCESSORS.iter().any(|(p, _, _)| p == n) {
+                return Err(KError::config(format!("canvas_rfid: unknown openrfid processor '{}'", n)));
+            }
+        }
+        let path = config.get("openrfid_path", "/usr/share/openrfid")?;
+        let openrfid = OpenRfid::new(&path, &names)
+            // (python raises the config error inside the except: the import
+            // error is its __context__)
+            .map_err(|e| KError::config(format!("canvas_rfid: cannot load OpenRFID from {}: {}", path, e.message())).with_context(e))?;
+        let gcode_macro = load_gcode_macro(config)?;
+        let tag_gcode = match config.get_opt("tag_gcode")? {
+            Some(_) => Some(gcode_macro.load_template(config, "tag_gcode", None)?),
+            None => None,
+        };
+        let r = Rc::new(CanvasRfid {
+            printer: printer.clone(),
+            reactor: reactor.clone(),
+            name: name.clone(),
+            i2c,
+            use_seq: variant == "cc1",
+            init_module,
+            poll_interval,
+            poll_while_printing,
+            reply_delay,
+            retries,
+            max_pages,
+            openrfid,
+            tag_gcode,
+            seq: Cell::new(0),
+            lock: reactor.mutex(false),
+            initialized: Cell::new(false),
+            version: RefCell::new(None),
+            print_stats: RefCell::new(None),
+            failed_uid: RefCell::new(None),
+            failed_until: Cell::new(0.0),
+            uid: RefCell::new(None),
+            filament: RefCell::new(None),
+            scan_id: Cell::new(0),
+            scan_time: Cell::new(0.0),

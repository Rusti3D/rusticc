+
+    // Low-level transaction
+    fn transact(&self, cls: u8, cmd: u8, data: &[u8], rxlen: usize) -> KResult<Option<(u8, Vec<u8>)>> {
+        let mut seq = 0;
+        if self.use_seq {
+            seq = self.seq.get();
+            self.seq.set(seq.wrapping_add(1));
+        }
+        let frame = build_frame(cls, cmd, data, seq);
+        self.lock.lock()?;
+        let res = (|| -> KResult<Option<(u8, Vec<u8>)>> {
+            self.i2c.i2c_write(&frame[1..], 0, 0)?; // the MCU sends the address byte
+            for _ in 0..=self.retries {
+                self.reactor.pause(self.reactor.monotonic() + self.reply_delay)?;
+                let params = self.i2c.i2c_read(&[], rxlen as i64, true)?;
+                let rx = match params.get("response") {
+                    Some(Val::Bytes(b)) => b.clone(),
+                    _ => vec![],
+                };
+                if let Some(reply) = parse_reply(&frame, &rx) {
+                    return Ok(Some(reply));
+                }
+            }
+            Ok(None)
+        })();
+        self.lock.unlock();
+        let reply = res?;
+        if reply.is_none() {
+            self.errors.set(self.errors.get() + 1);
+        }
+        Ok(reply)
+    }
+
+    fn read_pages(&self, start: i64, end: i64) -> KResult<Option<Vec<u8>>> {
+        let mut data = vec![];
+        let mut first = start;
+        while first <= end {
+            let last = (first + MAX_READ_PAGES - 1).min(end);
+            let n = (last - first + 1) as usize;
+            let reply = self.transact(CLS_NTAG, CMD_MULTI_PAGE_READ, &[first as u8, last as u8], 4 * n + REPLY_OVERHEAD)?;
+            match reply {
+                Some((STATUS_OK, d)) if d.len() == 4 * n => data.extend_from_slice(&d),
+                _ => return Ok(None),
+            }
+            first += MAX_READ_PAGES;
+        }
+        Ok(Some(data))
+    }
+
+    fn read_tag(&self) -> KResult<Option<Vec<u8>>> {
+        // Pages 0-10 hold the capability container, which gives the tag size
+        let Some(head) = self.read_pages(0, MAX_READ_PAGES - 1)? else { return Ok(None) };
+        let last = tag_last_page(&head).min(self.max_pages - 1);
+        if last < MAX_READ_PAGES {
+            return Ok(Some(head[..(4 * (last + 1) as usize).min(head.len())].to_vec()));
+        }
+        let Some(rest) = self.read_pages(MAX_READ_PAGES, last)? else { return Ok(None) };
+        Ok(Some([head, rest].concat()))
+    }
+
+    fn init_module(&self) -> KResult<()> {
+        // What the stock cc1 firmware sends at boot: hot start, then only
+        // report tags whose page 16 starts with the Elegoo magic
+        self.transact(CLS_MODULE, CMD_HOT_START, &[], 8)?;
+        let mut ident = vec![0x00, 0x10];
+        ident.extend_from_slice(&ELEGOO_MAGIC);
+        self.transact(CLS_MODULE, CMD_IDENTIFY_PAGE, &ident, 8)?;
+        Ok(())
+    }
+
+    fn read_module_info(&self) -> KResult<()> {
+        // "HW version SW version release date", e.g. "EF-A5-V1.0.072 V1.01 20250625"
+        match self.transact(CLS_MODULE, CMD_MODULE_INFO, &[], 40)? {
+            Some((STATUS_OK, data)) => {
+                // (bytes.decode("ascii", "replace").strip())
+                let s: String = data.iter().map(|&b| if b < 0x80 { b as char } else { '\u{FFFD}' }).collect();
+                let version = crate::pyfmt::py_strip(&s).to_string();
+                logging::info(&format!("canvas_rfid {}: module {}", self.name, version));
+                *self.version.borrow_mut() = Some(version);
+            }
+            _ => logging::warning(&format!("canvas_rfid {}: no module info reply", self.name)),
+        }
+        Ok(())
+    }
+
+    fn poll_event(self: &Rc<Self>, eventtime: f64) -> f64 {
+        match self.poll(eventtime) {
+            Ok(t) => t,
+            Err(e) => {
+                // (python: the exception escapes the reactor timer)
+                self.printer.unhandled_exception(&e);
+                NEVER
+            }
+        }
+    }
+
+    fn poll(self: &Rc<Self>, eventtime: f64) -> KResult<f64> {
+        let next = eventtime + self.poll_interval;
+        if !self.poll_while_printing {
+            if let Some(ps) = self.print_stats.borrow().as_ref() {
+                if *ps.state.borrow() == "printing" {
+                    return Ok(next);
+                }
+            }
+        }
+        if !self.initialized.get() {
+            self.read_module_info()?;
+            if self.init_module {
+                self.init_module()?;
+            }
+            self.initialized.set(true);
+        }
+        let Some((status, data)) = self.transact(CLS_MODULE, CMD_TAG_ID, &[], 16)? else { return Ok(next) };
+        // data = [uid length, uid...]
+        if status != STATUS_OK || data.is_empty() || data[0] as usize != data.len() - 1 {
+            if self.uid.borrow().is_some() {
+                self.respond("tag removed");
+                *self.uid.borrow_mut() = None;
+                self.send_tag_event(PyVal::None, PyVal::None)?;
+            }
+            return Ok(next);
+        }
+        let uid: String = data[1..].iter().map(|b| format!("{:02X}", b)).collect();
+        if self.uid.borrow().as_deref() == Some(uid.as_str()) {
+            return Ok(next);
+        }
+        if self.failed_uid.borrow().as_deref() == Some(uid.as_str()) && eventtime < self.failed_until.get() {
+            return Ok(next);
+        }
+        let Some(pages) = self.read_tag()? else {
+            // e.g. MIFARE Classic, or a tag at the edge of the field
+            if self.failed_uid.borrow().as_deref() != Some(uid.as_str()) {
+                self.respond(&format!("tag {} not readable (not NTAG?)", uid));
+            }
+            *self.failed_uid.borrow_mut() = Some(uid);
+            self.failed_until.set(eventtime + READ_RETRY_TIME);
+            return Ok(next);
+        };
+        *self.uid.borrow_mut() = Some(uid.clone());
+        let filament = self.openrfid.identify(&uid, &pages)?;
+        *self.filament.borrow_mut() = filament.clone();
+        match &filament {
+            None => self.respond(&format!("tag {}: unrecognised tag", uid)),
+            Some(_) => {
+                self.scan_id.set(self.scan_id.get() + 1);
+                self.scan_time.set(eventtime);
+                self.respond(&format!("tag {}: {}", uid, self.describe()));
+            }
+        }
+        self.send_tag_event(PyVal::Str(uid), filament.unwrap_or(PyVal::None))?;
+        if self.tag_gcode.is_some() {
+            let r = self.clone();
+            self.reactor.register_callback(move |et| r.run_tag_gcode(et), NOW);
+        }
+        Ok(next)
+    }
+
+    /// send_event("canvas_rfid:tag", name, uid, filament)
+    fn send_tag_event(&self, uid: PyVal, filament: PyVal) -> KResult<()> {
+        self.printer.send_event("canvas_rfid:tag", &[&self.name, &uid, &filament])
+    }
+
+    /// filament[key], as python's str() of it
+    fn field(&self, key: &str) -> PyVal {
+        match self.filament.borrow().as_ref().map(|f| f.get()) {
+            Some(PyVal::Dict(d)) => d.get(key).cloned().unwrap_or(PyVal::None),
+            _ => PyVal::None,
+        }
+    }
+
+    fn describe(&self) -> String {
+        let mut words = vec![self.field("type").str()];
+        words.extend(self.field("modifiers").items().unwrap_or(&[]).iter().map(|m| m.str()));
+        format!(
+            "{} {} #{} {}-{}C ({})",
+            self.field("manufacturer").str(),
+            words.join(" "),
+            self.field("color_hex").str(),
+            self.field("hotend_min_temp_c").as_i64().unwrap_or(0),
+            self.field("hotend_max_temp_c").as_i64().unwrap_or(0),
+            self.field("source_processor").str()
+        )
+    }
+
+    fn respond(&self, msg: &str) {
+        if let Ok(gcode) = self.printer.lookup::<GCodeDispatch>("gcode") {
+            gcode.respond_info(&format!("Canvas RFID {}: {}", self.name, msg), true);
+        }
+    }
+
+    /// dict(self.filament or {})
+    fn filament_dict(&self) -> PyVal {
+        match self.filament.borrow().as_ref() {
+            Some(f) => f.clone(),
+            None => PyVal::dict(),
+        }
+    }
+
+    fn run_tag_gcode(&self, eventtime: f64) {
+        let Some(template) = &self.tag_gcode else { return };
+        let mut context = create_template_context(&self.printer, Some(eventtime));
+        context.insert("uid".into(), Value::from_pyval(&self.uid.borrow().clone().map(PyVal::Str).unwrap_or(PyVal::None)));
+        context.insert("filament".into(), Value::from_pyval(&self.filament_dict()));
+        context.insert("scan_id".into(), Value::Int(self.scan_id.get()));
+        let res = (|| -> KResult<()> {
+            let script = template.render(Some(context))?;
+            self.printer.lookup::<GCodeDispatch>("gcode")?.run_script(&script)
+        })();
+        if let Err(e) = res {
+            logging::exception_err(&format!("canvas_rfid {}: tag_gcode error", self.name), &e);
+        }
+    }
+
+    fn cmd_query_canvas_rfid(&self, gcmd: &GCodeCommand) -> KResult<()> {
+        let uid = self.uid.borrow().clone();
+        let mut lines = vec![match &uid {
+            None => format!("Canvas RFID {}: no tag", self.name),
+            Some(u) => format!("Canvas RFID {}: tag {}", self.name, u),
+        }];
+        match self.filament.borrow().as_ref().map(|f| f.get()) {
+            None | Some(PyVal::None) => {
+                if uid.is_some() {
+                    lines.push("unrecognised tag".into());
+                }
+            }
+            Some(f) => {
+                lines.push(format!("last scan (#{}): {}", self.scan_id.get(), self.describe()));
+                if let PyVal::Dict(d) = f {
+                    for (k, v) in d {
+                        if !["colors", "colors_rgba", "colors_rgba_hex"].contains(&k.as_ref()) {
+                            lines.push(format!("{}: {}", k, v.str()));
+                        }
+                    }
+                }
+            }
+        }
+        gcmd.respond_info(&lines.join("\n"), true);
+        Ok(())
+    }
+
+    fn cmd_canvas_rfid_dump(&self, gcmd: &GCodeCommand) -> KResult<()> {
+        let start = gcmd.get_int("START", Some(0), Lim::new().min(0).max(255))?;
+        let end = gcmd.get_int("END", Some(44), Lim::new().min(start).max(255))?;
+        let Some(pages) = self.read_pages(start, end)? else {
+            return Err(gcmd.error(format!("Canvas RFID {}: read failed", self.name)));
+        };
+        let lines: Vec<String> = pages
+            .chunks(4)
+            .enumerate()
+            .map(|(i, p)| {
+                let hex: Vec<String> = p.iter().map(|b| format!("{:02x}", b)).collect();
+                format!("page {:3}: {}", start + i as i64, hex.join(" "))
+            })
+            .collect();
+        gcmd.respond_info(&lines.join("\n"), true);
+        Ok(())
+    }
+}
+
+impl PrinterObject for CanvasRfid {
+    fn has_status(&self) -> bool {
+        true
+    }
+    fn get_status(&self, eventtime: f64) -> Option<PyVal> {
+        let uid = self.uid.borrow().clone();
+        Some(PyVal::Dict(crate::pydict! {
+            "tag_present" => PyVal::Bool(uid.is_some()),
+            "uid" => uid.map(PyVal::Str).unwrap_or(PyVal::None),
+            "filament" => self.filament_dict(),
+            "scan_id" => PyVal::Int(self.scan_id.get()),
+            "scan_age" => PyVal::Float(if self.scan_id.get() != 0 { eventtime - self.scan_time.get() } else { 0.0 }),
+            "errors" => PyVal::Int(self.errors.get()),
+            "version" => self.version.borrow().clone().map(PyVal::Str).unwrap_or(PyVal::None),
+        }))
+    }
+}
+
+pub fn load_config_prefix(config: &ConfigWrapper) -> KResult<PObj> {
+    Ok(CanvasRfid::new(config)?)
+}

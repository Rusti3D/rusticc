+
+const AUTO_SAVE_TOP_COMMENT: &str = "# This file is autogenerated and updated when variables are not in your normal AFC config files\n\n";
+
+/// A command option for the web interfaces' macro wrapper: (name, type, default)
+pub type MacroOption<'a> = (&'a str, &'a str, &'a str);
+
+/// [AFC_functions]
+pub struct AfcFunction {
+    me: Weak<AfcFunction>,
+    config: ConfigWrapper,
+    printer: Rc<Printer>,
+    afc: RefCell<Weak<Afc>>,
+    logger: RefCell<Option<Rc<AfcLogger>>>,
+    mcu: RefCell<Option<Rc<crate::mcu::Mcu>>>,
+    next_cmd_time: Cell<f64>,
+    auto_var_file: RefCell<String>,
+}
+
+type FnCmd = fn(&Rc<AfcFunction>, &GCodeCommand) -> KResult<()>;
+
+impl AfcFunction {
+    fn new(config: &ConfigWrapper) -> KResult<Rc<AfcFunction>> {
+        let printer = config.get_printer();
+        let f = Rc::new_cyclic(|me| AfcFunction {
+            me: me.clone(),
+            config: config.clone(),
+            printer: printer.clone(),
+            afc: RefCell::new(Weak::new()),
+            logger: RefCell::new(None),
+            mcu: RefCell::new(None),
+            next_cmd_time: Cell::new(0.0),
+            auto_var_file: RefCell::new(String::new()),
+        });
+        let ff = f.clone();
+        crate::events::KlippyConnect::on(&printer, move || ff.handle_connect());
+        let ff = f.clone();
+        printer.register_event_handler(
+            super::lane::REGISTER_MACROS_EVENT,
+            Rc::new(move |args| {
+                let lane: Rc<AfcLane> = crate::events::arg(super::lane::REGISTER_MACROS_EVENT, args, 0)?;
+                ff.register_lane_macros(&lane)
+            }),
+        );
+        let ff = f.clone();
+        printer.register_event_handler(
+            super::hub::REGISTER_MACROS_EVENT,
+            Rc::new(move |args| {
+                let hub: Rc<super::hub::AfcHub> = crate::events::arg(super::hub::REGISTER_MACROS_EVENT, args, 0)?;
+                ff.register_hub_macros(&hub)
+            }),
+        );
+        let ff = f.clone();
+        printer.register_event_handler(super::utils::MOONRAKER_CONNECT_EVENT, Rc::new(move |_| ff.handle_moonraker_connect()));
+
+        let show_macros = true;
+        let reg = |name: &str, cmd: FnCmd, help: &str, options: Option<&[MacroOption]>| -> KResult<()> {
+            let ff = f.clone();
+            f.register_commands(show_macros, name, Rc::new(move |g| cmd(&ff, g)), help, options)
+        };
+        reg("AFC_CALIBRATION", AfcFunction::cmd_afc_calibration, CMD_AFC_CALIBRATION_HELP, None)?;
+        reg("AFC_RESET", AfcFunction::cmd_afc_reset, CMD_AFC_RESET_HELP, Some(&[("DISTANCE", "float", "30")]))?;
+        reg("AFC_TEST_LANES", AfcFunction::cmd_afc_test_lanes, CMD_AFC_TEST_LANES_HELP, None)?;
+        reg("AFC_GET_TD_ONE_DATA", AfcFunction::cmd_afc_get_td_one_data, CMD_AFC_GET_TD_ONE_DATA_HELP, None)?;
+        Ok(f)
+    }
+
+    pub fn set_afc(&self, afc: &Rc<Afc>) {
+        *self.afc.borrow_mut() = Rc::downgrade(afc);
+        *self.logger.borrow_mut() = Some(afc.logger.clone());
+    }
+
+    fn afc(&self) -> Rc<Afc> {
+        self.afc.borrow().upgrade().expect("AFC")
+    }
+
+    fn logger(&self) -> Rc<AfcLogger> {
+        self.logger.borrow().clone().expect("AFC logger")
+    }
+
+    fn rc(&self) -> Rc<AfcFunction> {
+        self.me.upgrade().expect("AFC_functions")
+    }
+
+    fn gcode(&self) -> Rc<GCodeDispatch> {
+        self.afc().gcode.clone()
+    }
+
+    fn register_lane_macros(&self, lane_obj: &AfcLane) -> KResult<()> {
+        let me = self.rc();
+        let m = me.clone();
+        self.gcode().register_mux_command("TEST", "LANE", Some(&lane_obj.name), Rc::new(move |g| m.cmd_test(g)), Some(CMD_TEST_HELP))?;
+        let m = me.clone();
+        self.gcode().register_mux_command("HUB_CUT_TEST", "LANE", Some(&lane_obj.name), Rc::new(move |g| m.cmd_hub_cut_test(g)), Some(CMD_HUB_CUT_TEST_HELP))
+    }
+
+    fn register_hub_macros(&self, hub_obj: &super::hub::AfcHub) -> KResult<()> {
+        let m = self.rc();
+        self.gcode().register_mux_command("SET_BOWDEN_LENGTH", "HUB", Some(&hub_obj.name), Rc::new(move |g| m.cmd_set_bowden_length(g)), Some(CMD_SET_BOWDEN_LENGTH_HELP))
+    }
+
+    fn handle_moonraker_connect(&self) -> KResult<()> {
+        if self.afc().td1_defined.get() {
+            let m = self.rc();
+            self.gcode().register_command("AFC_GET_TD_ONE_LANE_DATA", Some(Rc::new(move |g| m.cmd_afc_get_td_one_lane_data(g))), false, Some(CMD_AFC_GET_TD_ONE_LANE_DATA_HELP))?;
+            let m = self.rc();
+            self.gcode().register_command("AFC_RESET_TD1", Some(Rc::new(move |g| m.cmd_afc_reset_td1(g))), false, Some(CMD_AFC_RESET_TD1_HELP))?;
+        }
+        Ok(())
+    }
+
+    fn handle_connect(&self) -> KResult<()> {
+        let afc = self.printer.lookup::<Afc>("AFC")?;
+        self.set_afc(&afc);
+        *self.mcu.borrow_mut() = Some(self.printer.lookup::<crate::mcu::Mcu>("mcu")?);
+        let parent = crate::pyglob::dirname(&afc.var_file);
+        *self.auto_var_file.borrow_mut() = crate::pyglob::join(if parent.is_empty() { "." } else { &parent }, &["AFC_auto_vars.cfg"]);
+        let reg = |cmd: &str, f: FnCmd, help: &str| -> KResult<()> {
+            let m = self.rc();
+            afc.gcode.register_command(cmd, Some(Rc::new(move |g| f(&m, g))), false, Some(help)).map(|_| ())
+        };
+        reg("CALIBRATE_AFC", AfcFunction::cmd_calibrate_afc, CMD_CALIBRATE_AFC_HELP)?;
+        reg("ALL_CALIBRATION", AfcFunction::cmd_all_calibration, CMD_ALL_CALIBRATION_HELP)?;
+        reg("AFC_CALI_FAIL", AfcFunction::cmd_afc_cali_fail, CMD_AFC_CALI_FAIL_HELP)?;
+        reg("AFC_HAPPY_P", AfcFunction::cmd_afc_happy_p, CMD_AFC_HAPPY_P_HELP)?;
+        reg("TEST_LANE", AfcFunction::cmd_test_lane, CMD_TEST_LANE_HELP)?;
+        reg("TEST_LANE_ITERATIONS", AfcFunction::cmd_test_lane_iterations, CMD_TEST_LANE_ITERATIONS_HELP)?;
+        reg("AFC_LANE_RESET", AfcFunction::cmd_afc_lane_reset, CMD_AFC_LANE_RESET_HELP)
+    }
+
+    /// Renames a stock command to rename_name and puts AFC's in its place
+    pub fn rename(&self, base_name: &str, rename_name: &str, rename_macro: Handler, rename_help: &str) -> KResult<()> {
+        let c = &AFC_FUNCTIONS_AFCFUNCTION__RENAME;
+        let gcode = self.gcode();
+        let prev_cmd = gcode.register_command(base_name, None, false, None)?;
+        match prev_cmd {
+            Some(prev) => {
+                let pdesc = format!("Renamed builtin of '{}'", base_name);
+                gcode.register_command(rename_name, Some(prev), false, Some(&pdesc))?;
+            }
+            None => self.logger().debug(c, &format!("<span class=warning--text>Existing command {} not found in gcode_macros</span>", base_name)),
+        }
+        self.logger().debug(c, &format!("PREP-renaming macro {}", base_name));
+        gcode.register_command(base_name, Some(rename_macro), false, Some(rename_help))?;
+        Ok(())
+    }
+
+    /// Adds value_name to section_name in AFC_auto_vars.cfg
+    pub fn write_auto_variables(&self, section_name: &str, value_name: &str, value: &str) -> KResult<()> {
+        let path = self.auto_var_file.borrow().clone();
+        let io = |e: std::io::Error| KError::Py(crate::pyfmt::py_oserror_class(&e).into(), crate::pyfmt::py_oserror(&e, &path));
+        if !std::path::Path::new(&path).exists() {
+            std::fs::OpenOptions::new().append(true).create(true).open(&path).map_err(io)?;
+        }
+        let text = std::fs::read_to_string(&path).map_err(io)?;
+        let mut config = crate::configparser::RawConfigParser::new(true, &[], Box::new(crate::configparser::NoInterpolation));
+        config.read_string(&text, &path)?;
+        if !config.has_section(section_name) {
+            config.add_section(section_name)?;
+        }
+        config.set(section_name, value_name, value)?;
+        let mut out = String::from(AUTO_SAVE_TOP_COMMENT);
+        out += &config.write();
+        std::fs::write(&path, out).map_err(io)
+    }
+
+    /// ConfigRewrite: the value written into the section's line of the
+    /// user's AFC config (or AFC_auto_vars.cfg when not found)
+    pub fn config_rewrite(&self, rawsection: &str, rawkey: &str, rawvalue: &PyVal, msg: &str) -> KResult<()> {
+        let afc = self.afc();
+        let c = &AFC_FUNCTIONS_AFCFUNCTION_CONFIGREWRITE;
+        let mut msg = msg.to_string();
+        let value = rawvalue.str();
+        if afc.config_save_method == "kalico" {
+            let configfile = self.printer.lookup::<crate::printer::ConfigFileObject>("configfile")?;
+            configfile.pconfig.borrow_mut().set(rawsection, rawkey, &value)?;
+            afc.gcode.run_script_from_command("SAVE_CONFIG RESTART=0")?;
+            msg += &format!("\n<span class=info--text>Saved {}:{} in {} section to printer.cfg SAVE_CONFIG block</span>", rawkey, value, rawsection);
+            self.logger().info(c, &msg);
+            return Ok(());
+        }
+        let pattern = regex_lite_section(rawsection);
+        let entries: Vec<String> = std::fs::read_dir(&afc.cfgloc)
+            .map_err(|e| KError::Py(crate::pyfmt::py_oserror_class(&e).into(), crate::pyfmt::py_oserror(&e, &afc.cfgloc)))?
+            .filter_map(|e| e.ok().map(|e| e.file_name().to_string_lossy().into_owned()))
+            .collect();
+        // (os.listdir order: the directory's own order, which python does not sort)
+        for filename in entries {
+            let file_path = crate::pyglob::join(&afc.cfgloc, &[&filename]);
+            if !(std::path::Path::new(&file_path).is_file() && filename.ends_with(".cfg")) {
+                continue;
+            }
+            let text = std::fs::read_to_string(&file_path).unwrap_or_default();
+            let mut dataout = String::new();
+            let mut sectionfound = false;
+            let mut taskdone = false;
+            for line in text.split_inclusive('\n') {
+                let mut line = line.to_string();
+                if sectionfound && line.starts_with('[') {
+                    sectionfound = false;
+                }
+                if pattern(&line) {
+                    sectionfound = true;
+                }
+                if sectionfound && line.starts_with(rawkey) {
+                    let (comment_index, comments) = match line.find('#') {
+                        Some(i) => (i as i64, line[i..line.len().saturating_sub(1)].to_string()),
+                        None => (0, String::new()),
+                    };
+                    let mut l = format!("{}: {}", rawkey, value);
+                    let width = (comment_index - 1).max(0) as usize;
+                    while l.chars().count() < width {
+                        l.push(' ');
+                    }
+                    line = format!("{} {}\n", l, comments);
+                    sectionfound = false;
+                    taskdone = true;
+                }
+                dataout += &line;
+            }
+            if taskdone {
+                std::fs::write(&file_path, dataout).map_err(|e| KError::Py(crate::pyfmt::py_oserror_class(&e).into(), crate::pyfmt::py_oserror(&e, &file_path)))?;
+                msg += &format!("\n<span class=info--text>Saved {}:{} in {} section to configuration file</span>", rawkey, value, rawsection);
+                self.logger().info(c, &msg);
+                return Ok(());
+            }
+        }
+        self.write_auto_variables(rawsection, rawkey, &value)?;
+        msg += &format!("\n<span class=info--text>Key {} not found in section {} added to AFC_auto_vars.cfg file</span>", rawkey, rawsection);
+        self.logger().info(c, &msg);
+        Ok(())
+    }
+
+    /// Registers a T(n) macro (renaming an existing one when rename_map is set)
+    pub fn register_tool_macro(&self, lane_name: &str, tool_command: &str, rename_map: &str) -> KResult<()> {
+        let afc = self.afc();
+        let res = if !rename_map.is_empty() {
+            let a = afc.clone();
+            self.rename(tool_command, rename_map, Rc::new(move |g| a.cmd_change_tool(g)), super::CMD_CHANGE_TOOL_HELP)
+        } else {
+            let a = afc.clone();
+            afc.gcode.register_command(tool_command, Some(Rc::new(move |g| a.cmd_change_tool(g))), false, Some(super::CMD_CHANGE_TOOL_HELP)).map(|_| ())
+        };
+        if res.is_err() {
+            self.logger().error(
+                &AFC_FUNCTIONS_AFCFUNCTION_REGISTER_TOOL_MACRO,
+                &format!("Error trying to map lane {} to {}, please make sure there are no macros already setup for {}", lane_name, tool_command, tool_command),
+            );
+        }
+        Ok(())
+    }
+
+    /// Assigns T(n) macros to a lane (its map, or the next free T(n))
+    pub fn tcmd_assign(&self, cur_lane: &AfcLane) -> KResult<()> {
+        let afc = self.afc();
+        if cur_lane.map.borrow().is_empty() {
+            for x in 0..99 {
+                let cmd = format!("T{}", x);
+                let manually_assigned = afc.lanes.borrow().values().any(|l| l.config_map.contains(&cmd));
+                if !manually_assigned && !afc.tool_cmds.borrow().contains_key(&cmd) {
+                    let existing = !afc.force_assign_map && afc.gcode.handler_in("ready", &cmd).is_some();
+                    if !existing {
+                        let mut m = cur_lane.map.borrow().clone();
+                        m.push(cmd);
+                        *cur_lane.map.borrow_mut() = m;
+                        break;
+                    }
+                }
+            }
+        }
+        let maps = cur_lane.map.borrow().clone();
+        let use_rename = afc.force_assign_map || afc.lanes.borrow().values().any(|l| maps.iter().any(|m| l.config_map.contains(m)));
+        for map_str in maps {
+            if map_str == "NONE" {
+                continue;
+            }
+            afc.tool_cmds.borrow_mut().insert(map_str.clone(), cur_lane.name.clone());
+            if cur_lane.current_map.borrow().is_empty() {
+                *cur_lane.current_map.borrow_mut() = map_str.clone();
+            }
+            let rename_map = if use_rename { format!("_{}", map_str) } else { String::new() };
+            self.register_tool_macro(&cur_lane.name, &map_str, &rename_map)?;
+        }
+        afc.save_vars()
+    }
+
+    pub fn check_macro_present(&self, macro_name: Option<&str>) -> bool {
+        macro_name.is_some_and(|m| self.afc().gcode.handler_in("ready", m).is_some())

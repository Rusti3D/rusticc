+    pub fn lane_extruder_index(&self) -> i64 {
+        let Some(e) = self.extruder_obj_opt() else { return 0 };
+        let th = &e.th_extruder_name;
+        if th == "extruder" {
+            return 0;
+        }
+        th.replace("extruder", "").parse().unwrap_or(0)
+    }

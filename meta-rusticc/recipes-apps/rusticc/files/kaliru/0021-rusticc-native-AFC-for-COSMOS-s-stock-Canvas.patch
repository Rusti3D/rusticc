+    fn cmd_afc_get_td_one_data(self: &Rc<Self>, _gcmd: &GCodeCommand) -> KResult<()> {
+        let afc = self.afc();
+        let logger = self.logger();
+        let prompt = AfcPrompt::new(&logger);
+        let mut buttons: Vec<Vec<Button>> = vec![];
+        let mut group_buttons: Vec<Button> = vec![];
+        let mut index = 0;
+        let mut text = "Select a loaded lane to capture TD-1 data, or select ALL. ";
+        let nlanes = afc.lanes.borrow().len();
+        for lane in afc.lanes.borrow().values() {
+            if lane.td1_device_id.borrow().as_deref().is_some_and(|s| !s.is_empty()) && lane.load_state() {
+                group_buttons.push(button(lane.name.clone(), format!("AFC_GET_TD_ONE_LANE_DATA LANE={}", lane.name), if index % 2 == 0 { "primary" } else { "secondary" }));
+                if (index + 1) % 2 == 0 || index == nlanes - 1 {
+                    buttons.push(std::mem::take(&mut group_buttons));
+                }
+                index += 1;
+            }
+        }
+        if !group_buttons.is_empty() {
+            buttons.push(group_buttons);
+        }
+        let total_buttons: usize = buttons.iter().map(|g| g.len()).sum();
+        let all_lanes = if total_buttons > 1 { Some(vec![button("All lanes", "AFC_GET_TD_ONE_LANE_DATA LANE=all", "default")]) } else { None };
+        if total_buttons == 0 {
+            text = "No lanes are loaded, please load before calibration";
+        }
+        prompt.create_custom_p("Capture TD-1 Data", Some(text), all_lanes.as_deref(), true, Some(&buttons), None);
+        Ok(())
+    }

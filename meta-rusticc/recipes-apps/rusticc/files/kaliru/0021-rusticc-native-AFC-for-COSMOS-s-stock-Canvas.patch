+pub const CMD_AFC_CALIBRATION_HELP: &str = "Open prompt to begin calibration by selecting Unit to calibrate";
+pub const CMD_AFC_RESET_HELP: &str = "Opens prompt to select lane to reset.";
+pub const CMD_AFC_TEST_LANES_HELP: &str = "Run load/unload tests on specified lanes";

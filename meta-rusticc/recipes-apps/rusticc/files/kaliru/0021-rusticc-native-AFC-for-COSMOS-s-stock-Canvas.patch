+pub const CMD_ALL_CALIBRATION_HELP: &str = "open prompt to begin calibration to confirm calibrating all lanes";
+pub const CMD_AFC_CALI_FAIL_HELP: &str = "Opens prompt after calibration fails";
+pub const CMD_AFC_HAPPY_P_HELP: &str = "Opens prompt after calibration is complete";
+pub const CMD_TEST_LANE_HELP: &str = "Run load/unload tests on specified lane(s)";

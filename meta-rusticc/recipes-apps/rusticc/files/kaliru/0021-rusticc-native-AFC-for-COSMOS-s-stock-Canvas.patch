+    /// Homed (or homed now with auto_home); an error otherwise
+    pub fn check_homed(&self, error_msg: Option<&str>, caller: &Code) -> KResult<bool> {
+        let afc = self.afc();
+        let c = &AFC_FUNCTIONS_AFCFUNCTION_CHECK_HOMED;
+        if self.is_homed(false)? {
+            return Ok(true);
+        }
+        if afc.auto_home {
+            afc.gcode.run_script_from_command("G28")?;
+            afc.toolhead()?.wait_moves()?;
+            if let Some(m) = afc.auto_level_macro.clone() {
+                if self.check_macro_present(Some(&m)) {
+                    afc.gcode.run_script_from_command(&m)?;
+                    afc.toolhead()?.wait_moves()?;
+                } else {
+                    afc.error.afc_error(c, "Auto level macro defined, but not found in printer configuration.", false, Some(caller.func))?;
+                    return Ok(false);
+                }
+            }
+            Ok(true)
+        } else {
+            let msg = error_msg.unwrap_or("Please home printer before doing a tool load");
+            afc.error.afc_error(c, msg, false, Some(caller.func))?;
+            Ok(false)
+        }
+    }

+    fn cmd_afc_get_td_one_lane_data(self: &Rc<Self>, gcmd: &GCodeCommand) -> KResult<()> {
+        let afc = self.afc();
+        let logger = self.logger();
+        let c = &AFC_FUNCTIONS_AFCFUNCTION_CMD_AFC_GET_TD_ONE_LANE_DATA;
+        let prompt = AfcPrompt::new(&logger);
+        let lane = gcmd.get("LANE")?;
+        prompt.p_end();
+        let lanes_captured;
+        if lane.to_lowercase() == "all" {
+            logger.info(c, "Capturing TD-1 data for all lanes");
+            let lanes: Vec<Rc<AfcLane>> = afc.lanes.borrow().values().cloned().collect();
+            for cur_lane in lanes {
+                if cur_lane.td1_device_id.borrow().as_deref().is_some_and(|s| !s.is_empty()) && cur_lane.load_state() && cur_lane.prep_state.get() {
+                    let (success, msg) = cur_lane.get_td1_data()?;
+                    if !success {
+                        afc.gcode.run_script_from_command(&format!("AFC_CALI_FAIL TITLE='Get TD-1 data Failed' FAIL={} DISTANCE=0 msg='{}' RESET=0", cur_lane.name, msg))?;
+                        return Ok(());
+                    }
+                }
+            }
+            lanes_captured = "'TD-1 Data captured for all lanes'".to_string();
+        } else if let Some(cur_lane) = afc.lane(&lane) {
+            logger.info(c, &format!("Capturing TD-1 data for {}", lane));
+            let (success, msg) = cur_lane.get_td1_data()?;
+            if !success {
+                let msg = msg.replace('\n', " ");
+                afc.gcode.run_script_from_command(&format!("AFC_CALI_FAIL TITLE='Get TD-1 data Failed' FAIL={} DISTANCE=0 msg='{}' RESET=0", cur_lane.name, msg))?;
+                return Ok(());
+            }
+            lanes_captured = format!("'TD-1 Data captured for {}'", cur_lane.name);
+        } else {
+            let fail_message = format!("'{} not valid lane, cannot capture TD-1 data'", lane);
+            afc.error.afc_error(c, &fail_message, false, None)?;
+            afc.gcode.run_script_from_command(&format!("AFC_CALI_FAIL TITLE='Get TD-1 data Completed' FAIL={} msg='{}' RESET=0", lane, fail_message))?;
+            return Ok(());
+        }
+        afc.gcode.run_script_from_command(&format!("AFC_HAPPY_P STEP={}", lanes_captured))
+    }

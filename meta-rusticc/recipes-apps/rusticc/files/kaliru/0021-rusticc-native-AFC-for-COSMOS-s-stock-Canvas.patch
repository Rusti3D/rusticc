+    /// (error_string, led): AFC_led is not native, so never found
+    pub fn verify_led_object(&self, led_name: &str) -> (String, Option<PObj>) {
+        let afc_object = format!("AFC_led {}", led_name.split(':').next().unwrap_or(""));
+        match self.printer.lookup_object_opt(&afc_object) {
+            Some(o) => (String::new(), Some(o)),
+            None => (format!("Error: Cannot find [{}] in config, make sure led_index in config is correct", afc_object), None),
+        }
+    }
+
+    /// "1-4,9,10" -> [1,2,3,4,9,10]
+    pub fn get_led_indexes(&self, index_values: &str) -> KResult<Vec<i64>> {
+        let mut led_indexes = vec![];
+        for idx in index_values.split(',') {
+            if !idx.contains('-') {
+                led_indexes.push(super::utils::py_int_of(&PyVal::Str(idx.to_string()))?);
+            } else {
+                let parts: Vec<&str> = idx.split('-').collect();
+                if parts.len() != 2 {
+                    return Err(KError::Py("ValueError".into(), format!("too many values to unpack (expected 2, got {})", parts.len())));
+                }
+                let low = super::utils::py_int_of(&PyVal::Str(parts[0].to_string()))?;
+                let high = super::utils::py_int_of(&PyVal::Str(parts[1].to_string()))?;
+                led_indexes.extend(low..high + 1);
+            }
+        }
+        Ok(led_indexes)
+    }
+
+    /// led_index string -> [(led_name, index_string)]
+    pub fn parse_led_groups(&self, idx: &str) -> Vec<(String, String)> {
+        let mut groups: Vec<(String, String)> = vec![];
+        for part in idx.split(',') {
+            if let Some((led_name, index_str)) = part.split_once(':') {
+                groups.push((crate::pyfmt::py_strip(led_name).to_string(), crate::pyfmt::py_strip(index_str).to_string()));
+            } else if let Some(last) = groups.last_mut() {
+                last.1 = format!("{},{}", last.1, crate::pyfmt::py_strip(part));
+            } else {
+                self.logger().info(
+                    &AFC_FUNCTIONS_AFCFUNCTION_PARSE_LED_GROUPS,
+                    &format!("Warning: led_index segment '{}' has no LED name and no prior group to attach to, skipping", crate::pyfmt::py_strip(part)),
+                );
+            }
+        }
+        groups
+    }
+
+    /// Sets AFC_led indexes (no AFC_led is native: logs the lookup error)
+    pub fn afc_led(&self, _status: &PyVal, idx: Option<&str>) -> KResult<()> {
+        let Some(idx) = idx else { return Ok(()) };
+        for (led_name, _index_str) in self.parse_led_groups(idx) {
+            let (error_string, led) = self.verify_led_object(&led_name);
+            if led.is_none() {
+                self.logger().error(&AFC_FUNCTIONS_AFCFUNCTION_AFC_LED, &error_string);
+            }
+        }
+        Ok(())
+    }

@@ -0,0 +1,329 @@
+// AFC's PREP: restores the saved lane state and checks every lane at
+// startup (port of AFC_prep.py)
+//
+// Copyright (C) 2024-2026 Armored Turtle
+//
+// This file may be distributed under the terms of the GNU GPLv3 license.
+use super::codes::*;
+use super::{error, py_repr, Afc};
+use crate::configfile::{ConfigWrapper, Lim};
+use crate::error::{KError, KResult};
+use crate::gcode::GCodeCommand;
+use crate::printer::{PObj, Printer, PrinterObject};
+use crate::pyval::PyVal;
+use std::cell::{Cell, RefCell};
+use std::rc::{Rc, Weak};
+
+/// [AFC_prep]
+pub struct AfcPrep {
+    me: Weak<AfcPrep>,
+    printer: Rc<Printer>,
+    afc: RefCell<Weak<Afc>>,
+    delay: f64,
+    enable: bool,
+    dis_pause_resume_macro: bool,
+    dis_unload_macro: bool,
+    get_td1_data: bool,
+    rename_occurred: Cell<bool>,
+    assign_tcmd: Cell<bool>,
+}
+
+impl AfcPrep {
+    fn new(config: &ConfigWrapper) -> KResult<Rc<AfcPrep>> {
+        let printer = config.get_printer();
+        let delay = config.getfloat("delay_time", 0.1, Lim::new().min(0.0))?;
+        let enable = config.getboolean("enable", false)?;
+        let dis_pause_resume_macro = config.getboolean("disable_pause_resume_remapping", false)?;
+        let dis_unload_macro = config.getboolean("disable_unload_filament_remapping", false)?;
+        let get_td1_data = config.getboolean("capture_td1_data", false)?;
+        let p = Rc::new_cyclic(|me| AfcPrep {
+            me: me.clone(),
+            printer: printer.clone(),
+            afc: RefCell::new(Weak::new()),
+            delay,
+            enable,
+            dis_pause_resume_macro,
+            dis_unload_macro,
+            get_td1_data,
+            rename_occurred: Cell::new(false),
+            assign_tcmd: Cell::new(true),
+        });
+        let pp = p.clone();
+        crate::events::KlippyConnect::on(&printer, move || pp.handle_connect());
+        Ok(p)
+    }
+
+    fn afc(&self) -> Rc<Afc> {
+        self.afc.borrow().upgrade().expect("AFC")
+    }
+
+    fn handle_connect(&self) -> KResult<()> {
+        let afc = self.printer.lookup::<Afc>("AFC")?;
+        *self.afc.borrow_mut() = Rc::downgrade(&afc);
+        let me = self.me.upgrade().expect("AFC_prep");
+        afc.gcode.register_command("PREP", Some(Rc::new(move |g| me.prep(g))), false, None)?;
+        Ok(())
+    }
+
+    /// RESUME / PAUSE -> AFC_RESUME / AFC_PAUSE, UNLOAD_FILAMENT -> TOOL_UNLOAD
+    fn rename_macros(&self) -> KResult<()> {
+        if self.rename_occurred.replace(true) {
+            return Ok(());
+        }
+        let afc = self.afc();
+        if !self.dis_pause_resume_macro {
+            let e = afc.error.clone();
+            afc.function.rename(error::BASE_RESUME_NAME, error::AFC_RENAME_RESUME_NAME, Rc::new(move |g| e.cmd_afc_resume(g)), error::CMD_AFC_RESUME_HELP)?;
+            let e = afc.error.clone();
+            // (python passes the RESUME help for PAUSE too)
+            afc.function.rename(error::BASE_PAUSE_NAME, error::AFC_RENAME_PAUSE_NAME, Rc::new(move |g| e.cmd_afc_pause(g)), error::CMD_AFC_RESUME_HELP)?;
+        }
+        if !self.dis_unload_macro {
+            let a = afc.clone();
+            afc.function.rename(super::BASE_UNLOAD_FILAMENT, super::RENAMED_UNLOAD_FILAMENT, Rc::new(move |g| a.cmd_tool_unload(g)), super::CMD_TOOL_UNLOAD_HELP)?;
+        }
+        Ok(())
+    }
+
+    fn td1_prep(&self, overall_status: bool) -> KResult<()> {
+        let afc = self.afc();
+        let c = &AFC_PREP_AFCPREP__TD1_PREP;
+        let td1_present = afc.td1_present()?;
+        let capture_td1_data = self.get_td1_data && td1_present;
+        let mut any_td1_error = false;
+        if td1_present {
+            afc.logger.info(c, "Found TD-1 device connected to printer");
+            any_td1_error = afc.function.check_for_td1_error(None, true)?.0;
+        }
+        if let Some(cur) = afc.function.get_current_lane_obj() {
+            cur.unit_obj()?.select_lane(&cur, false)?;
+            if capture_td1_data {
+                afc.logger.info(c, "Cannot capture TD-1 data during PREP since toolhead is loaded");
+            }
+        } else if capture_td1_data {
+            if !overall_status {
+                afc.logger.info(c, "Cannot capture TD-1 data, not all of PREP succeeded");
+            } else if any_td1_error {
+                afc.logger.error(c, "Error with a TD-1 device, not collecting data during prep");
+            } else {
+                afc.logger.info(c, "Capturing TD-1 data for all loaded lanes");
+                let lanes: Vec<_> = afc.lanes.borrow().values().cloned().collect();
+                for lane in lanes {
+                    if lane.td1_device_id.borrow().is_some() && lane.load_state() && lane.prep_state.get() && !lane.get_td1_data()?.0 {
+                        break;
+                    }
+                }
+                afc.logger.info(c, "Done capturing TD-1 data");
+            }
+        }
+        Ok(())
+    }
+
+    /// PREP
+    fn prep(&self, _gcmd: &GCodeCommand) -> KResult<()> {
+        let afc = self.afc();
+        let c = &AFC_PREP_AFCPREP_PREP;
+        let mut overall_status = true;
+        while self.printer.state_message() != "Printer is ready" {
+            afc.reactor.pause(afc.reactor.monotonic() + 1.0)?;
+        }
+        self.rename_macros()?;
+        afc.handle_moonraker_connect()?;
+
+        // load Unit stored variables
+        let path = format!("{}.unit", afc.var_file);
+        let mut units = PyVal::dict();
+        let size = std::fs::metadata(&path).map(|m| m.len()).ok();
+        if size.is_some_and(|s| s > 0) {
+            let text = std::fs::read_to_string(&path).map_err(|e| KError::Py(crate::pyfmt::py_oserror_class(&e).into(), crate::pyfmt::py_oserror(&e, &path)))?;
+            match PyVal::json_loads(&text) {
+                Ok(v) => units = v,
+                Err(e) => {
+                    afc.error.afc_error(
+                        c,
+                        &format!("Error when trying to open and decode {}.unit file.\nPlease fix file or delete if file is empty, then restart klipper.", afc.var_file),
+                        false,
+                        None,
+                    )?;
+                    afc.logger.error_opt(c, "", Some(&e), "");
+                    return Ok(());
+                }
+            }
+        } else {
+            let mut error_string = format!("Error: {}.unit file not found. Please check the path in the ", afc.var_file);
+            error_string += "AFC.cfg file and make sure the file and path exists.";
+            afc.error.afc_error(c, &error_string, false, None)?;
+        }
+        let key = |d: &PyVal, k: &str| -> Option<PyVal> {
+            match d.get() {
+                PyVal::Dict(m) => m.get(k).cloned(),
+                _ => None,
+            }
+        };
+        let system = key(&units, "system");
+        let extruders_saved = system.as_ref().and_then(|s| key(s, "extruders"));
+
+        let tools: Vec<_> = afc.tools.borrow().values().cloned().collect();
+        for extruder_obj in &tools {
+            extruder_obj.set_status_led(&afc.led_tool_unloaded)?;
+            if extruder_obj.on_shuttle() && afc.function.get_current_extruder()?.as_deref() != Some(extruder_obj.th_extruder_name.as_str()) {
+                afc.gcode.run_script_from_command(&format!("ACTIVATE_EXTRUDER EXTRUDER={}", extruder_obj.th_extruder_name))?;
+            }
+            if let Some(saved) = extruders_saved.as_ref().and_then(|e| key(e, &extruder_obj.name)) {
+                if let Some(ll) = key(&saved, "lane_loaded").filter(|v| v.truthy()) {
+                    *extruder_obj.lane_loaded.borrow_mut() = Some(ll.str());
+                }
+            }
+        }
+        afc.print_version(true);
+
+        let lanes: Vec<_> = afc.lanes.borrow().values().cloned().collect();
+        for cur_lane in &lanes {
+            let unit = afc.units.borrow().get(&cur_lane.unit).cloned().ok_or_else(|| KError::Py("KeyError".into(), py_repr(&cur_lane.unit)))?;
+            if !unit.lanes.borrow().contains_key(&cur_lane.name) {
+                return Err(super::no_attr("dict", "append"));
+            }
+            let Some(saved) = key(&units, &cur_lane.unit).and_then(|u| key(&u, &cur_lane.name)) else { continue };
+            let get = |k: &str| key(&saved, k);
+            if let Some(v) = get("spool_id") {
+                *cur_lane.spool_id.borrow_mut() = v;
+            }
+            if afc.spoolman.borrow().is_some() && cur_lane.spool_id.borrow().truthy() {
+                let id = cur_lane.spool_id.borrow().clone();
+                afc.spool.set_spool_id(cur_lane, id, false, None)?;
+            } else {
+                if let Some(v) = get("material") {
+                    cur_lane.set_material(v)?;
+                }
+                if let Some(v) = get("color") {
+                    *cur_lane.color.borrow_mut() = v;
+                }
+                if let Some(v) = get("weight") {
+                    *cur_lane.weight.borrow_mut() = v;
+                }
+                if let Some(v) = get("density") {
+                    *cur_lane.filament_density.borrow_mut() = v;
+                }
+                if let Some(v) = get("diameter") {
+                    *cur_lane.filament_diameter.borrow_mut() = v;
+                }
+                if let Some(v) = get("empty_spool_weight") {
+                    *cur_lane.empty_spool_weight.borrow_mut() = v;
+                }
+                if let Some(v) = get("bed_temp") {
+                    *cur_lane.bed_temp.borrow_mut() = v;
+                }
+                if let Some(v) = get("extruder_temp") {
+                    *cur_lane.extruder_temp.borrow_mut() = v;
+                }
+                cur_lane.need_purge.set(get("need_purge").map(|v| v.truthy()).unwrap_or(false));
+                for slot in [&cur_lane.bed_temp, &cur_lane.extruder_temp, &cur_lane.weight] {
+                    let value = slot.borrow().clone();
+                    let new = match &value {
+                        PyVal::Str(s) if s.is_empty() || s == "NONE" => PyVal::None,
+                        PyVal::Float(_) => value.clone(),
+                        v if v.truthy() => match super::utils::py_float_of(v) {
+                            Ok(f) => PyVal::Float(f),
+                            Err(_) => PyVal::Int(0),
+                        },
+                        _ => PyVal::Int(0),
+                    };
+                    *slot.borrow_mut() = new;
+                }
+            }
+            if let Some(v) = get("runout_lane") {
+                *cur_lane.runout_lane.borrow_mut() = if matches!(v, PyVal::None) { None } else { Some(v.str()) };
+            }
+            if cur_lane.runout_lane.borrow().as_deref().is_some_and(|r| r.is_empty() || r == "NONE") {
+                *cur_lane.runout_lane.borrow_mut() = None;
+            }
+            if let Some(temp_map) = get("map").filter(|v| v.truthy()) {
+                let m: Vec<String> = match &temp_map {
+                    PyVal::Str(s) => s.replace(' ', "").split(',').map(|s| s.to_string()).collect(),
+                    v => v.items().unwrap_or_default().iter().map(|x| x.str()).collect(),
+                };
+                *cur_lane.map.borrow_mut() = m;
+            }
+            *cur_lane.current_map.borrow_mut() = get("current_map").map(|v| v.str()).unwrap_or_default();
+            for map_str in cur_lane.map.borrow().iter() {
+                if map_str != "NONE" {
+                    afc.tool_cmds.borrow_mut().insert(map_str.clone(), cur_lane.name.clone());
+                }
+            }
+            if get("hub_loaded").is_some() {
+                return Err(super::no_attr("str", "loaded_to_hub"));
+            }
+            if let Some(v) = get("loaded_to_hub") {
+                cur_lane.loaded_to_hub.set(v.truthy());
+            }
+            if let Some(v) = get("tool_loaded") {
+                cur_lane.tool_loaded.set(v.truthy());
+            }
+            if let Some(v) = get("td1_data") {
+                *cur_lane.td1_data.borrow_mut() = v;
+            }
+        }
+
+        let units_list: Vec<(String, _)> = afc.units.borrow().iter().map(|(k, v)| (k.clone(), v.clone())).collect();
+        for (name, cur_unit) in units_list {
+            afc.logger.info(c, &format!("{} {} Prepping lanes", cur_unit.type_name(), name));
+            let mut lane_check = true;
+            let ulanes: Vec<_> = cur_unit.lanes.borrow().values().cloned().collect();
+            for lane in ulanes {
+                if !cur_unit.system_test(&lane, self.delay, self.assign_tcmd.get(), self.enable)? {
+                    lane_check = false;
+                }
+            }
+            if lane_check {
+                afc.logger.raw(c, &cur_unit.logo.borrow());
+            } else {
+                afc.logger.raw(c, &cur_unit.logo_error.borrow());
+            }
+            overall_status = overall_status && lane_check;
+        }
+        if afc.get_bypass_state() {
+            afc.logger.info(c, "Filament loaded in bypass, toolchanges deactivated");
+        }
+        self.td1_prep(overall_status)?;
+        if let Some(cur) = afc.function.get_current_lane_obj() {
+            cur.unit_obj()?.select_lane(&cur, true)?;
+            cur.sync_to_extruder(true)?;
+        }
+        // Restore the virtual bypass state
+        let bypass = afc.bypass.borrow().clone().ok_or_else(|| super::no_attr("NoneType", "name"))?;
+        let mut bypass_name = "Bypass";
+        if bypass.name.contains("virtual") {
+            bypass_name = "Virtual bypass";
+            let enabled = system.as_ref().and_then(|s| key(s, "bypass")).map(|b| key(&b, "enabled").map(|v| v.truthy()).ok_or_else(|| KError::Py("KeyError".into(), "'enabled'".into())));
+            let state = match enabled {
+                Some(r) => r?,
+                None => false,
+            };
+            bypass.filament_present.set(state);
+            bypass.sensor_enabled.set(state);
+        }
+        if bypass.filament_present.get() {
+            afc.logger.raw(c, &format!("<span class=warning--text>{} enabled</span>", bypass_name));
+        }
+        for extruder in &tools {
+            extruder.estats.check_cut_threshold(&afc)?;
+        }
+        if afc.current().is_none() {
+            afc.spool.set_active_spool(&PyVal::None)?;
+        }
+        self.assign_tcmd.set(false);
+        afc.prep_done.set(true);
+        afc.save_vars()?;
+        let error_str = afc.verify_macro_positions();
+        if !error_str.is_empty() {
+            afc.logger.error(c, &error_str);
+        }
+        Ok(())
+    }
+}
+
+impl PrinterObject for AfcPrep {}
+
+pub fn load_config(config: &ConfigWrapper) -> KResult<PObj> {
+    Ok(AfcPrep::new(config)?)
+}
diff --git a/src/extras/afc/respond.rs b/src/extras/afc/respond.rs
new file mode 100644
index 0000000..0c08daa
--- /dev/null
+++ b/src/extras/afc/respond.rs
@@ -0,0 +1,104 @@
+// AFC prompts for the web clients' action:prompt dialogs (port of
+// AFC_respond.py)
+//
+// Copyright (C) 2024-2026 Armored Turtle
+//
+// This file may be distributed under the terms of the GNU GPLv3 license.
+use super::codes::*;
+use super::logger::AfcLogger;
+
+/// A button: (label, command, style)
+pub type Button = (String, String, Option<String>);
+
+pub struct AfcPrompt<'a> {
+    logger: &'a AfcLogger,
+}
+
+impl<'a> AfcPrompt<'a> {
+    pub fn new(logger: &'a AfcLogger) -> Self {
+        AfcPrompt { logger }
+    }
+
+    pub fn p_begin(&self, prompt_name: &str) {
+        self.logger.raw(&AFC_RESPOND_AFCPROMPT_P_BEGIN, &format!("// action:prompt_begin {}", prompt_name));
+    }
+
+    pub fn p_text(&self, text: &str) {
+        for line in text.split('\n') {
+            self.logger.raw(&AFC_RESPOND_AFCPROMPT_P_TEXT, &format!("// action:prompt_text {}", line));
+        }
+    }
+
+    pub fn p_button(&self, label: &str, command: &str, style: Option<&str>) {
+        let msg = match style.filter(|s| !s.is_empty()) {
+            Some(style) => format!("// action:prompt_button {}|{}|{}", label, command, style),
+            None => format!("// action:prompt_button {}|{}", label, command),
+        };
+        self.logger.raw(&AFC_RESPOND_AFCPROMPT_P_BUTTON, &msg);
+    }
+
+    pub fn p_footer_button(&self, label: &str, command: &str, style: Option<&str>) {
+        let msg = match style.filter(|s| !s.is_empty()) {
+            Some(style) => format!("// action:prompt_footer_button {}|{}|{}", label, command, style),
+            None => format!("// action:prompt_footer_button {}|{}", label, command),
+        };
+        self.logger.raw(&AFC_RESPOND_AFCPROMPT_P_FOOTER_BUTTON, &msg);
+    }
+
+    pub fn p_cancel_button(&self) {
+        self.p_footer_button("Cancel", "RESPOND TYPE=command MSG=action:prompt_end", Some("warning"));
+    }
+
+    pub fn p_show(&self) {
+        self.logger.raw(&AFC_RESPOND_AFCPROMPT_P_SHOW, "// action:prompt_show");
+    }
+
+    pub fn p_end(&self) {
+        self.logger.raw(&AFC_RESPOND_AFCPROMPT_P_END, "// action:prompt_end");
+    }
+
+    pub fn p_button_group_start(&self) {
+        self.logger.raw(&AFC_RESPOND_AFCPROMPT_P_BUTTON_GROUP_START, "// action:prompt_button_group_start");
+    }
+
+    pub fn p_button_group_end(&self) {
+        self.logger.raw(&AFC_RESPOND_AFCPROMPT_P_BUTTON_GROUP_END, "// action:prompt_button_group_end");
+    }
+
+    pub fn create_custom_p(
+        &self,
+        prompt_name: &str,
+        text: Option<&str>,
+        buttons: Option<&[Button]>,
+        cancel: bool,
+        groups: Option<&[Vec<Button>]>,
+        footer_buttons: Option<&[Button]>,
+    ) {
+        self.p_begin(prompt_name);
+        if let Some(text) = text {
+            self.p_text(text);
+        }
+        for group in groups.unwrap_or_default() {
+            self.p_button_group_start();
+            for (label, command, style) in group {
+                self.p_button(label, command, style.as_deref());
+            }
+            self.p_button_group_end();
+        }
+        for (label, command, style) in buttons.unwrap_or_default() {
+            self.p_button(label, command, style.as_deref());
+        }
+        for (label, command, style) in footer_buttons.unwrap_or_default() {
+            self.p_footer_button(label, command, style.as_deref());
+        }
+        if cancel {
+            self.p_cancel_button();
+        }
+        self.p_show();
+    }
+}
+
+/// (label, command, style) as python's tuples
+pub fn button(label: impl Into<String>, command: impl Into<String>, style: &str) -> Button {
+    (label.into(), command.into(), Some(style.to_string()))
+}
diff --git a/src/extras/afc/scope.rs b/src/extras/afc/scope.rs
new file mode 100644
index 0000000..4fc023b
--- /dev/null
+++ b/src/extras/afc/scope.rs
@@ -0,0 +1,71 @@
+// Which AFC runs: the native one when the config is inside what it ports
+// (COSMOS's stock Canvas setup), else the python AFC exactly as before
+use crate::configfile::ConfigWrapper;
+use crate::error::KResult;
+
+/// The AFC modules the native AFC replaces (klippy/extras names)
+pub const NATIVE_MODULES: [&str; 9] = ["AFC", "AFC_functions", "AFC_spool", "AFC_error", "AFC_prep", "AFC_hub", "AFC_extruder", "AFC_canvas", "AFC_canvas_lane"];
+
+/// Ok(()) when every AFC section is one the native AFC ports, else why not
+pub fn native_scope(config: &ConfigWrapper) -> KResult<Result<(), String>> {
+    let fc = config.fileconfig.clone();
+    let sections = fc.borrow().sections();
+    // [danger_options] use_python_modules: AFC (or one of its modules)
+    if sections.iter().any(|s| s == "danger_options") {
+        if let Some(list) = config.getsection("danger_options").get_opt("use_python_modules")? {
+            if list.split([',', '\n', ' ']).any(|m| m.trim().starts_with("AFC")) {
+                return Ok(Err("use_python_modules".into()));
+            }
+        }
+    }
+    let opt = |section: &str, option: &str| -> Option<String> {
+        let fc = fc.borrow();
+        if fc.has_option(section, option) {
+            fc.get(section, option).ok()
+        } else {
+            None
+        }
+    };
+    let mut afc = false;
+    for s in &sections {
+        let module = s.split_whitespace().next().unwrap_or("");
+        if !module.starts_with("AFC") {
+            continue;
+        }
+        if !NATIVE_MODULES.contains(&module) {
+            return Ok(Err(format!("[{}]", s)));
+        }
+        match module {
+            "AFC" => {
+                afc = true;
+                if opt(s, "form_tip_cmd").as_deref() == Some("AFC") {
+                    return Ok(Err("form_tip_cmd AFC".into()));
+                }
+            }
+            "AFC_extruder" => {
+                for o in ["toolchanger_unit", "tool", "u1_filament_sensor_name", "u1_park_detector_name", "led_name", "status_led_idx", "nozzle_led_idx", "buffer"] {
+                    if opt(s, o).is_some() {
+                        return Ok(Err(format!("[{}] {}", s, o)));
+                    }
+                }
+                if let Some(p) = opt(s, "pin_tool_start") {
+                    if p == "buffer" || p.to_lowercase() == "virtual" {
+                        return Ok(Err(format!("[{}] pin_tool_start {}", s, p)));
+                    }
+                }
+            }
+            "AFC_canvas" | "AFC_canvas_lane" => {
+                for o in ["buffer", "selector", "step_pin", "afc_motor_rwd", "afc_motor_fwd", "afc_motor_enb", "led_index", "led_logo_index"] {
+                    if opt(s, o).is_some() {
+                        return Ok(Err(format!("[{}] {}", s, o)));
+                    }
+                }
+            }
+            _ => {}
+        }
+    }
+    if !afc {
+        return Ok(Err("no [AFC]".into()));
+    }
+    Ok(Ok(()))
+}
diff --git a/src/extras/afc/spool.rs b/src/extras/afc/spool.rs
new file mode 100644
index 0000000..3fd2952
--- /dev/null
+++ b/src/extras/afc/spool.rs
@@ -0,0 +1,708 @@
+// AFC spool data: colors, materials, weights, spoolman, T(n) mappings (port
+// of AFC_spool.py)
+//
+// Copyright (C) 2024-2026 Armored Turtle
+// Copyright (C) 2026 AFCProject
+//
+// This file may be distributed under the terms of the GNU GPLv3 license.
+use super::codes::*;
+use super::lane::AfcLane;
+use super::{no_attr, Afc};
+use crate::configfile::{ConfigWrapper, Lim};
+use crate::error::{KError, KResult};
+use crate::gcode::GCodeCommand;
+use crate::printer::{PObj, Printer, PrinterObject};
+use crate::pyval::PyVal;
+use std::cell::RefCell;
+use std::rc::{Rc, Weak};
+
+pub const SPOOLMAN_REMOTE_METHOD: &str = "spoolman_set_active_spool";
+
+pub const CMD_AFC_SET_SPOOL_TEMP_HELP: &str = "Set spool temperatures for a lane";
+pub const CMD_SET_MAP_HELP: &str = "Changes T(n) mapping for a lane";
+pub const CMD_AFC_SWAP_MAPPING_HELP: &str = "Swaps mapping between two lanes as provided with the FROM/TO variables";
+pub const CMD_AFC_ADD_MAPPING_HELP: &str =
+    "Adds a new T(n) macro that currently does not exist to a lane. Mapping can be passed in a comma separated list to add multiple to a single lane";
+pub const CMD_AFC_REMOVE_MAPPING_HELP: &str =
+    "Removes T(n) macro from specified lane, mapping can be passed in as comma separated list to remove multiple mappings from a lane";
+pub const CMD_AFC_ENABLE_MULTIPLE_MAPPING_HELP: &str =
+    "Enable ability to have multiple T(n) macros mapped to a single lane and enables use of virtual tools";
+pub const CMD_SET_COLOR_HELP: &str = "Set filaments color for a lane";
+pub const CMD_SET_WEIGHT_HELP: &str = "Sets filaments weight for a lane";
+pub const CMD_SET_MATERIAL_HELP: &str = "Sets filaments material for a lane";
+pub const CMD_SET_SPOOL_ID_HELP: &str = "Set lanes spoolman ID";
+pub const CMD_SET_RUNOUT_HELP: &str = "Set runout lane";
+pub const CMD_AFC_RESET_MAPPING_HELP: &str = "Resets all lane mapping in AFC";
+pub const CMD_SET_NEXT_SPOOL_ID_HELP: &str = "Set the spool id to be loaded next into AFC";
+
+pub type OnDone = Box<dyn FnOnce() -> KResult<()>>;
+
+/// [AFC_spool]
+pub struct AfcSpool {
+    me: Weak<AfcSpool>,
+    printer: Rc<Printer>,
+    afc: RefCell<Weak<Afc>>,
+    pub next_spool_id: RefCell<PyVal>,
+}
+
+type SpoolCmd = fn(&Rc<AfcSpool>, &GCodeCommand) -> KResult<()>;
+
+impl AfcSpool {
+    fn new(config: &ConfigWrapper) -> Rc<AfcSpool> {
+        let printer = config.get_printer();
+        let s = Rc::new_cyclic(|me| AfcSpool { me: me.clone(), printer: printer.clone(), afc: RefCell::new(Weak::new()), next_spool_id: RefCell::new(PyVal::None) });
+        let ss = s.clone();
+        crate::events::KlippyConnect::on(&printer, move || ss.handle_connect());
+        s
+    }
+
+    fn afc(&self) -> Rc<Afc> {
+        self.afc.borrow().upgrade().expect("AFC")
+    }
+
+    fn rc(&self) -> Rc<AfcSpool> {
+        self.me.upgrade().expect("AFC_spool")
+    }
+
+    /// register_commands(afc): called from AFC's __init__
+    pub fn register_commands(&self, afc: &Rc<Afc>) -> KResult<()> {
+        *self.afc.borrow_mut() = Rc::downgrade(afc);
+        let me = self.rc();
+        let reg = |show: bool, name: &str, f: SpoolCmd, help: &str, options: Option<&[super::functions::MacroOption]>| -> KResult<()> {
+            let s = me.clone();
+            afc.function.register_commands(show, name, Rc::new(move |g| f(&s, g)), help, options)
+        };
+        reg(afc.show_macros, "AFC_ADD_MAPPING", AfcSpool::cmd_afc_add_mapping, CMD_AFC_ADD_MAPPING_HELP, Some(&[("LANE", "string", "lane1"), ("MAPPING", "string", "T0")]))?;
+        reg(afc.show_macros, "AFC_REMOVE_MAPPING", AfcSpool::cmd_afc_remove_mapping, CMD_AFC_REMOVE_MAPPING_HELP, Some(&[("MAPPING", "string", "T0")]))?;
+        reg(afc.show_macros, "AFC_ENABLE_MULTIPLE_MAPPING", AfcSpool::cmd_afc_enable_multiple_mapping, CMD_AFC_ENABLE_MULTIPLE_MAPPING_HELP, Some(&[("ENABLE", "int", "0")]))?;
+        reg(false, "AFC_SWAP_MAPPING", AfcSpool::cmd_afc_swap_mapping, CMD_AFC_SWAP_MAPPING_HELP, None)
+    }
+
+    fn handle_connect(&self) -> KResult<()> {
+        let me = self.rc();
+        let s = me.clone();
+        self.printer.register_event_handler(
+            super::lane::REGISTER_MACROS_EVENT,
+            Rc::new(move |args| {
+                let lane: Rc<AfcLane> = crate::events::arg(super::lane::REGISTER_MACROS_EVENT, args, 0)?;
+                s.register_lane_macros(&lane)
+            }),
+        );
+        let gcode = self.afc().gcode.clone();
+        let s = me.clone();
+        gcode.register_command("AFC_RESET_MAPPING", Some(Rc::new(move |g| s.cmd_afc_reset_mapping(g))), false, Some(CMD_AFC_RESET_MAPPING_HELP))?;
+        let s = me.clone();
+        gcode.register_command("SET_NEXT_SPOOL_ID", Some(Rc::new(move |g| s.cmd_set_next_spool_id(g))), false, Some(CMD_SET_NEXT_SPOOL_ID_HELP))?;
+        Ok(())
+    }
+
+    fn register_lane_macros(&self, lane_obj: &AfcLane) -> KResult<()> {
+        let me = self.rc();
+        let gcode = self.afc().gcode.clone();
+        let cmds: [(&str, SpoolCmd, &str); 7] = [
+            ("SET_COLOR", AfcSpool::cmd_set_color, CMD_SET_COLOR_HELP),
+            ("SET_WEIGHT", AfcSpool::cmd_set_weight, CMD_SET_WEIGHT_HELP),
+            ("SET_MATERIAL", AfcSpool::cmd_set_material, CMD_SET_MATERIAL_HELP),
+            ("SET_SPOOL_ID", AfcSpool::cmd_set_spool_id, CMD_SET_SPOOL_ID_HELP),
+            ("SET_RUNOUT", AfcSpool::cmd_set_runout, CMD_SET_RUNOUT_HELP),
+            ("SET_MAP", AfcSpool::cmd_set_map, CMD_SET_MAP_HELP),
+            ("AFC_SET_SPOOL_TEMP", AfcSpool::cmd_afc_set_spool_temp, CMD_AFC_SET_SPOOL_TEMP_HELP),
+        ];
+        for (cmd, f, help) in cmds {
+            let s = me.clone();
+            gcode.register_mux_command(cmd, "LANE", Some(&lane_obj.name), Rc::new(move |g| f(&s, g)), Some(help))?;
+        }
+        Ok(())
+    }
+
+    /// (snapmaker printers only: never on kalico)
+    pub fn set_snapmaker_filament_params(&self, _lane: &AfcLane) {}
+
+    fn lane_arg(&self, gcmd: &GCodeCommand, code: &super::logger::Code, missing: &str) -> Option<Rc<AfcLane>> {
+        let afc = self.afc();
+        let Some(lane) = gcmd.get_opt("LANE") else {
+            afc.logger.info(code, missing);
+            return None;
+        };
+        match afc.lane(&lane) {
+            Some(l) => Some(l),
+            None => {
+                afc.logger.info(code, &format!("{} Unknown", lane));
+                None
+            }
+        }
+    }
+
+    fn cmd_afc_set_spool_temp(self: &Rc<Self>, gcmd: &GCodeCommand) -> KResult<()> {
+        let afc = self.afc();
+        let Some(cur_lane) = self.lane_arg(gcmd, &AFC_SPOOL_AFCSPOOL_CMD_AFC_SET_SPOOL_TEMP, "No LANE parameter provided, please specify a valid LANE parameter.") else {
+            return Ok(());
+        };
+        let get = |name: &str, cur: &PyVal| -> KResult<PyVal> {
+            Ok(match gcmd.get_opt(name) {
+                Some(_) => PyVal::Int(gcmd.get_int(name, None, Lim::new().min(0))?),
+                None => cur.clone(),
+            })
+        };
+        let bed = get("BED_TEMP", &cur_lane.bed_temp.borrow().clone())?;
+        *cur_lane.bed_temp.borrow_mut() = bed;
+        let ext = get("EXTRUDER_TEMP", &cur_lane.extruder_temp.borrow().clone())?;
+        *cur_lane.extruder_temp.borrow_mut() = ext;
+        cur_lane.send_lane_data()?;
+        afc.save_vars()
+    }
+
+    fn cmd_set_map(self: &Rc<Self>, gcmd: &GCodeCommand) -> KResult<()> {
+        let afc = self.afc();
+        let c = &AFC_SPOOL_AFCSPOOL_CMD_SET_MAP;
+        let lane = gcmd.get("LANE")?;
+        let map_cmd = gcmd.get("MAP")?.to_uppercase();
+        let Some(lane_switch) = afc.tool_cmds.borrow().get(&map_cmd).cloned() else {
+            afc.logger.error(c, &format!("Invalid map command: {}", map_cmd));
+            return Ok(());
+        };
+        afc.logger.debug(c, &format!("lane to switch is {}", lane_switch));
+        let Some(cur_lane) = afc.lane(&lane) else {
+            afc.logger.info(c, &format!("{} Unknown", lane));
+            return Ok(());
+        };
+        let Some(sw_lane) = afc.lane(&lane_switch) else {
+            afc.logger.info(c, &format!("{} is not found when swapping mapping.", lane_switch));
+            return Ok(());
+        };
+        if Rc::ptr_eq(&sw_lane, &cur_lane) {
+            afc.logger.info(c, &format!("{} is already mapped to {}", map_cmd, lane));
+            return Ok(());
+        }
+        if afc.enable_multiple_mapping.get() {
+            let m: Vec<String> = sw_lane.map.borrow().iter().filter(|c| **c != map_cmd).cloned().collect();
+            *sw_lane.map.borrow_mut() = m;
+            if *sw_lane.current_map.borrow() == map_cmd {
+                *sw_lane.current_map.borrow_mut() = String::new();
+            }
+            let mut m = cur_lane.map.borrow().clone();
+            m.push(map_cmd.clone());
+            *cur_lane.map.borrow_mut() = m.into_iter().filter(|m| m != "NONE").collect();
+        } else {
+            let m = cur_lane.map.borrow().clone();
+            *sw_lane.current_map.borrow_mut() = m.first().cloned().unwrap_or_default();
+            *sw_lane.map.borrow_mut() = m;
+            *cur_lane.map.borrow_mut() = vec![map_cmd.clone()];
+            *cur_lane.current_map.borrow_mut() = map_cmd;
+        }
+        for m in sw_lane.map.borrow().iter() {
+            if m == "NONE" {
+                continue;
+            }
+            afc.tool_cmds.borrow_mut().insert(m.clone(), sw_lane.name.clone());
+        }
+        for m in cur_lane.map.borrow().iter() {
+            afc.tool_cmds.borrow_mut().insert(m.clone(), cur_lane.name.clone());
+        }
+        sw_lane.send_lane_data()?;
+        cur_lane.send_lane_data()?;
+        afc.save_vars()
+    }
+
+    fn cmd_afc_swap_mapping(self: &Rc<Self>, gcmd: &GCodeCommand) -> KResult<()> {
+        let afc = self.afc();
+        let lane_from = gcmd.get("FROM")?;
+        let lane_to = gcmd.get("TO")?;
+        if lane_from.to_lowercase() == lane_to.to_lowercase() {
+            return Err(gcmd.error(format!("FROM({}) TO({}) values are the same, not swapping.", lane_from, lane_to)));
+        }
+        let from = afc.lane(&lane_from).ok_or_else(|| gcmd.error(format!("Swapping from {} not found", lane_from)))?;
+        let to = afc.lane(&lane_to).ok_or_else(|| gcmd.error(format!("Swapping to {} not found", lane_to)))?;
+        let from_mapping = from.map.borrow().clone();
+        let to_mapping = to.map.borrow().clone();
+        let from_current = from.current_map.borrow().clone();
+        let to_current = to.current_map.borrow().clone();
+        *from.current_map.borrow_mut() = to_current;
+        *from.map.borrow_mut() = to_mapping;
+        *to.current_map.borrow_mut() = from_current;
+        *to.map.borrow_mut() = from_mapping;
+        for (lane, name) in [(&from, &from.name), (&to, &to.name)] {
+            for m in lane.map.borrow().iter() {
+                if m != "NONE" {
+                    afc.tool_cmds.borrow_mut().insert(m.clone(), name.clone());
+                }
+            }
+        }
+        from.send_lane_data()?;
+        to.send_lane_data()?;
+        afc.save_vars()?;
+        afc.logger.info(&AFC_SPOOL_AFCSPOOL_CMD_AFC_SWAP_MAPPING, &format!("Swapping mapping from({}) to({}) successful.", lane_from, lane_to));
+        Ok(())
+    }
+
+    fn cmd_afc_add_mapping(self: &Rc<Self>, gcmd: &GCodeCommand) -> KResult<()> {
+        let afc = self.afc();
+        let c = &AFC_SPOOL_AFCSPOOL_CMD_AFC_ADD_MAPPING;
+        if !afc.enable_multiple_mapping.get() {
+            return Err(gcmd.error("Enable multiple mapping needs to be enabled to add mappings, enable by running AFC_ENABLE_MULTIPLE_MAPPING ENABLE=1"));
+        }
+        let lane = gcmd.get("LANE")?;
+        let mapping = gcmd.get("MAPPING")?;
+        let lane_obj = afc.lane(&lane).ok_or_else(|| gcmd.error(format!("{} is not a valid lane", lane)))?;
+        for m in mapping.to_uppercase().split(',') {
+            let valid = m.len() > 1 && m.starts_with('T') && m[1..].chars().all(|c| c.is_ascii_digit());
+            if !valid {
+                afc.error.afc_error(c, &format!("'{}' is not a valid mapping, expect T(n) format.", m), false, None)?;
+                continue;
+            }
+            if afc.tool_cmds.borrow().contains_key(m) {
+                afc.error.afc_error(c, &format!("Cannot map {} to {}, as mapping already exists.", m, lane), false, None)?;
+                continue;
+            }
+            afc.logger.info(c, &format!("Adding {} to {}", m, lane));
+            afc.tool_cmds.borrow_mut().insert(m.to_string(), lane.clone());
+            let mut map = lane_obj.map.borrow().clone();
+            map.push(m.to_string());
+            *lane_obj.map.borrow_mut() = map;
+            afc.function.register_tool_macro(&lane, m, "")?;
+        }
+        lane_obj.send_lane_data()?;
+        afc.save_vars()
+    }
+
+    fn cmd_afc_remove_mapping(self: &Rc<Self>, gcmd: &GCodeCommand) -> KResult<()> {
+        let afc = self.afc();
+        let c = &AFC_SPOOL_AFCSPOOL_CMD_AFC_REMOVE_MAPPING;
+        if !afc.enable_multiple_mapping.get() {
+            return Err(gcmd.error("Enable multiple mapping needs to be enabled to remove mappings, enable by running AFC_ENABLE_MULTIPLE_MAPPING ENABLE=1"));
+        }
+        let mapping = gcmd.get("MAPPING")?;
+        for m in mapping.to_uppercase().split(',') {
+            let lane = afc.tool_cmds.borrow_mut().shift_remove(m);
+            let Some(lane) = lane else {
+                afc.error.afc_error(c, &format!("Mapping {} does not exist", m), false, None)?;
+                continue;
+            };
+            if let Some(lane_obj) = afc.lane(&lane) {
+                afc.logger.info(c, &format!("Removing {} macro from {}", m, lane));
+                let map: Vec<String> = lane_obj.map.borrow().iter().filter(|x| *x != m).cloned().collect();
+                *lane_obj.map.borrow_mut() = map;
+                if *lane_obj.current_map.borrow() == m {
+                    let first = lane_obj.map.borrow().first().cloned().unwrap_or_default();
+                    *lane_obj.current_map.borrow_mut() = first;
+                }
+                lane_obj.send_lane_data()?;
+            }
+            afc.gcode.register_command(m, None, false, None)?;
+        }
+        afc.save_vars()
+    }
+
+    fn cmd_afc_enable_multiple_mapping(self: &Rc<Self>, gcmd: &GCodeCommand) -> KResult<()> {
+        let afc = self.afc();
+        let c = &AFC_SPOOL_AFCSPOOL_CMD_AFC_ENABLE_MULTIPLE_MAPPING;
+        let enable = gcmd.get_int("ENABLE", Some(0), Lim::new())? != 0;
+        if enable {
+            afc.enable_multiple_mapping.set(true);
+            afc.logger.info(c, "Multiple T(n) mapping per lane has been enabled along with ability to add virtual tools with AFC_ADD_MAPPING macro");
+        } else {
+            afc.enable_multiple_mapping.set(false);
+            afc.logger.info(c, "Multiple T(n) mapping per lane and virtual tools has been disabled");
+            self.reset_mapping("no")?;
+        }
+        afc.function.config_rewrite("AFC", "enable_multiple_mapping", &PyVal::Bool(afc.enable_multiple_mapping.get()), "")
+    }

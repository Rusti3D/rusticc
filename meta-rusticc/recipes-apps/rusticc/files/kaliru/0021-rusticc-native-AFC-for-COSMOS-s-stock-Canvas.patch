+    /// handle_activate_extruder: lanes off, the active extruder's lane on
+    pub fn handle_activate_extruder(&self) -> KResult<()> {
+        let afc = self.afc();
+        let c = &AFC_FUNCTIONS_AFCFUNCTION__HANDLE_ACTIVATE_EXTRUDER;
+        let cur_lane_loaded = self.get_current_lane_obj();
+        self.logger().debug(c, &format!("Activating extruder lane: {}", cur_lane_loaded.as_ref().map(|l| l.name.as_str()).unwrap_or("None")));
+        afc.spool.set_active_spool(&PyVal::Str(String::new()))?;
+        let lanes: Vec<(String, Rc<AfcLane>)> = afc.lanes.borrow().iter().map(|(k, v)| (k.clone(), v.clone())).collect();
+        for (key, obj) in lanes {
+            if cur_lane_loaded.as_ref().is_none_or(|c| key != c.name) {
+                obj.do_enable(false)?;
+                obj.disable_buffer()?;
+                if cur_lane_loaded.as_ref().is_none_or(|c| obj.unit_obj().ok().map(|u| u.name.clone()) != c.unit_obj().ok().map(|u| u.name.clone())) {
+                    obj.unit_obj()?.return_to_home(false)?;
+                }
+                obj.unsync_to_extruder(true)?;
+                if obj.prep_state.get() && obj.load_state() {
+                    if obj.tool_loaded.get() {
+                        obj.unit_obj()?.lane_tool_loaded_idle(&obj)?;
+                    } else {
+                        obj.unit_obj()?.lane_loaded(&obj, false)?;
+                    }
+                } else {
+                    obj.unit_obj()?.lane_not_ready(&obj)?;
+                }
+            }
+        }
+        let Some(cur) = cur_lane_loaded else { return Ok(()) };
+        afc.spool.set_active_spool(&cur.spool_id.borrow().clone())?;
+        cur.unit_obj()?.lane_tool_loaded(&cur)?;
+        cur.do_enable(true)?;
+        cur.enable_buffer(false)?;
+        cur.sync_to_extruder(true)?;
+        cur.unit_obj()?.select_lane(&cur, false)?;
+        self.logger().debug(c, "Activate extruder done");
+        Ok(())
+    }
+
+    pub fn unset_lane_loaded(&self) -> KResult<()> {
+        let afc = self.afc();
+        if let Some(cur) = self.get_current_lane_obj() {

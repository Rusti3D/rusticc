+            cur.set_tool_unloaded(true)?;
+            cur.unit_obj()?.return_to_home(false)?;
+            self.handle_activate_extruder()?;
+            self.logger().info(&AFC_FUNCTIONS_AFCFUNCTION_UNSET_LANE_LOADED, &format!("Manually removing {} loaded from toolhead", cur.name));
+            afc.save_vars()?;
+        }
+        Ok(())
+    }

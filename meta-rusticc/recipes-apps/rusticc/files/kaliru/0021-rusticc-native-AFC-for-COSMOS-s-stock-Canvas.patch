+    pub fn is_homed(&self, for_move: bool) -> KResult<bool> {
+        let afc = self.afc();
+        let curtime = afc.reactor.monotonic();
+        let kin_status = afc.toolhead()?.get_kinematics().get_status(curtime);
+        let homed_axes = kin_status.get("homed_axes").map(|v| v.str()).unwrap_or_default();
+        let homing_check = for_move || !afc.disable_homing_check;
+        Ok(!(homing_check && !(homed_axes.contains('x') && homed_axes.contains('y') && homed_axes.contains('z'))))
+    }

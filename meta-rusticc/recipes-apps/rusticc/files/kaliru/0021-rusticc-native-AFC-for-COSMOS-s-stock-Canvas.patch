+    fn cmd_set_bowden_length(self: &Rc<Self>, gcmd: &GCodeCommand) -> KResult<()> {
+        let afc = self.afc();
+        let logger = self.logger();
+        let c = &AFC_FUNCTIONS_AFCFUNCTION_CMD_SET_BOWDEN_LENGTH;
+        let hub = gcmd.get_opt("HUB");
+        let length_param = gcmd.get_opt("LENGTH");
+        let unload_length = gcmd.get_opt("UNLOAD_LENGTH");
+        let hub = match hub {
+            Some(h) => h,
+            // (python reads self.current here: an AttributeError either way)
+            None => return Err(no_attr("afcFunction", "current")),
+        };
+        let cur_hub = afc.hubs.borrow().get(&hub).cloned().ok_or_else(|| KError::Py("KeyError".into(), super::py_repr(&hub)))?;
+        let cur_bowden_len = cur_hub.afc_bowden_length.get();
+        let cur_unload_bowden_len = cur_hub.afc_unload_bowden_length.get();
+        if let Some(l) = length_param {
+            cur_hub.afc_bowden_length.set(self.calc_length(cur_hub.config_bowden_length, cur_bowden_len, &l)?);
+        }
+        if let Some(l) = unload_length {
+            cur_hub.afc_unload_bowden_length.set(self.calc_length(cur_hub.config_unload_bowden_length, cur_unload_bowden_len, &l)?);
+        }
+        let mut msg = format!("// Hub : {}\n", hub);
+        msg += "// afc_bowden_length:\n";
+        msg += &format!("//   Config Bowden Length:   {}\n", py_float_repr(cur_hub.config_bowden_length));
+        msg += &format!("//   Previous Bowden Length: {}\n", py_float_repr(cur_bowden_len));
+        msg += &format!("//   New Bowden Length:      {}\n", py_float_repr(cur_hub.afc_bowden_length.get()));
+        msg += "// afc_unload_bowden_length:\n";
+        msg += &format!("//   Config Bowden Length:   {}\n", py_float_repr(cur_hub.config_unload_bowden_length));
+        msg += &format!("//   Previous Bowden Length: {}\n", py_float_repr(cur_unload_bowden_len));
+        msg += &format!("//   New Bowden Length:      {}\n", py_float_repr(cur_hub.afc_unload_bowden_length.get()));
+        msg += "\n// TO SAVE BOWDEN LENGTH afc_bowden_length MUST BE UPDATED IN AFC_Turtle_(n).cfg for each AFC_hub if there are multiple";
+        logger.raw(c, &msg);
+        Ok(())
+    }

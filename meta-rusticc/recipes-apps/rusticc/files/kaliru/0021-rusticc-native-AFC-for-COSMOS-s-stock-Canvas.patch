+    fn cmd_afc_reset_td1(self: &Rc<Self>, gcmd: &GCodeCommand) -> KResult<()> {
+        let afc = self.afc();
+        let logger = self.logger();
+        let c = &AFC_FUNCTIONS_AFCFUNCTION_CMD_AFC_RESET_TD1;
+        let serial_number = gcmd.get("SERIAL")?;
+        let mut timeout_count = 0;
+        logger.info(c, &format!("Sending reboot command to TD-1 serial: {}", serial_number));
+        let moonraker = afc.moonraker.borrow().clone().ok_or_else(|| no_attr("NoneType", "reboot_td1"))?;
+        let status = moonraker.reboot_td1(&serial_number);
+        let status_field = |k: &str| -> Option<PyVal> {
+            match status.as_ref().map(|s| s.get()) {
+                Some(PyVal::Dict(d)) => d.get(k).cloned(),
+                _ => None,
+            }
+        };
+        match status_field("status").map(|s| s.str()) {
+            Some(s) if s == "ok" => {
+                logger.info(c, "Waiting up to 30 seconds for device to reboot");
+                loop {
+                    let data = moonraker.get_td1_data();
+                    let entry = match data.as_ref().map(|d| d.get()) {
+                        Some(PyVal::Dict(d)) => d.get(serial_number.as_str()).cloned(),
+                        _ => None,
+                    };
+                    if let Some(entry) = entry {
+                        let err = match entry.get() {
+                            PyVal::Dict(e) => e.get("error").cloned().filter(|v| !matches!(v, PyVal::None)),
+                            _ => None,
+                        };
+                        match err {
+                            Some(err) => logger.error(c, &format!("Error still not fixed\nReported error: {}", err.str())),
+                            None => logger.info(c, &format!("TD-1 serial:{} rebooted successfully without error", serial_number)),
+                        }
+                        break;
+                    } else if timeout_count > 30 {
+                        logger.error(c, "Timeout occurred when trying to verify TD-1 rebooted successfully");
+                        break;
+                    }
+                    timeout_count += 1;
+                    afc.toolhead()?.dwell(1.0)?;
+                }
+            }
+            Some(s) if s == "key_error" => logger.error(c, "An incorrect serial number was provided"),
+            Some(_) => {}
+            None => {
+                if status.is_none() {
+                    return Err(KError::Py("TypeError".into(), "argument of type 'NoneType' is not iterable".into()));
+                }
+                logger.error(c, "An error occurred when trying to send reboot command");
+            }
+        }
+        Ok(())
+    }

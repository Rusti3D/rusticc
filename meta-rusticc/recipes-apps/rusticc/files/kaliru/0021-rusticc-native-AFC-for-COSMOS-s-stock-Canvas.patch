+    /// "<status>:<color>" for the lane's status
+    pub fn get_filament_status(&self, cur_lane: &AfcLane) -> KResult<String> {
+        let color = |c: &str| -> KResult<String> { Ok(self.hex_convert(c)?.rsplit(':').next().unwrap_or("").to_string()) };
+        if cur_lane.prep_state.get() {
+            if cur_lane.load_state() {
+                if cur_lane.extruder_obj_opt().is_some_and(|e| e.lane_loaded.borrow().as_deref() == Some(cur_lane.name.as_str())) {
+                    return Ok(format!("In Tool:{}", color(&cur_lane.led_tool_loaded())?));
+                }
+                return Ok(format!("Ready:{}", color(&cur_lane.led_ready())?));
+            }
+            return Ok(format!("Prep:{}", color(&cur_lane.led_prep_loaded())?));
+        }
+        Ok(format!("Not Ready:{}", color(&cur_lane.led_not_ready())?))
+    }

+    fn cmd_calibrate_afc(self: &Rc<Self>, gcmd: &GCodeCommand) -> KResult<()> {
+        let afc = self.afc();
+        let logger = self.logger();
+        let c = &AFC_FUNCTIONS_AFCFUNCTION_CMD_CALIBRATE_AFC;
+        let prompt = AfcPrompt::new(&logger);
+        let dis = gcmd.get_float("DISTANCE", Some(25.0), Lim::new())?;
+        let tol = gcmd.get_float("TOLERANCE", Some(5.0), Lim::new())?;
+        let afc_bl = gcmd.get_opt("BOWDEN");
+        let lanes = gcmd.get_opt("LANE");
+        let unit = gcmd.get_opt("UNIT");
+        let td1 = gcmd.get_opt("TD1");
+        prompt.p_end();
+        if let Some(cur) = afc.current() {
+            logger.info(c, &format!("current afc {} is not None, cannot calibrate", cur));
+            logger.error(c, "Tool must be unloaded to calibrate system");
+            return Ok(());
+        }
+        let mut calibrated = vec![];
+        let mut checked = false;
+        let mut title = "AFC Calibration".to_string();
+        let mut additional_msg: Vec<String> = vec![];
+        let mut td1_lane_valid = false;
+        if let Some(l) = lanes.as_deref().filter(|l| *l != "all") {
+            match afc.lane(l) {
+                None => {
+                    afc.error.afc_error(c, &format!("'{}' is not a valid lane", l), false, None)?;
+                    return Ok(());
+                }
+                Some(lane) if lane.extruder_obj()?.is_standalone() => {
+                    afc.error.afc_error(c, &format!("{} is a standalone lane, cannot calibrate", l), false, None)?;
+                    return Ok(());
+                }
+                _ => {}
+            }
+        }
+        if let Some(u) = unit.as_deref().filter(|u| !afc.units.borrow().contains_key(*u)) {
+            afc.error.afc_error(c, &format!("'{}' is not a valid unit", u), false, None)?;
+            return Ok(());
+        }
+        if let Some(b) = afc_bl.as_deref().filter(|b| afc.lane(b).is_none()) {
+            afc.error.afc_error(c, &format!("'{}' is not a valid lane to calibrate bowden length", b), false, None)?;
+            return Ok(());
+        }
+        if let Some(t) = td1.as_deref() {
+            if !afc.td1_present()? {
+                afc.error.afc_error(c, "TD-1 is not present, will not be able to calibrate bowden length for TD-1", false, None)?;
+            } else if afc.lane(t).is_none() {
+                afc.error.afc_error(c, &format!("'{}' is not a valid lane to calibrate TD-1 bowden length", t), false, None)?;
+            } else {
+                td1_lane_valid = true;
+            }
+        }
+        let res = (|| -> KResult<()> {
+            match lanes.as_deref() {
+                Some(l) => (checked, calibrated, additional_msg) = self.lane_calibration(l, unit.as_deref(), tol, dis)?,
+                None => logger.info(c, "No lanes selected to calibrate dist_hub"),
+            }
+            if let Some(b) = afc_bl.as_deref() {
+                let cur_lane = afc.lane(b).ok_or_else(|| KError::Py("KeyError".into(), super::py_repr(b)))?;
+                let (failed_check, set_back, msg) = self.calibration_check_tool_start(&cur_lane)?;
+                if failed_check {
+                    additional_msg.push(msg.clone());
+                    afc.error.afc_error(c, &msg, false, None)?;
+                    return Ok(());
+                }
+                let r = (|| -> KResult<bool> {
+                    logger.info(c, "Starting AFC distance Calibrations");
+                    let (ok, msg, pos) = cur_lane.unit_obj()?.calibrate_bowden(&cur_lane, dis, tol)?;
+                    checked = ok;
+                    if !checked {
+                        let msg = format!("{} failed to calibrate bowden length {}", b, msg);
+                        afc.error.afc_error(c, &msg, false, None)?;
+                        self.afc_cali_fail(&cur_lane.name, Some(PyVal::Float(pos.abs())), pos != 0.0, "AFC Bowden Calibration Failed", &msg)?;
+                        return Ok(false);
+                    }
+                    calibrated.push(format!("Bowden_length: {}", b));
+                    logger.info(c, "Bowden length calibration Done!");
+                    Ok(true)
+                })();
+                let _ = set_back;
+                if !r? {
+                    return Ok(());
+                }
+            }
+            if td1.is_some() && td1_lane_valid && afc.td1_present()? {
+                title = "TD-1 Calibration".to_string();
+                let t = td1.clone().unwrap_or_default();
+                let td1_lane = afc.lane(&t).ok_or_else(|| KError::Py("KeyError".into(), super::py_repr(&t)))?;
+                if td1_lane.is_direct_hub() && td1_lane.tool_loaded.get() {
+                    let msg = format!("{} loaded to toolhead, unload from toolhead before trying to calibrate td1_bowden_length.", td1_lane.name);
+                    afc.error.afc_error(c, &msg, false, None)?;
+                    return Ok(());
+                }
+                let hub = td1_lane.hub_obj()?;
+                if hub.state() {
+                    let msg = format!("{} hub is triggered, make sure hub is clear before trying to calibrate TD-1 bowden length", hub.name);
+                    afc.error.afc_error(c, &msg, false, None)?;
+                    afc.gcode.run_script_from_command(&format!("AFC_CALI_FAIL TITLE='{} Failed' FAIL={} DISTANCE=0 msg='{}' RESET=0", title, t, msg))?;
+                    return Ok(());
+                }
+                let (ok, msg, pos) = td1_lane.unit_obj()?.calibrate_td1(&td1_lane, dis, tol)?;
+                checked = ok;
+                if !checked {
+                    let fail_string = format!("{} failed to calibrate TD-1 bowden length, {}", t, msg);
+                    afc.error.afc_error(c, &fail_string, false, None)?;
+                    afc.gcode.run_script_from_command(&format!(
+                        "AFC_CALI_FAIL TITLE='{} Failed' FAIL={} DISTANCE={} msg='{}' RESET=1",
+                        title,
+                        t,
+                        py_float_repr(pos),
+                        fail_string
+                    ))?;
+                    return Ok(());
+                }
+                calibrated.push(format!("'TD1_Bowden_length: {}'", t));
+            }
+            Ok(())
+        })();
+        if checked {
+            let lanes_calibrated = calibrated.join(", ");
+            let msg = additional_msg.join(" ");
+            self.afc_cali_comp(&lanes_calibrated, &title, &msg);
+        }
+        res
+    }

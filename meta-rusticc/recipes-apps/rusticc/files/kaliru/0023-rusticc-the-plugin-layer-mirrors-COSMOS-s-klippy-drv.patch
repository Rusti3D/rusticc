diff --git a/src/plugins/impls/cosmos.rs b/src/plugins/impls/cosmos.rs
new file mode 100644
index 0000000..15b546d
--- /dev/null
+++ b/src/plugins/impls/cosmos.rs
@@ -0,0 +1,20 @@
+// COSMOS's own klippy modules (Rusticc ports them natively): what python
+// modules call on them. The python AFC drives the Canvas lane motors through
+// drv8833.
+use super::*;
+use crate::extras::drv8833::PrinterDrv8833;
+use crate::ro_attr;
+
+pub fn register(r: &mut Registry) {
+    r.method("klippy.extras.drv8833.PrinterDrv8833.drv8833_set_speed", |a| {
+        a.this::<PrinterDrv8833>()?.drv8833_set_speed(a.f64(0)?)?;
+        Ok(py_none())
+    });
+    // drv8833_move(speed, distance, wait_for_completion=True)
+    r.method("klippy.extras.drv8833.PrinterDrv8833.drv8833_move", |a| {
+        a.this::<PrinterDrv8833>()?.drv8833_move(a.f64(0)?, a.f64(1)?, a.bool(2)?)?;
+        Ok(py_none())
+    });
+    ro_attr!(r, "klippy.extras.drv8833.PrinterDrv8833.active", PrinterDrv8833, |m| m.is_active());
+    ro_attr!(r, "klippy.extras.drv8833.PrinterDrv8833.name", PrinterDrv8833, |m| m.name.clone());
+}

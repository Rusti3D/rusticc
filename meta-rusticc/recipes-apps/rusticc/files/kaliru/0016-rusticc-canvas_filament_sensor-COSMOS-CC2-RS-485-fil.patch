+impl PinChip for CanvasFilamentSensor {
+    fn setup_pin(&self, _pin_type: &str, _pin_params: &SharedPinParams) -> Result<Rc<dyn Any>, String> {
+        Err(format!("{} pins can only be used as button inputs", self.chip_name))

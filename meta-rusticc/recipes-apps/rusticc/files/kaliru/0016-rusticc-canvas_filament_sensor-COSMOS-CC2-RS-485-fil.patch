+/// The MCU calls MCU_buttons makes. Python takes any object that has these
+/// methods: kaliru's MCUs, and pin chips that answer them themselves
+/// (COSMOS's canvas_filament_sensor emulates a buttons MCU)
+pub trait ButtonsHost {
+    fn register_config_callback(&self, cb: Rc<dyn Fn() -> KResult<()>>);
+    fn create_oid(&self) -> i64;
+    fn add_config_cmd(&self, cmd: &str, is_init: bool, on_restart: bool) -> KResult<()>;
+    fn alloc_command_queue(&self) -> Option<CommandQueue>;
+    fn lookup_command(&self, msgformat: &str, cq: Option<CommandQueue>) -> KResult<ButtonsCommand>;
+    fn get_query_slot(&self, oid: i64) -> i64;
+    fn seconds_to_clock(&self, time: f64) -> i64;
+    fn register_response(&self, cb: Rc<dyn Fn(&Params) -> KResult<()>>, msg: &str, oid: i64);
+}
+
+impl ButtonsHost for Mcu {
+    fn register_config_callback(&self, cb: Rc<dyn Fn() -> KResult<()>>) {
+        Mcu::register_config_callback(self, cb)
+    }
+    fn create_oid(&self) -> i64 {
+        Mcu::create_oid(self)
+    }
+    fn add_config_cmd(&self, cmd: &str, is_init: bool, on_restart: bool) -> KResult<()> {
+        Mcu::add_config_cmd(self, cmd, is_init, on_restart);
+        Ok(())
+    }
+    fn alloc_command_queue(&self) -> Option<CommandQueue> {
+        Some(Mcu::alloc_command_queue(self))
+    }
+    fn lookup_command(&self, msgformat: &str, cq: Option<CommandQueue>) -> KResult<ButtonsCommand> {
+        let cmd = Mcu::lookup_command(self, msgformat, cq)?;
+        Ok(Rc::new(move |data| cmd.send(data, 0, 0)))
+    }
+    fn get_query_slot(&self, oid: i64) -> i64 {
+        Mcu::get_query_slot(self, oid)
+    }
+    fn seconds_to_clock(&self, time: f64) -> i64 {
+        Mcu::seconds_to_clock(self, time)
+    }
+    fn register_response(&self, cb: Rc<dyn Fn(&Params) -> KResult<()>>, msg: &str, oid: i64) {
+        Mcu::register_response(self, Some(cb), msg, Some(oid))
+    }
+}

+        self.me.upgrade().map(|s| s as Rc<dyn ButtonsHost>)
+    }
+}
+
+/// The subset of the MCU interface used by buttons' McuButtons
+impl ButtonsHost for CanvasFilamentSensor {
+    fn register_config_callback(&self, cb: Rc<dyn Fn() -> KResult<()>>) {
+        self.config_callbacks.borrow_mut().push(cb);
+    }
+    fn create_oid(&self) -> i64 {
+        let oid = self.next_oid.get();
+        self.next_oid.set(oid + 1);
+        // "last": None so the first update is always sent and McuButtons
+        // sees the initial level of inverted pins
+        self.groups.borrow_mut().insert(oid, Group { pins: vec![], handler: None, ack: 0, last: None });
+        oid
+    }
+    fn add_config_cmd(&self, cmd: &str, _is_init: bool, _on_restart: bool) -> KResult<()> {
+        // Only "buttons_add oid=%d pos=%d pin=%s pull_up=%d" matters
+        let mut parts = cmd.split_whitespace();
+        if parts.next() != Some("buttons_add") {
+            return Ok(());
+        }
+        let args: IndexMap<&str, &str> = parts.filter_map(|p| p.split_once('=')).collect();
+        let pin = args.get("pin").copied().unwrap_or_default();
+        let Some(index) = PINS.iter().position(|p| *p == pin) else {
+            return Err(KError::Pins(format!("unknown pin {}:{} (use {})", self.chip_name, pin, PINS.join(", "))));
+        };
+        let oid: i64 = args.get("oid").and_then(|o| o.parse().ok()).unwrap_or_default();
+        if let Some(g) = self.groups.borrow_mut().get_mut(&oid) {
+            g.pins.push(index);
+        }
+        Ok(())
+    }
+    fn alloc_command_queue(&self) -> Option<CommandQueue> {
+        None
+    }
+    fn lookup_command(&self, _msgformat: &str, _cq: Option<CommandQueue>) -> KResult<ButtonsCommand> {
+        // Only "buttons_ack oid=%c count=%c"
+        let w = self.me.clone();
+        Ok(Rc::new(move |data| match w.upgrade() {
+            Some(s) => s.handle_ack(data),
+            None => Ok(()),
+        }))
+    }
+    fn get_query_slot(&self, _oid: i64) -> i64 {
+        0
+    }
+    fn seconds_to_clock(&self, _time: f64) -> i64 {
+        0
+    }
+    fn register_response(&self, cb: Rc<dyn Fn(&Params) -> KResult<()>>, _msg: &str, oid: i64) {
+        if let Some(g) = self.groups.borrow_mut().get_mut(&oid) {
+            g.handler = Some(cb);
+        }
+    }
+}
+
+impl PrinterObject for CanvasFilamentSensor {
+    fn has_status(&self) -> bool {
+        true
+    }
+    fn get_status(&self, _eventtime: f64) -> Option<PyVal> {
+        let opt_bool = |v: Option<bool>| v.map(PyVal::Bool).unwrap_or(PyVal::None);
+        let levels = self.levels.get();
+        Some(PyVal::Dict(crate::pydict! {
+            "connected" => PyVal::Bool(self.connected.get()),
+            "version" => self.version.borrow().clone().map(PyVal::Str).unwrap_or(PyVal::None),
+            "filament_present" => opt_bool(self.present.get()),
+            "edges" => self.edges.get().map(|e| PyVal::Int(e as i64)).unwrap_or(PyVal::None),
+            "crc_errors" => PyVal::Int(self.parser.borrow().errors),
+            "pins" => PyVal::Dict(crate::pydict! { "filament" => PyVal::Int(levels[0]), "encoder" => PyVal::Int(levels[1]) }),
+        }))
+    }
+    fn teardown(&self) {
+        self.close();
+    }
+}
+
+pub fn load_config(config: &ConfigWrapper) -> KResult<PObj> {
+    Ok(CanvasFilamentSensor::new(config)?)
+}

+// Watchdog code on hifi4
+//
+// Copyright (C) 2026  James Turton <james.turton@gmx.com>
+//
+// This file may be distributed under the terms of the GNU GPLv3 license.
+use super::lib::hal_core::hal_restart;
+use super::lib::watchdog::{watchdog_init, watchdog_kick, watchdog_set_handler, watchdog_start, WDOG_INTV_1_SEC};
+use crate::command::Args;
+use crate::sched::R;
+use crate::{decl_command, decl_init, decl_task};
+
+pub fn command_reset(_args: &Args) -> R {
+    hal_restart();
+}
+decl_command!(command_reset, HF_IN_SHUTDOWN, "reset");
+
+pub fn watchdog_hw_reset() -> R {
+    watchdog_kick();
+    Ok(())
+}
+decl_task!(watchdog_hw_reset);
+
+fn wdog_irq_handler(_irq: u32) {
+    hal_restart();
+}
+
+pub fn watchdog_hw_init() -> R {
+    watchdog_set_handler(wdog_irq_handler);
+    watchdog_init(WDOG_INTV_1_SEC, false);
+    watchdog_start();
+    Ok(())
+}
+decl_init!(watchdog_hw_init);

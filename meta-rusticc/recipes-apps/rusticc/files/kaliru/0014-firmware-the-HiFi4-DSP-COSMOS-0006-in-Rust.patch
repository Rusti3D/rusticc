@@ -0,0 +1,62 @@
+// The remoteproc trace buffer (src/hifi4/log.c): boot diagnostics Linux
+// reads as a flat string up to the first null byte.
+//
+// This file may be distributed under the terms of the GNU GPLv3 license.
+use crate::ctr::Global;
+
+pub const TRACE_BUF_SIZE: usize = 4096;
+
+// (in SRAM A1, the resource table's trace entry; placed by hifi4.ld)
+#[unsafe(link_section = ".trace_buf")]
+#[unsafe(no_mangle)]
+pub static trace_buffer: Global<[u8; TRACE_BUF_SIZE]> = Global::new([0; TRACE_BUF_SIZE]);
+
+static TRACE_POS: Global<u32> = Global::new(0);
+
+// An argument of lprintf()'s formats: %s, %lu, %lx
+pub enum L<'a> {
+    S(&'a [u8]),
+    U(u32),
+    X(u32),
+}
+
+// lprintf(): the literal parts and the arguments in turn
+pub fn lprintf(parts: &[L]) -> usize {
+    let mut temp = [0u8; 256];
+    let mut out = 0;
+    for p in parts {
+        let mut digits = [0u8; 10];
+        let s: &[u8] = match *p {
+            L::S(s) => s,
+            L::U(v) | L::X(v) => {
+                let base = if matches!(p, L::U(_)) { 10 } else { 16 };
+                let mut v = v;
+                let mut i = digits.len();
+                loop {
+                    i -= 1;
+                    digits[i] = b"0123456789abcdef"[(v % base) as usize];
+                    v /= base;
+                    if v == 0 {
+                        break;
+                    }
+                }
+                &digits[i..]
+            }
+        };
+        temp[out..out + s.len()].copy_from_slice(s);
+        out += s.len();
+    }
+
+    // Append directly with no gaps; when full, stop writing
+    let pos = *TRACE_POS.get() as usize;
+    if pos + out >= TRACE_BUF_SIZE {
+        return 0;
+    }
+    let buf = trace_buffer.get();
+    buf[pos..pos + out].copy_from_slice(&temp[..out]);
+    *TRACE_POS.get() = (pos + out) as u32;
+    // Null-terminate so Linux knows where the content ends (the next
+    // write overwrites it)
+    buf[pos + out] = 0;
+    out
+}

@@ -0,0 +1,80 @@
+// Watchdog driver for Allwinner R528/T113 HiFi4 DSP (lib/hifi4/watchdog.c)
+//
+// Copyright (C) 2025  James Turton <james.turton@gmx.com>
+//
+// This file may be distributed under the terms of the GNU GPLv3 license.
+use super::hal_core::{irq_enable_interrupt, irq_register};
+use super::{bit, reg32, IrqHandler, IRQ_DSP_WDOG, WDOG_BASE};
+use crate::ctr::Global;
+
+const WDOG_IRQ_EN: u32 = 0x00;
+const WDOG_IRQ_STA: u32 = 0x04;
+const WDOG_CTRL: u32 = 0x10;
+const WDOG_CFG: u32 = 0x14;
+const WDOG_MODE: u32 = 0x18;
+
+const WDOG_CTRL_KEY: u32 = 0x0A57 << 1;
+const WDOG_CTRL_RESTART: u32 = bit(0);
+const WDOG_CFG_KEY: u32 = 0x16AA << 16;
+const WDOG_CFG_SYS_RESET: u32 = 1;
+const WDOG_CFG_IRQ_ONLY: u32 = 2;
+const WDOG_MODE_KEY: u32 = 0x16AA << 16;
+const WDOG_MODE_EN: u32 = bit(0);
+const fn wdog_mode_intv(n: u32) -> u32 {
+    n << 4
+}
+
+// (wdog_intv_t)
+pub const WDOG_INTV_1_SEC: u32 = 0x01;
+
+static WDOG_HANDLER: Global<Option<IrqHandler>> = Global::new(None);
+static WDOG_INTERVAL: Global<u32> = Global::new(0);
+
+fn wdog_write_reg(offset: u32, value: u32) {
+    reg32(WDOG_BASE + offset).write(value)
+}
+
+fn wdog_irq_handler(_irq: u32) {
+    // Clear interrupt
+    wdog_write_reg(WDOG_IRQ_STA, bit(0));
+    if let Some(h) = *WDOG_HANDLER.get() {
+        h(0);
+    }
+}
+
+pub fn watchdog_init(interval: u32, reset_on_timeout: bool) {
+    watchdog_stop();
+
+    *WDOG_INTERVAL.get() = interval;
+
+    // Configure mode: reset or IRQ only
+    if reset_on_timeout {
+        wdog_write_reg(WDOG_CFG, WDOG_CFG_KEY | WDOG_CFG_SYS_RESET);
+    } else {
+        wdog_write_reg(WDOG_CFG, WDOG_CFG_KEY | WDOG_CFG_IRQ_ONLY);
+        wdog_write_reg(WDOG_IRQ_EN, bit(0));
+        irq_register(IRQ_DSP_WDOG, wdog_irq_handler);
+        irq_enable_interrupt(IRQ_DSP_WDOG);
+    }
+
+    // Clear any pending interrupt
+    wdog_write_reg(WDOG_IRQ_STA, bit(0));
+}
+
+pub fn watchdog_start() {
+    wdog_write_reg(WDOG_MODE, WDOG_MODE_KEY | WDOG_MODE_EN | wdog_mode_intv(*WDOG_INTERVAL.get()));
+    // Initial kick to start countdown
+    watchdog_kick();
+}
+
+pub fn watchdog_stop() {
+    wdog_write_reg(WDOG_MODE, WDOG_MODE_KEY);
+}
+
+pub fn watchdog_kick() {
+    wdog_write_reg(WDOG_CTRL, WDOG_CTRL_KEY | WDOG_CTRL_RESTART);
+}
+
+pub fn watchdog_set_handler(handler: IrqHandler) {
+    *WDOG_HANDLER.get() = Some(handler);
+}

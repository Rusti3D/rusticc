index 0000000..5331335
--- /dev/null
+++ b/firmware/src/hifi4/timer.rs
@@ -0,0 +1,73 @@
+// Timer functions for hifi4: the CCOUNT cycle counter and its CCOMPARE0
+// interrupt.
+//
+// Copyright (C) 2025  James Turton <james.turton@gmx.com>
+//
+// This file may be distributed under the terms of the GNU GPLv3 license.
+use super::irq::{irq_disable, irq_enable};
+use super::lib::hal_core::{irq_enable_interrupt, irq_register};
+use super::lib::IRQ_COMPARE0;
+use super::startup::hifi4_irq_shutdown;
+use crate::ctr::Global;
+use crate::generic::timer_irq::{timer_dispatch_many, timer_from_us};
+use crate::sched::{sched_add_timer, Timer, R, SF_RESCHEDULE};
+use crate::{decl_init, decl_shutdown};
+use core::arch::asm;
+use core::ptr::null_mut;
+
+fn ccompare0_irq_handler(_irq: u32) {
+    irq_disable();
+    let next = match timer_dispatch_many() {
+        Ok(next) => next,
+        Err(s) => hifi4_irq_shutdown(s),
+    };
+    timer_set(next);
+    irq_enable();
+}
+
+// Return the current time (in absolute clock ticks).
+pub fn timer_read_time() -> u32 {
+    let val: u32;
+    unsafe { asm!("rsr.ccount {0}", out(reg) val) };
+    val
+}
+
+fn timer_set(next: u32) {
+    unsafe { asm!("wsr.ccompare0 {0}", "rsync", in(reg) next) }
+}
+
+// Activate timer dispatch as soon as possible
+pub fn timer_kick() {
+    timer_set(timer_read_time().wrapping_add(500));
+}
+
+// Dummy timer to avoid scheduling a timer irq greater than 0xffffff
+unsafe fn timer_wrap_event(t: *mut Timer) -> R<u8> {
+    (*t).waketime = (*t).waketime.wrapping_add(0xffffff);
+    Ok(SF_RESCHEDULE)
+}
+static WRAP_TIMER: Global<Timer> = Global::new(Timer { next: null_mut(), func: Some(timer_wrap_event), waketime: 0xffffff });
+
+pub fn timer_reset() -> R {
+    if timer_from_us(100000) <= 0xffffff {
+        // Timer in sched.c already ensures the timer wont overflow
+        return Ok(());
+    }
+    sched_add_timer(WRAP_TIMER.get())
+}
+decl_shutdown!(timer_reset);
+
+/****************************************************************
+ * Setup and irqs
+ ****************************************************************/
+
+pub fn timer_hw_init() -> R {
+    // Reset CCOUNT to 0
+    unsafe { asm!("wsr.ccount {0}", "rsync", in(reg) 0u32) };
+    irq_register(IRQ_COMPARE0, ccompare0_irq_handler);
+    timer_reset()?;
+    timer_kick();
+    irq_enable_interrupt(IRQ_COMPARE0);
+    Ok(())
+}
+decl_init!(timer_hw_init);

diff --git a/firmware/src/hifi4/irq.rs b/firmware/src/hifi4/irq.rs
new file mode 100644
index 0000000..1517c8f
--- /dev/null
+++ b/firmware/src/hifi4/irq.rs
@@ -0,0 +1,48 @@
+// Interrupt functions on hifi4.
+//
+// Copyright (C) 2025  James Turton <james.turton@gmx.com>
+//
+// This file may be distributed under the terms of the GNU GPLv3 license.
+use super::lib::hal_core::{hal_get_intenable, hal_set_intenable, irq_global_disable, irq_global_enable};
+use crate::sched::R;
+use core::arch::asm;
+
+pub type IrqStatus = u32;
+
+// Disable hardware interrupts
+pub fn irq_disable() {
+    irq_global_disable();
+}
+
+// Enable hardware interrupts
+pub fn irq_enable() {
+    irq_global_enable();
+}
+
+// Disable hardware interrupts in not already disabled (the flag is the
+// INTENABLE register, as the C code saves; irq_restore() writes it back
+// and leaves PS.INTLEVEL raised)
+pub fn irq_save() -> IrqStatus {
+    let flag = hal_get_intenable();
+    irq_disable();
+    flag
+}
+
+// Restore hardware interrupts to state from flag returned by irq_save()
+pub fn irq_restore(flag: IrqStatus) {
+    hal_set_intenable(flag);
+}
+
+// Atomically enable hardware interrupts and sleep processor until next irq
+pub fn irq_wait() -> R {
+    irq_global_enable();
+    unsafe { asm!("waiti 0") };
+    irq_global_disable();
+    Ok(())
+}
+
+// Check if an interrupt is active (used only on architectures that do
+// not have hardware interrupts)
+pub fn irq_poll() -> R {
+    Ok(())
+}
diff --git a/firmware/src/hifi4/lib/ccu.rs b/firmware/src/hifi4/lib/ccu.rs
new file mode 100644
index 0000000..029b288
--- /dev/null
+++ b/firmware/src/hifi4/lib/ccu.rs
@@ -0,0 +1,36 @@
+// Clock Control Unit driver (lib/hifi4/ccu.c): the bus clocks the firmware enables
+//
+// Copyright (C) 2025  James Turton <james.turton@gmx.com>
+//
+// This file may be distributed under the terms of the GNU GPLv3 license.
+use super::{bit, reg32, CCU_BASE};
+
+const CCU_GPADC_BGR: u32 = 0x09EC;
+const CCU_MSGBOX_BGR: u32 = 0x071C;
+const CCU_GPADC_GATING: u32 = bit(0);
+const CCU_GPADC_RST: u32 = bit(16);
+const CCU_MSGBOX_GATING: u32 = bit(1);
+const CCU_MSGBOX_RST: u32 = bit(17);
+
+fn ccu_set_bits(offset: u32, bits: u32) {
+    reg32(CCU_BASE + offset).or(bits);
+}
+
+// (the C `for (volatile int i = 0; i < 100; i++);` for the clock to
+// stabilize)
+fn settle() {
+    let mut i = 0u32;
+    while unsafe { core::ptr::read_volatile(&i) } < 100 {
+        unsafe { core::ptr::write_volatile(&mut i, i + 1) };
+    }
+}
+
+pub fn ccu_gpadc_enable() {
+    ccu_set_bits(CCU_GPADC_BGR, CCU_GPADC_GATING | CCU_GPADC_RST);
+    settle();
+}
+
+pub fn ccu_msgbox_enable() {
+    ccu_set_bits(CCU_MSGBOX_BGR, CCU_MSGBOX_GATING | CCU_MSGBOX_RST);
+    settle();
+}
diff --git a/firmware/src/hifi4/lib/gpadc.rs b/firmware/src/hifi4/lib/gpadc.rs
new file mode 100644
index 0000000..192b8c5
--- /dev/null
+++ b/firmware/src/hifi4/lib/gpadc.rs
@@ -0,0 +1,111 @@
+// GPADC driver for Allwinner R528/T113 HiFi4 DSP (lib/hifi4/gpadc.c)
+//
+// Copyright (C) 2025  James Turton <james.turton@gmx.com>
+//
+// This file may be distributed under the terms of the GNU GPLv3 license.
+use super::ccu::ccu_gpadc_enable;
+use super::{bit, reg32, CLK_FREQ_HOSC, GPADC_BASE};
+
+const GPADC_SR_CON: u32 = 0x00;
+const GPADC_CTRL: u32 = 0x04;
+const GPADC_CS_EN: u32 = 0x08;
+const GPADC_FIFO_INTC: u32 = 0x0C;
+const GPADC_FIFO_INTS: u32 = 0x10;
+const GPADC_DATAL_INTC: u32 = 0x20;
+const GPADC_DATAH_INTC: u32 = 0x24;
+const GPADC_DATA_INTC: u32 = 0x28;
+const GPADC_DATAL_INTS: u32 = 0x30;
+const GPADC_DATAH_INTS: u32 = 0x34;
+const GPADC_DATA_INTS: u32 = 0x38;
+const GPADC_CH0_DATA: u32 = 0x80;
+
+const GPADC_CTRL_ADC_EN: u32 = bit(16);
+const GPADC_CTRL_WORK_MODE_MASK: u32 = 0x3 << 18;
+const GPADC_CTRL_WORK_MODE_SINGLE: u32 = 0 << 18;
+const GPADC_CTRL_WORK_MODE_CONT: u32 = 2 << 18;
+const GPADC_CTRL_ADC_AUTOCALI_EN: u32 = bit(23);
+
+pub const GPADC_MAX_CHANNELS: u32 = 4;
+pub const GPADC_MAX_VALUE: u32 = (1 << 12) - 1;
+
+// (gpadc_channel_t)
+pub type GpadcChannel = u32;
+
+fn gpadc_write_reg(offset: u32, value: u32) {
+    reg32(GPADC_BASE + offset).write(value)
+}
+
+fn gpadc_read_reg(offset: u32) -> u32 {
+    reg32(GPADC_BASE + offset).read()
+}
+
+pub fn gpadc_init(sample_rate: u32) {
+    ccu_gpadc_enable();
+
+    // Sample rate = HOSC / ((fs_div + 1) * (tacq + 1))
+    let tacq: u32 = 63;
+    let mut fs_div: u32 = 4;
+    if sample_rate > 0 {
+        let divisor = CLK_FREQ_HOSC / sample_rate.wrapping_mul(tacq + 1);
+        if divisor > 0 {
+            fs_div = divisor - 1;
+        }
+        if fs_div > 0xFFFF {
+            fs_div = 0xFFFF;
+        }
+    }
+    gpadc_write_reg(GPADC_SR_CON, (fs_div & 0xFFFF) | ((tacq & 0xFFFF) << 16));
+
+    // Auto-calibration, single conversion mode initially
+    gpadc_write_reg(GPADC_CTRL, GPADC_CTRL_ADC_AUTOCALI_EN | GPADC_CTRL_WORK_MODE_SINGLE);
+
+    // Disable all channels initially
+    gpadc_write_reg(GPADC_CS_EN, 0);
+
+    // Clear any pending interrupts
+    gpadc_write_reg(GPADC_FIFO_INTS, 0xFFFFFFFF);
+    gpadc_write_reg(GPADC_DATAL_INTS, 0xFFFFFFFF);
+    gpadc_write_reg(GPADC_DATAH_INTS, 0xFFFFFFFF);
+    gpadc_write_reg(GPADC_DATA_INTS, 0xFFFFFFFF);
+
+    // Disable all interrupts initially
+    gpadc_write_reg(GPADC_FIFO_INTC, 0);
+    gpadc_write_reg(GPADC_DATAL_INTC, 0);
+    gpadc_write_reg(GPADC_DATAH_INTC, 0);
+    gpadc_write_reg(GPADC_DATA_INTC, 0);
+}
+
+pub fn gpadc_channel_enable(channel: GpadcChannel) {
+    if channel >= GPADC_MAX_CHANNELS {
+        return;
+    }
+    gpadc_write_reg(GPADC_CS_EN, gpadc_read_reg(GPADC_CS_EN) | bit(channel));
+}
+
+pub fn gpadc_start_continuous(channel: GpadcChannel) {
+    if channel >= GPADC_MAX_CHANNELS {
+        return;
+    }
+    gpadc_channel_enable(channel);
+
+    // Continuous conversion mode
+    let ctrl = gpadc_read_reg(GPADC_CTRL);
+    gpadc_write_reg(GPADC_CTRL, (ctrl & !GPADC_CTRL_WORK_MODE_MASK) | GPADC_CTRL_WORK_MODE_CONT | GPADC_CTRL_ADC_EN);
+
+    gpadc_write_reg(GPADC_DATA_INTC, gpadc_read_reg(GPADC_DATA_INTC) | bit(channel));
+}
+
+pub fn gpadc_read_data(channel: GpadcChannel) -> u16 {
+    if channel >= GPADC_MAX_CHANNELS {
+        return 0;
+    }
+    (gpadc_read_reg(GPADC_CH0_DATA + channel * 4) & GPADC_MAX_VALUE) as u16
+}
+
+pub fn gpadc_has_data(channel: GpadcChannel) -> bool {
+    gpadc_read_reg(GPADC_DATA_INTS) & bit(channel) != 0
+}
+
+pub fn gpadc_clear_status(channel: GpadcChannel) {
+    gpadc_write_reg(GPADC_DATA_INTS, bit(channel));
+}
diff --git a/firmware/src/hifi4/lib/gpio.rs b/firmware/src/hifi4/lib/gpio.rs
new file mode 100644
index 0000000..f9b9259
--- /dev/null
+++ b/firmware/src/hifi4/lib/gpio.rs
@@ -0,0 +1,117 @@
+// GPIO driver for Allwinner R528/T113 HiFi4 DSP (lib/hifi4/gpio.c)
+//
+// Copyright (C) 2025  James Turton <james.turton@gmx.com>
+//
+// This file may be distributed under the terms of the GNU GPLv3 license.
+use super::hal_core::{intc_enable, intc_register};
+use super::{bit, reg32, INTC_GPIOB_NS, INTC_GPIOC_NS, INTC_GPIOD_NS, INTC_GPIOE_NS, INTC_GPIOF_NS, INTC_GPIOG_NS, PIO_BASE};
+
+const fn gpio_port_offset(n: u32) -> u32 {
+    0x30 * n
+}
+const GPIO_CFG0: u32 = 0x00;
+const GPIO_DAT: u32 = 0x10;
+const GPIO_PULL0: u32 = 0x24;
+const fn gpio_eint_base(n: u32) -> u32 {
+    PIO_BASE + 0x200 + n * 0x20
+}
+const GPIO_EINT_CTL: u32 = 0x10;
+const GPIO_EINT_STATUS: u32 = 0x14;
+
+pub const GPIO_MODE_INPUT: u32 = 0;
+pub const GPIO_MODE_OUTPUT: u32 = 1;
+pub const GPIO_PULL_NONE: u32 = 0;
+pub const GPIO_PULL_UP: u32 = 1;
+
+// GPIO pin descriptor (gpio_pin_t: an enum port and a uint8_t pin)
+#[repr(C)]
+#[derive(Clone, Copy)]
+pub struct GpioPinT {
+    pub port: u32,
+    pub pin: u8,
+}
+
+fn gpio_port_base(port: u32) -> u32 {
+    PIO_BASE + gpio_port_offset(port)
+}
+
+pub fn gpio_set_mode(pin: GpioPinT, mode: u32) {
+    let base = gpio_port_base(pin.port);
+    let r = reg32(base + GPIO_CFG0 + (pin.pin as u32 / 8) * 4);
+    let bit_offset = (pin.pin as u32 % 8) * 4;
+    r.write((r.read() & !(0x0F << bit_offset)) | (mode << bit_offset));
+}
+
+pub fn gpio_set_pull(pin: GpioPinT, pull: u32) {
+    let base = gpio_port_base(pin.port);
+    let r = reg32(base + GPIO_PULL0 + (pin.pin as u32 / 16) * 4);
+    let bit_offset = (pin.pin as u32 % 16) * 2;
+    r.write((r.read() & !(0x03 << bit_offset)) | (pull << bit_offset));
+}
+
+pub fn gpio_write(pin: GpioPinT, value: bool) {
+    let r = reg32(gpio_port_base(pin.port) + GPIO_DAT);
+    let dat = r.read();
+    r.write(if value { dat | bit(pin.pin as u32) } else { dat & !bit(pin.pin as u32) });
+}
+
+pub fn gpio_read(pin: GpioPinT) -> bool {
+    reg32(gpio_port_base(pin.port) + GPIO_DAT).read() & bit(pin.pin as u32) != 0
+}
+
+pub fn gpio_toggle(pin: GpioPinT) {
+    let r = reg32(gpio_port_base(pin.port) + GPIO_DAT);
+    r.write(r.read() ^ bit(pin.pin as u32));
+}
+
+// Handle GPIO external interrupts for a specific port (no pin handler is
+// ever configured by the firmware: the pending and enabled bits are
+// cleared, as the C code does, with nothing to call)
+fn gpio_irq_handler(port: u32) {
+    let base = gpio_eint_base(port);
+    let status = reg32(base + GPIO_EINT_STATUS).read();
+    let enabled = reg32(base + GPIO_EINT_CTL).read();
+    let mut pending = status & enabled;
+    while pending != 0 {
+        let pin = pending.trailing_zeros();
+        reg32(base + GPIO_EINT_STATUS).write(bit(pin));
+        pending &= !bit(pin);
+    }
+}
+
+fn gpio_pb_irq_handler(_irq: u32) {
+    gpio_irq_handler(1);
+}
+fn gpio_pc_irq_handler(_irq: u32) {
+    gpio_irq_handler(2);
+}
+fn gpio_pd_irq_handler(_irq: u32) {
+    gpio_irq_handler(3);
+}
+fn gpio_pe_irq_handler(_irq: u32) {
+    gpio_irq_handler(4);
+}
+fn gpio_pf_irq_handler(_irq: u32) {
+    gpio_irq_handler(5);
+}
+fn gpio_pg_irq_handler(_irq: u32) {
+    gpio_irq_handler(6);
+}
+
+pub fn gpio_init() {
+    // Register port interrupt handlers
+    intc_register(INTC_GPIOB_NS, gpio_pb_irq_handler);
+    intc_register(INTC_GPIOC_NS, gpio_pc_irq_handler);
+    intc_register(INTC_GPIOD_NS, gpio_pd_irq_handler);
+    intc_register(INTC_GPIOE_NS, gpio_pe_irq_handler);
+    intc_register(INTC_GPIOF_NS, gpio_pf_irq_handler);
+    intc_register(INTC_GPIOG_NS, gpio_pg_irq_handler);
+
+    // Enable port interrupts at the system level
+    intc_enable(INTC_GPIOB_NS);
+    intc_enable(INTC_GPIOC_NS);
+    intc_enable(INTC_GPIOD_NS);
+    intc_enable(INTC_GPIOE_NS);
+    intc_enable(INTC_GPIOF_NS);
+    intc_enable(INTC_GPIOG_NS);
+}
diff --git a/firmware/src/hifi4/lib/hal_core.rs b/firmware/src/hifi4/lib/hal_core.rs
new file mode 100644
index 0000000..390c9b3
--- /dev/null
+++ b/firmware/src/hifi4/lib/hal_core.rs
@@ -0,0 +1,224 @@
+// Core HAL implementation for Allwinner R528/T113 HiFi4 DSP (lib/hifi4/hal_core.c)
+//
+// Copyright (C) 2025  James Turton <james.turton@gmx.com>
+//
+// This file may be distributed under the terms of the GNU GPLv3 license.
+//
+// The HiFi4 DSP has a two-level interrupt structure: direct DSP core
+// interrupts (the Xtensa INTENABLE bits) and the DSP_INTC, which routes the
+// peripheral interrupts to one core interrupt (IRQ_INTC).
+use super::{bit, reg32, IrqHandler, IRQ_INTC, MAX_INTC_NUM, MAX_IRQ_NUM};
+use crate::ctr::Global;
+use core::arch::asm;
+
+// DSP Interrupt Controller
+const DSP_INTC_BASE: u32 = 0x01700800;
+const DSP_INTC_PEND0: u32 = 0x10;
+const DSP_INTC_EN0: u32 = 0x40;
+const DSP_INTC_EN1: u32 = 0x44;
+const DSP_INTC_EN2: u32 = 0x48;
+const DSP_INTC_MASK0: u32 = 0x50;
+const DSP_INTC_MASK1: u32 = 0x54;
+const DSP_INTC_MASK2: u32 = 0x58;
+
+// Handler tables: direct DSP core interrupts and DSP_INTC peripheral ones
+static IRQ_TABLE: Global<[Option<IrqHandler>; MAX_IRQ_NUM]> = Global::new([None; MAX_IRQ_NUM]);
+static INTC_TABLE: Global<[Option<IrqHandler>; MAX_INTC_NUM]> = Global::new([None; MAX_INTC_NUM]);
+
+/****************************************************************
+ * Xtensa special registers
+ ****************************************************************/
+
+#[inline(always)]
+pub fn xtensa_get_intenable() -> u32 {
+    let v: u32;
+    unsafe { asm!("rsr.intenable {0}", out(reg) v) };
+    v
+}
+
+#[inline(always)]
+pub fn xtensa_set_intenable(v: u32) {
+    unsafe { asm!("wsr.intenable {0}", "rsync", in(reg) v) }
+}
+
+#[inline(always)]
+pub fn xtensa_get_ps() -> u32 {
+    let v: u32;
+    unsafe { asm!("rsr.ps {0}", out(reg) v) };
+    v
+}
+
+#[inline(always)]
+pub fn xtensa_set_ps(v: u32) {
+    unsafe { asm!("wsr.ps {0}", "rsync", in(reg) v) }
+}
+
+#[inline(always)]
+fn xtensa_get_interrupt() -> u32 {
+    let v: u32;
+    unsafe { asm!("rsr.interrupt {0}", out(reg) v) };
+    v
+}
+
+#[inline(always)]
+fn xtensa_clear_interrupt(mask: u32) {
+    unsafe { asm!("wsr.intclear {0}", "rsync", in(reg) mask) }
+}
+
+// PS register bits
+const PS_INTLEVEL_MASK: u32 = 0x0F;
+pub const PS_EXCM: u32 = 0x10;
+
+/****************************************************************
+ * Interrupt management
+ ****************************************************************/
+
+pub fn irq_register(irq_num: u32, handler: IrqHandler) {
+    if irq_num as usize >= MAX_IRQ_NUM {
+        return;
+    }
+    IRQ_TABLE.get()[irq_num as usize] = Some(handler);
+}
+
+// Register handler for DSP_INTC peripheral interrupt
+pub fn intc_register(intc_num: u32, handler: IrqHandler) {
+    if intc_num as usize >= MAX_INTC_NUM {
+        return;
+    }
+    INTC_TABLE.get()[intc_num as usize] = Some(handler);
+}
+
+// Enable a direct DSP core interrupt (in the Xtensa INTENABLE register)
+pub fn irq_enable_interrupt(irq_num: u32) {
+    if irq_num as usize >= MAX_IRQ_NUM {
+        return;
+    }
+    xtensa_set_intenable(xtensa_get_intenable() | bit(irq_num));
+}
+
+// Enable a DSP_INTC peripheral interrupt
+pub fn intc_enable(intc_num: u32) {
+    if intc_num as usize >= MAX_INTC_NUM {
+        return;
+    }
+    let reg_offset = if intc_num < 32 {
+        DSP_INTC_EN0
+    } else if intc_num < 64 {
+        DSP_INTC_EN1
+    } else {
+        DSP_INTC_EN2
+    };
+    reg32(DSP_INTC_BASE + reg_offset).or(bit(intc_num % 32));
+    // Make sure IRQ_INTC is enabled at the core level
+    irq_enable_interrupt(IRQ_INTC);
+}
+
+pub fn irq_global_enable() {
+    // Set interrupt level to 0 (enable all interrupts)
+    xtensa_set_ps(xtensa_get_ps() & !PS_INTLEVEL_MASK);
+}
+
+pub fn irq_global_disable() {
+    // Set interrupt level to max (disable all interrupts)
+    xtensa_set_ps(xtensa_get_ps() | PS_INTLEVEL_MASK);
+}
+
+pub fn hal_get_intenable() -> u32 {
+    xtensa_get_intenable()
+}
+
+pub fn hal_set_intenable(irqs: u32) {
+    xtensa_set_intenable(irqs)
+}
+
+/****************************************************************
+ * Interrupt dispatch
+ ****************************************************************/
+
+// Dispatch the DSP_INTC peripheral interrupts (IRQ_INTC)
+fn dispatch_intc_interrupts() {
+    // (four pending / enable registers, as the C code reads)
+    for r in 0..4 {
+        let pending = reg32(DSP_INTC_BASE + DSP_INTC_PEND0 + r * 4).read();
+        let enabled = reg32(DSP_INTC_BASE + DSP_INTC_EN0 + r * 4).read();
+        let mut pending = pending & enabled;
+        while pending != 0 {
+            let b = pending.trailing_zeros();
+            let intc_num = (r * 32 + b) as usize;
+            if intc_num < MAX_INTC_NUM {
+                if let Some(h) = INTC_TABLE.get()[intc_num] {
+                    h(intc_num as u32);
+                }
+            }
+            pending &= !bit(b);
+        }
+    }
+}
+
+// The interrupt handler of the vectors (_xt_int_enter in startup.rs)
+#[unsafe(no_mangle)]
+pub extern "C" fn hal_irq_dispatch() {
+    let mut pending = xtensa_get_interrupt() & xtensa_get_intenable();
+    while pending != 0 {
+        let irq = pending.trailing_zeros();
+        if irq == IRQ_INTC {
+            dispatch_intc_interrupts();
+        } else if let Some(h) = IRQ_TABLE.get()[irq as usize] {
+            h(irq);
+        }
+        // Clear this interrupt if it's edge-triggered (level-triggered
+        // interrupts must be cleared at the source)
+        xtensa_clear_interrupt(bit(irq));
+        pending &= !bit(irq);
+    }
+}
+
+/****************************************************************
+ * Initialization
+ ****************************************************************/
+
+pub fn hal_init() {
+    // (the handler tables start empty: .bss)
+    // Disable all Xtensa core interrupt inputs
+    xtensa_set_intenable(0);
+    xtensa_clear_interrupt(0xFFFFFFFF);
+
+    // Disable all peripheral interrupts initially
+    reg32(DSP_INTC_BASE + DSP_INTC_EN0).write(0);
+    reg32(DSP_INTC_BASE + DSP_INTC_EN1).write(0);
+    reg32(DSP_INTC_BASE + DSP_INTC_EN2).write(0);
+
+    reg32(DSP_INTC_BASE + DSP_INTC_MASK0).write(0);
+    reg32(DSP_INTC_BASE + DSP_INTC_MASK1).write(0);
+    reg32(DSP_INTC_BASE + DSP_INTC_MASK2).write(0);
+
+    // Clear all pending interrupts in DSP_INTC (writing 1 clears)
+    reg32(DSP_INTC_BASE + DSP_INTC_PEND0).write(0xFFFFFFFF);
+    reg32(DSP_INTC_BASE + DSP_INTC_PEND0 + 4).write(0xFFFFFFFF);
+    reg32(DSP_INTC_BASE + DSP_INTC_PEND0 + 8).write(0xFFFFFFFF);
+
+    irq_global_enable();
+}
+
+// Restart the firmware from _start (hal_restart)
+pub fn hal_restart() -> ! {
+    irq_global_disable();
+    super::watchdog::watchdog_stop();
+    unsafe {
+        // Clear INTENABLE to prevent any interrupt from firing; reset
+        // processor state, clear EXCM and INTLEVEL (needed if called from
+        // an interrupt handler), then jump to the reset code
+        asm!(
+            "wsr.intenable {zero}",
+            "wsr.intclear {ones}",
+            "rsync",
+            "wsr.ps {zero}",
+            "rsync",
+            "jx {start}",
+            zero = in(reg) 0u32,
+            ones = in(reg) 0xFFFFFFFFu32,
+            start = in(reg) super::super::startup::_start as *const () as usize,
+            options(noreturn),
+        )
+    }
+}

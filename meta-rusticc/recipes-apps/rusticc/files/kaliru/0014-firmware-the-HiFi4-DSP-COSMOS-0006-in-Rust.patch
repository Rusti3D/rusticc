diff --git a/firmware/src/hifi4/lib/msgbox.rs b/firmware/src/hifi4/lib/msgbox.rs
new file mode 100644
index 0000000..d765a02
--- /dev/null
+++ b/firmware/src/hifi4/lib/msgbox.rs
@@ -0,0 +1,130 @@
+// Message Box driver for Allwinner R528/T113 HiFi4 DSP (lib/hifi4/msgbox.c)
+//
+// Copyright (C) 2025  James Turton <james.turton@gmx.com>
+//
+// This file may be distributed under the terms of the GNU GPLv3 license.
+//
+// Inter-processor communication between the ARM and DSP cores: 4 channels
+// of 8-deep 32-bit FIFOs, the DSP MSGBOX (local, receive) at 0x01701000
+// and the ARM one (remote, transmit) at 0x03003000.
+use super::ccu::ccu_msgbox_enable;
+use super::hal_core::{irq_enable_interrupt, irq_register};
+use super::{bit, reg32, IRQ_MSGBOX, MSGBOX_ARM_BASE, MSGBOX_DSP_BASE};
+use crate::ctr::Global;
+
+// (n = 0: the remote cpu is the ARM)
+const MSGBOX_RD_IRQ_EN: u32 = 0x0020;
+const MSGBOX_RD_IRQ_STATUS: u32 = 0x0024;
+const MSGBOX_WR_IRQ_EN: u32 = 0x0030;
+const MSGBOX_WR_IRQ_STATUS: u32 = 0x0034;
+const fn msgbox_fifo_status(p: u32) -> u32 {
+    0x0050 + p * 0x04
+}
+const fn msgbox_msg_status(p: u32) -> u32 {
+    0x0060 + p * 0x04
+}
+const fn msgbox_msg(p: u32) -> u32 {
+    0x0070 + p * 0x04
+}
+const fn msgbox_rd_irq_ch(p: u32) -> u32 {
+    bit(p * 2)
+}
+const fn msgbox_wr_irq_ch(p: u32) -> u32 {
+    bit(p * 2 + 1)
+}
+const MSGBOX_FIFO_FULL_FLAG: u32 = bit(0);
+const MSGBOX_MSG_NUM_MASK: u32 = 0x0F;
+pub const MSGBOX_NUM_CHANNELS: u32 = 4;
+
+// A received message's callback (msgbox_rx_callback_t, without its arg)
+pub type MsgboxRxCallback = fn(u8, u32);
+
+// (the tx callbacks: none is ever set)
+static RX_CALLBACKS: Global<[Option<MsgboxRxCallback>; MSGBOX_NUM_CHANNELS as usize]> = Global::new([None; MSGBOX_NUM_CHANNELS as usize]);
+
+fn local(offset: u32) -> &'static crate::reg::Reg<u32> {
+    reg32(MSGBOX_DSP_BASE + offset)
+}
+
+fn remote(offset: u32) -> &'static crate::reg::Reg<u32> {
+    reg32(MSGBOX_ARM_BASE + offset)
+}
+
+// Handles both RX (message received from ARM) and TX (FIFO has space)
+// interrupts
+fn msgbox_irq_handler(_irq: u32) {
+    let rd_status = local(MSGBOX_RD_IRQ_STATUS).read();
+    for ch in 0..MSGBOX_NUM_CHANNELS {
+        if rd_status & msgbox_rd_irq_ch(ch) != 0 {
+            // Clear interrupt by writing 1
+            local(MSGBOX_RD_IRQ_STATUS).write(msgbox_rd_irq_ch(ch));
+
+            // Read all available messages from this channel
+            let mut msg_count = local(msgbox_msg_status(ch)).read() & MSGBOX_MSG_NUM_MASK;
+            while msg_count > 0 {
+                let message = local(msgbox_msg(ch)).read();
+                if let Some(cb) = RX_CALLBACKS.get()[ch as usize] {
+                    cb(ch as u8, message);
+                }
+                msg_count = local(msgbox_msg_status(ch)).read() & MSGBOX_MSG_NUM_MASK;
+            }
+        }
+    }
+
+    let wr_status = remote(MSGBOX_WR_IRQ_STATUS).read();
+    for ch in 0..MSGBOX_NUM_CHANNELS {
+        if wr_status & msgbox_wr_irq_ch(ch) != 0 {
+            remote(MSGBOX_WR_IRQ_STATUS).write(msgbox_wr_irq_ch(ch));
+        }
+    }
+}
+
+pub fn msgbox_init() {
+    ccu_msgbox_enable();
+
+    *RX_CALLBACKS.get() = [None; MSGBOX_NUM_CHANNELS as usize];
+
+    // Disable all RX and TX interrupts
+    local(MSGBOX_RD_IRQ_EN).write(0);
+    remote(MSGBOX_WR_IRQ_EN).write(0);
+
+    // Clear any pending interrupts
+    local(MSGBOX_RD_IRQ_STATUS).write(0xFFFFFFFF);
+    remote(MSGBOX_WR_IRQ_STATUS).write(0xFFFFFFFF);
+
+    irq_register(IRQ_MSGBOX, msgbox_irq_handler);
+    irq_enable_interrupt(IRQ_MSGBOX);
+}
+
+pub fn msgbox_send(channel: u8, message: u32) -> i32 {
+    if channel as u32 >= MSGBOX_NUM_CHANNELS {
+        return -1;
+    }
+    if remote(msgbox_fifo_status(channel as u32)).read() & MSGBOX_FIFO_FULL_FLAG != 0 {
+        return -1; // FIFO full
+    }
+    remote(msgbox_msg(channel as u32)).write(message);
+    0
+}
+
+pub fn msgbox_recv_blocking(channel: u8) -> u32 {
+    if channel as u32 >= MSGBOX_NUM_CHANNELS {
+        return 0;
+    }
+    while local(msgbox_msg_status(channel as u32)).read() & MSGBOX_MSG_NUM_MASK == 0 {}
+    local(msgbox_msg(channel as u32)).read()
+}
+
+pub fn msgbox_set_rx_callback(channel: u8, callback: MsgboxRxCallback) {
+    if channel as u32 >= MSGBOX_NUM_CHANNELS {
+        return;
+    }
+    RX_CALLBACKS.get()[channel as usize] = Some(callback);
+}
+
+pub fn msgbox_enable_rx_irq(channel: u8) {
+    if channel as u32 >= MSGBOX_NUM_CHANNELS {
+        return;
+    }
+    local(MSGBOX_RD_IRQ_EN).or(msgbox_rd_irq_ch(channel as u32));
+}

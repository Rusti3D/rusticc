@@ -0,0 +1,106 @@
+// GPIO functions on hifi4.
+//
+// Copyright (C) 2025  James Turton <james.turton@gmx.com>
+//
+// This file may be distributed under the terms of the GNU GPLv3 license.
+use super::gpio_h::{GpioAdc, GpioIn, GpioOut, GpioOutVal, GpioPullUp, GpioPwm, SpiConfig};
+use super::irq::{irq_restore, irq_save};
+use super::lib::gpadc::{gpadc_channel_enable, gpadc_clear_status, gpadc_has_data, gpadc_init, gpadc_read_data, gpadc_start_continuous};
+#[allow(unused_imports)]
+use super::lib::gpadc::GPADC_MAX_VALUE;
+use super::lib::gpio::{gpio_init, gpio_read, gpio_set_mode, gpio_set_pull, gpio_toggle, gpio_write, GpioPinT, GPIO_MODE_INPUT, GPIO_MODE_OUTPUT, GPIO_PULL_NONE, GPIO_PULL_UP};
+use crate::generic::timer_irq::timer_from_us;
+use crate::sched::R;
+use crate::{decl_constant, decl_enumeration_range, decl_init, shutdown};
+
+decl_enumeration_range!("pin", "PB0", 1 * 32, 16); // 13 + 3 ADC pins
+decl_enumeration_range!("pin", "PC0", 2 * 32, 8);
+decl_enumeration_range!("pin", "PD0", 3 * 32, 23);
+decl_enumeration_range!("pin", "PE0", 4 * 32, 18);
+decl_enumeration_range!("pin", "PF0", 5 * 32, 7);
+decl_enumeration_range!("pin", "PG0", 6 * 32, 19);
+
+decl_constant!("ADC_MAX", GPADC_MAX_VALUE); // 12bit adc
+
+// (C: a uint8_t pin parameter)
+fn gpio_pin(pin: u32) -> GpioPinT {
+    let pin = pin as u8;
+    GpioPinT { port: (pin / 32) as u32, pin: pin % 32 }
+}
+
+pub fn gpio_out_setup(pin: u32, val: GpioOutVal) -> R<GpioOut> {
+    gpio_init();
+    let g = GpioOut { pin: gpio_pin(pin) };
+    gpio_out_reset(g, val)?;
+    Ok(g)
+}
+pub fn gpio_out_reset(g: GpioOut, val: GpioOutVal) -> R {
+    gpio_set_mode(g.pin, GPIO_MODE_OUTPUT);
+    gpio_out_write(g, val);
+    Ok(())
+}
+pub fn gpio_out_toggle_noirq(g: GpioOut) {
+    gpio_toggle(g.pin);
+}
+pub fn gpio_out_toggle(g: GpioOut) {
+    let flag = irq_save();
+    gpio_out_toggle_noirq(g);
+    irq_restore(flag);
+}
+pub fn gpio_out_write(g: GpioOut, val: u8) {
+    gpio_write(g.pin, val != 0);
+}
+pub fn gpio_in_setup(pin: u32, pull_up: GpioPullUp) -> R<GpioIn> {
+    gpio_init();
+    let g = GpioIn { pin: gpio_pin(pin) };
+    gpio_in_reset(g, pull_up)?;
+    Ok(g)
+}
+pub fn gpio_in_reset(g: GpioIn, pull_up: GpioPullUp) -> R {
+    gpio_set_mode(g.pin, GPIO_MODE_INPUT);
+    gpio_set_pull(g.pin, if pull_up != 0 { GPIO_PULL_UP } else { GPIO_PULL_NONE });
+    Ok(())
+}
+pub fn gpio_in_read(g: GpioIn) -> u8 {
+    gpio_read(g.pin) as u8
+}
+// (C: a uint8_t val, the low byte of the pwmcmds value; no hardware pwm)
+pub fn gpio_pwm_setup(pin: u32, _cycle_time: u32, _val: u16) -> R<GpioPwm> {
+    Ok(GpioPwm { pin: pin as u8 })
+}
+pub fn gpio_pwm_write(_g: GpioPwm, _val: u16) {}
+
+pub fn gpio_adc_setup(pin: u32) -> R<GpioAdc> {
+    let pin = pin as u8;
+    // Valid ADC pins PB13-PB15
+    if pin < (32 + 13) || pin > (32 + 13 + 3) {
+        shutdown!("Not a valid ADC pin");
+    }
+    let chan = (pin - (32 + 13)) as u32;
+    gpadc_channel_enable(chan);
+    gpadc_start_continuous(chan);
+    Ok(GpioAdc { chan })
+}
+pub fn adc_init() -> R {
+    gpadc_init(1000);
+    Ok(())
+}
+decl_init!(adc_init);
+pub fn gpio_adc_sample(g: GpioAdc) -> u32 {
+    if gpadc_has_data(g.chan) {
+        return 0;
+    }
+    timer_from_us(20)
+}
+pub fn gpio_adc_read(g: GpioAdc) -> R<u16> {
+    let data = gpadc_read_data(g.chan);
+    gpadc_clear_status(g.chan);
+    Ok(data)
+}
+pub fn gpio_adc_cancel_sample(_g: GpioAdc) {}
+
+pub fn spi_setup(_bus: u32, _mode: u8, _rate: u32) -> R<SpiConfig> {
+    Ok(SpiConfig::default())
+}
+pub fn spi_prepare(_config: SpiConfig) {}
+pub fn spi_transfer(_config: SpiConfig, _receive_data: u8, _data: &mut [u8]) {}

diff --git a/firmware/src/hifi4/com.rs b/firmware/src/hifi4/com.rs
new file mode 100644
index 0000000..a68c7aa
--- /dev/null
+++ b/firmware/src/hifi4/com.rs
@@ -0,0 +1,134 @@
+// Support for serial port over sharespace with msgbox interrupts: the
+// command receive and transmit buffers over the RPMsg endpoint
+// (src/hifi4/com.c).
+//
+// Copyright (C) 2026  James Turton <james.turton@gmx.com>
+//
+// This file may be distributed under the terms of the GNU GPLv3 license.
+use super::rpmsg::{rpmsg_sendto, RpmsgEndpoint, RPMSG_ADDR_ANY};
+use crate::command::{command_encode_and_frame, command_find_and_dispatch, CommandEncoder, SendArg};
+use crate::ctr::Global;
+use crate::generic::pgm::readp;
+use crate::sched::{sched_check_wake, sched_wake_task, TaskWake, R};
+use crate::{decl_constant, decl_task};
+use core::ptr::null_mut;
+
+const RX_BUFFER_SIZE: usize = 192;
+const TX_BUFFER_SIZE: usize = 192;
+
+static RECEIVE_BUF: Global<[u8; RX_BUFFER_SIZE]> = Global::new([0; RX_BUFFER_SIZE]);
+static RECEIVE_POS: Global<u8> = Global::new(0);
+static TRANSMIT_BUF: Global<[u8; TX_BUFFER_SIZE]> = Global::new([0; TX_BUFFER_SIZE]);
+static TRANSMIT_POS: Global<u8> = Global::new(0);
+
+decl_constant!("RECEIVE_WINDOW", RX_BUFFER_SIZE);
+decl_constant!("TRANSMIT_WINDOW", TX_BUFFER_SIZE);
+
+// The RPMsg endpoint (set by rpmsg_transport_init())
+static KLIPPER_EPT: Global<*mut RpmsgEndpoint> = Global::new(null_mut());
+
+pub fn com_set_endpoint(ept: &'static mut RpmsgEndpoint) {
+    *KLIPPER_EPT.get() = ept;
+}
+
+/****************************************************************
+ * Message block reading
+ ****************************************************************/
+
+static RPMSG_CONSUME_WAKE: Global<TaskWake> = Global::new(TaskWake::new());
+
+// Called from the RPMsg endpoint callback (interrupt context): copy the
+// payload into the receive buffer (dropping what does not fit)
+pub fn rpmsg_notify_rx(data: &[u8]) {
+    let rpos = *RECEIVE_POS.get() as usize;
+    let len = data.len().min(RX_BUFFER_SIZE - rpos);
+    if len > 0 {
+        RECEIVE_BUF.get()[rpos..rpos + len].copy_from_slice(&data[..len]);
+        *RECEIVE_POS.get() = (rpos + len) as u8;
+    }
+    sched_wake_task(RPMSG_CONSUME_WAKE.ptr());
+}
+
+// Process any incoming commands
+pub fn rpmsg_consume_task() -> R {
+    if !sched_check_wake(RPMSG_CONSUME_WAKE.ptr()) {
+        return Ok(());
+    }
+
+    let mut rpos = *RECEIVE_POS.get() as usize;
+    let mut pop_count = 0;
+
+    // Process a message block
+    let ret = command_find_and_dispatch(&RECEIVE_BUF.get()[..rpos], &mut pop_count)?;
+    if ret != 0 {
+        // Move buffer
+        let needcopy = rpos - pop_count;
+        if needcopy != 0 {
+            RECEIVE_BUF.get().copy_within(pop_count..rpos, 0);
+        }
+        rpos = needcopy;
+    }
+    *RECEIVE_POS.get() = rpos as u8;
+
+    if rpos != 0 {
+        sched_wake_task(RPMSG_CONSUME_WAKE.ptr());
+    }
+    Ok(())
+}
+decl_task!(rpmsg_consume_task);
+
+/****************************************************************
+ * Message block sending
+ ****************************************************************/
+
+static RPMSG_SEND_WAKE: Global<TaskWake> = Global::new(TaskWake::new());
+
+fn rpmsg_notify_send() {
+    sched_wake_task(RPMSG_SEND_WAKE.ptr());
+}
+
+pub fn rpmsg_send_task() -> R {
+    if !sched_check_wake(RPMSG_SEND_WAKE.ptr()) {
+        return Ok(());
+    }
+
+    let tpos = *TRANSMIT_POS.get() as usize;
+    let ept = *KLIPPER_EPT.get();
+    if tpos == 0 || ept.is_null() {
+        return Ok(());
+    }
+    let ept = unsafe { &*ept };
+
+    // Don't attempt to send until Linux has connected
+    if ept.dst == RPMSG_ADDR_ANY {
+        return Ok(());
+    }
+
+    // Send the entire pending buffer as one RPMsg message
+    if rpmsg_sendto(ept, &TRANSMIT_BUF.get()[..tpos]) < 0 {
+        // No TX buffer available - retry later
+        sched_wake_task(RPMSG_SEND_WAKE.ptr());
+        return Ok(());
+    }
+    *TRANSMIT_POS.get() = 0;
+    Ok(())
+}
+decl_task!(rpmsg_send_task);
+
+pub fn console_sendf(ce: &CommandEncoder, args: &[SendArg]) -> R {
+    // Verify space for message
+    let tpos = *TRANSMIT_POS.get() as usize;
+    let max_size = readp(&ce.max_size) as usize;
+    if tpos + max_size > TX_BUFFER_SIZE {
+        // Not enough space for message
+        return Ok(());
+    }
+
+    // Generate message
+    let msglen = command_encode_and_frame(&mut TRANSMIT_BUF.get()[tpos..], ce, args)?;
+
+    // Start message transmit
+    *TRANSMIT_POS.get() = (tpos + msglen) as u8;
+    rpmsg_notify_send();
+    Ok(())
+}

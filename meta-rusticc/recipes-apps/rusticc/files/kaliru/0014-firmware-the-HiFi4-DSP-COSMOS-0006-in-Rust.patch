diff --git a/firmware/src/hifi4/resource_table.rs b/firmware/src/hifi4/resource_table.rs
new file mode 100644
index 0000000..4025e43
--- /dev/null
+++ b/firmware/src/hifi4/resource_table.rs
@@ -0,0 +1,99 @@
+// The remoteproc resource table (src/hifi4/resource_table.c): the RPMsg
+// virtio device with its two vrings, and the trace buffer. Linux's ELF
+// loader finds it by its section.
+//
+// This file may be distributed under the terms of the GNU GPLv3 license.
+use super::log::{trace_buffer, TRACE_BUF_SIZE};
+use super::rpmsg::{RPMSG_NUM_BUFS, RPMSG_VRING_ALIGN, VRING_RX_ADDR, VRING_TX_ADDR};
+use core::mem::offset_of;
+
+const RSC_TRACE: u32 = 2;
+const RSC_VDEV: u32 = 3;
+const VIRTIO_ID_RPMSG: u32 = 7;
+
+#[repr(C)]
+struct FwRscVdevVring {
+    da: u32,
+    align: u32,
+    num: u32,
+    notifyid: u32,
+    reserved: u32,
+}
+
+#[repr(C)]
+struct FwRscVdev {
+    type_: u32,
+    id: u32,
+    notifyid: u32,
+    dfeatures: u32,
+    gfeatures: u32,
+    config_len: u32,
+    status: u8,
+    num_of_vrings: u8,
+    reserved: [u8; 2],
+    vring: [FwRscVdevVring; 2],
+}
+
+#[repr(C)]
+struct FwRscTrace {
+    type_: u32,
+    // (the trace buffer's address: a pointer, 32 bits here)
+    da: *const u8,
+    len: u32,
+    reserved: u32,
+    name: [u8; 32],
+}
+
+#[repr(C)]
+pub struct ResourceTable {
+    ver: u32,
+    num: u32,
+    reserved: [u32; 2],
+    offset: [u32; 2],
+    rpmsg_vdev: FwRscVdev,
+    trace: FwRscTrace,
+}
+
+unsafe impl Sync for ResourceTable {}
+
+const fn name32(s: &[u8]) -> [u8; 32] {
+    let mut n = [0; 32];
+    let mut i = 0;
+    while i < s.len() {
+        n[i] = s[i];
+        i += 1;
+    }
+    n
+}
+
+#[unsafe(link_section = ".resource_table")]
+#[unsafe(no_mangle)]
+#[used]
+pub static resource_table: ResourceTable = ResourceTable {
+    ver: 1,
+    num: 2,
+    reserved: [0; 2],
+    offset: [offset_of!(ResourceTable, rpmsg_vdev) as u32, offset_of!(ResourceTable, trace) as u32],
+    rpmsg_vdev: FwRscVdev {
+        type_: RSC_VDEV,
+        id: VIRTIO_ID_RPMSG,
+        notifyid: 0,
+        dfeatures: 1, // VIRTIO_RPMSG_F_NS
+        gfeatures: 0,
+        config_len: 0,
+        status: 0,
+        num_of_vrings: 2,
+        reserved: [0; 2],
+        vring: [
+            FwRscVdevVring { da: VRING_TX_ADDR, align: RPMSG_VRING_ALIGN, num: RPMSG_NUM_BUFS, notifyid: 0, reserved: 0 },
+            FwRscVdevVring { da: VRING_RX_ADDR, align: RPMSG_VRING_ALIGN, num: RPMSG_NUM_BUFS, notifyid: 1, reserved: 0 },
+        ],
+    },
+    trace: FwRscTrace {
+        type_: RSC_TRACE,
+        da: trace_buffer.ptr() as *const u8,
+        len: TRACE_BUF_SIZE as u32,
+        reserved: 0,
+        name: name32(b"dsp_trace"),
+    },
+};
diff --git a/firmware/src/hifi4/rpmsg.rs b/firmware/src/hifi4/rpmsg.rs

@@ -0,0 +1,325 @@
+// Minimal RPMsg/virtio implementation for bare-metal HiFi4 DSP
+// (src/hifi4/rpmsg.c, rpmsg.h, virtio_vring.h).
+//
+// Just enough of the virtio vring protocol and RPMsg framing to talk to
+// Linux's virtio_rpmsg_bus driver. The vrings and buffers live in SRAM A1,
+// uncached on both sides:
+//   TX (vring0): take an empty buffer Linux posted on avail, write a
+//     message into it, return it on used, kick Linux
+//   RX (vring1): take Linux's messages from avail, return the buffers on
+//     used, kick Linux
+//
+// Copyright (C) 2026  James Turton <james.turton@gmx.com>
+//
+// This file may be distributed under the terms of the GNU GPLv3 license.
+use super::log::{lprintf, L};
+use super::rpmsg_transport::rpmsg_kick;
+use crate::ctr::Global;
+use core::arch::asm;
+use core::ptr::{read_volatile, write_volatile};
+
+pub const RPMSG_NAME_SIZE: usize = 32;
+pub const RPMSG_BUF_SIZE: u32 = 512;
+const RPMSG_HDR_SIZE: u32 = 16;
+const RPMSG_DATA_SIZE: u32 = RPMSG_BUF_SIZE - RPMSG_HDR_SIZE;
+pub const RPMSG_ADDR_ANY: u32 = 0xFFFFFFFF;
+const RPMSG_NS_ADDR: u32 = 53;
+const RPMSG_NS_CREATE: u32 = 0;
+const RPMSG_MAX_ENDPOINTS: usize = 4;
+
+pub const RPMSG_VRING_ALIGN: u32 = 256;
+pub const RPMSG_NUM_BUFS: u32 = 16;
+pub const VRING_TX_ADDR: u32 = 0x00020000;
+pub const VRING_RX_ADDR: u32 = 0x00021000;
+
+// Endpoint receive callback: the source address and the payload
+pub type RpmsgRxCb = fn(u32, &[u8]);
+
+// An RPMsg endpoint
+pub struct RpmsgEndpoint {
+    pub addr: u32,
+    pub dst: u32,
+    name: [u8; RPMSG_NAME_SIZE],
+    cb: Option<RpmsgRxCb>,
+    active: bool,
+}
+
+impl RpmsgEndpoint {
+    const fn new() -> Self {
+        RpmsgEndpoint { addr: 0, dst: 0, name: [0; RPMSG_NAME_SIZE], cb: None, active: false }
+    }
+    // the name up to its null byte
+    fn name(&self) -> &[u8] {
+        let n = self.name.iter().position(|&c| c == 0).unwrap_or(RPMSG_NAME_SIZE);
+        &self.name[..n]
+    }
+}
+
+// A vring in shared memory: the descriptor table (16 byte entries: addr
+// u64, len u32, flags u16, next u16), the available ring (flags u16, idx
+// u16, ring u16[num]) and, aligned, the used ring (flags u16, idx u16,
+// ring {id u32, len u32}[num])
+#[derive(Clone, Copy)]
+struct Vring {
+    num: u32,
+    desc: u32,
+    avail: u32,
+    used: u32,
+}
+
+impl Vring {
+    const fn empty() -> Self {
+        Vring { num: 0, desc: 0, avail: 0, used: 0 }
+    }
+    fn init(num: u32, base: u32, align: u32) -> Self {
+        // the available ring and its used_event
+        let avail_size = 4 + 2 * num + 2;
+        let used_offset = (16 * num + avail_size + align - 1) & !(align - 1);
+        Vring { num, desc: base, avail: base + 16 * num, used: base + used_offset }
+    }
+    fn avail_idx(&self) -> u16 {
+        unsafe { read_volatile((self.avail + 2) as usize as *const u16) }
+    }
+    fn avail_ring(&self, i: u32) -> u16 {
+        unsafe { read_volatile((self.avail + 4 + 2 * i) as usize as *const u16) }
+    }
+    fn used_idx(&self) -> u16 {
+        unsafe { read_volatile((self.used + 2) as usize as *const u16) }
+    }
+    // the buffer of a descriptor (the low word of its 64bit address)
+    fn desc_addr(&self, i: u32) -> *mut u8 {
+        unsafe { read_volatile((self.desc + 16 * i) as usize as *const u32) as usize as *mut u8 }
+    }
+}
+
+struct State {
+    rx_vring: Vring,
+    rx_last_avail_idx: u16,
+    tx_vring: Vring,
+    tx_last_avail_idx: u16,
+    endpoints: [RpmsgEndpoint; RPMSG_MAX_ENDPOINTS],
+    rpmsg_ready: bool,
+    // endpoints waiting to be announced to Linux (deferred until Linux has
+    // populated the TX vring)
+    pending_announcements: bool,
+}
+
+static STATE: Global<State> = Global::new(State {
+    rx_vring: Vring::empty(),
+    rx_last_avail_idx: 0,
+    tx_vring: Vring::empty(),
+    tx_last_avail_idx: 0,
+    endpoints: [const { RpmsgEndpoint::new() }; RPMSG_MAX_ENDPOINTS],
+    rpmsg_ready: false,
+    pending_announcements: false,
+});
+
+// Memory barrier: the other processor sees our writes in order
+#[inline(always)]
+fn mb() {
+    unsafe { asm!("memw") }
+}
+
+// The next available descriptor index of a vring, or -1
+fn vring_get_avail(vr: &Vring, last_avail_idx: &mut u16) -> i32 {
+    mb();
+    if *last_avail_idx == vr.avail_idx() {
+        return -1; // No new buffers
+    }
+    let desc_idx = vr.avail_ring(*last_avail_idx as u32 % vr.num);
+    *last_avail_idx = last_avail_idx.wrapping_add(1);
+    desc_idx as i32
+}
+
+// Return a descriptor to the other side on the used ring
+fn vring_put_used(vr: &Vring, desc_idx: u16, len: u32) {
+    let used_idx = vr.used_idx() as u32 % vr.num;
+    let elem = (vr.used + 4 + 8 * used_idx) as usize as *mut u32;
+    unsafe {
+        write_volatile(elem, desc_idx as u32);
+        write_volatile(elem.add(1), len);
+    }
+    mb();
+    unsafe { write_volatile((vr.used + 2) as usize as *mut u16, vr.used_idx().wrapping_add(1)) };
+    mb();
+}
+
+fn find_endpoint(st: &mut State, addr: u32) -> Option<&mut RpmsgEndpoint> {
+    st.endpoints.iter_mut().find(|e| e.active && e.addr == addr)
+}
+
+// Send a name service announcement to Linux: the endpoint's name, address
+// and flags
+fn rpmsg_ns_announce(addr: u32, name: &[u8; RPMSG_NAME_SIZE], flags: u32) -> i32 {
+    let mut ns_msg = [0u8; RPMSG_NAME_SIZE + 8];
+    ns_msg[..RPMSG_NAME_SIZE].copy_from_slice(name);
+    ns_msg[RPMSG_NAME_SIZE..RPMSG_NAME_SIZE + 4].copy_from_slice(&addr.to_le_bytes());
+    ns_msg[RPMSG_NAME_SIZE + 4..].copy_from_slice(&flags.to_le_bytes());
+    rpmsg_send(addr, RPMSG_NS_ADDR, &ns_msg)
+}
+
+pub fn rpmsg_init(tx_vring_addr: u32, rx_vring_addr: u32, num_bufs: u32) {
+    let st = STATE.get();
+    st.tx_vring = Vring::init(num_bufs, tx_vring_addr, RPMSG_VRING_ALIGN);
+    st.tx_last_avail_idx = 0;
+    st.rx_vring = Vring::init(num_bufs, rx_vring_addr, RPMSG_VRING_ALIGN);
+    st.rx_last_avail_idx = 0;
+    st.endpoints = [const { RpmsgEndpoint::new() }; RPMSG_MAX_ENDPOINTS];
+    st.rpmsg_ready = true;
+
+    lprintf(&[
+        L::S(b"rpmsg: initialized, tx_vring@0x"),
+        L::X(tx_vring_addr),
+        L::S(b" rx_vring@0x"),
+        L::X(rx_vring_addr),
+        L::S(b" num="),
+        L::U(num_bufs),
+        L::S(b"\n"),
+    ]);
+}
+
+// Create an endpoint (announced to Linux by rpmsg_process(): Linux has not
+// populated the TX vring yet)
+pub fn rpmsg_create_ept(name: &[u8], addr: u32, cb: RpmsgRxCb) -> Option<&'static mut RpmsgEndpoint> {
+    let st = STATE.get();
+    let Some(ept) = st.endpoints.iter_mut().find(|e| !e.active) else {
+        lprintf(&[L::S(b"rpmsg: no free endpoint slots\n")]);
+        return None;
+    };
+    *ept = RpmsgEndpoint::new();
+    ept.addr = addr;
+    ept.dst = RPMSG_ADDR_ANY;
+    ept.cb = Some(cb);
+    ept.active = true;
+    ept.name[..name.len()].copy_from_slice(name);
+
+    lprintf(&[L::S(b"rpmsg: created endpoint \""), L::S(name), L::S(b"\" addr="), L::U(addr), L::S(b"\n")]);
+
+    st.pending_announcements = true;
+    Some(ept)
+}
+
+// Send a message from a local endpoint address to a remote one
+fn rpmsg_send(src: u32, dst: u32, data: &[u8]) -> i32 {
+    let st = STATE.get();
+    if !st.rpmsg_ready {
+        return -1;
+    }
+    let len = data.len() as u32;
+    if len > RPMSG_DATA_SIZE {
+        return -2;
+    }
+
+    // An empty buffer from the TX vring's available ring
+    let desc_idx = vring_get_avail(&st.tx_vring, &mut st.tx_last_avail_idx);
+    if desc_idx < 0 {
+        lprintf(&[L::S(b"rpmsg: TX no available buffers\n")]);
+        return -3;
+    }
+
+    // The message: its header (src, dst, reserved, len u16, flags u16),
+    // then the payload
+    let hdr = st.tx_vring.desc_addr(desc_idx as u32);
+    unsafe {
+        write_volatile(hdr as *mut u32, src);
+        write_volatile(hdr.add(4) as *mut u32, dst);
+        write_volatile(hdr.add(8) as *mut u32, 0);
+        write_volatile(hdr.add(12) as *mut u16, len as u16);
+        write_volatile(hdr.add(14) as *mut u16, 0);
+        core::ptr::copy_nonoverlapping(data.as_ptr(), hdr.add(RPMSG_HDR_SIZE as usize), data.len());
+    }
+    mb();
+
+    // Return the filled buffer via the used ring, kick Linux (vring0)
+    vring_put_used(&st.tx_vring, desc_idx as u16, RPMSG_HDR_SIZE + len);
+    rpmsg_kick(0);
+    0
+}
+
+// Send a message to the endpoint's remote address (set when Linux first
+// sends to it)
+pub fn rpmsg_sendto(ept: &RpmsgEndpoint, data: &[u8]) -> i32 {
+    if ept.dst == RPMSG_ADDR_ANY {
+        lprintf(&[L::S(b"rpmsg: endpoint \""), L::S(ept.name()), L::S(b"\" has no remote dst yet\n")]);
+        return -4;
+    }
+    rpmsg_send(ept.addr, ept.dst, data)
+}
+
+// Process incoming messages (from the MSGBOX interrupt): the deferred name
+// service announcements, then the RX vring's messages to their endpoints
+pub fn rpmsg_process() -> i32 {
+    let st = STATE.get();
+    if !st.rpmsg_ready {
+        return 0;
+    }
+
+    if st.pending_announcements {
+        for i in 0..RPMSG_MAX_ENDPOINTS {
+            if !st.endpoints[i].active {
+                continue;
+            }
+            let (addr, name) = (st.endpoints[i].addr, st.endpoints[i].name);
+            let n = &name[..name.iter().position(|&c| c == 0).unwrap_or(RPMSG_NAME_SIZE)];
+            if rpmsg_ns_announce(addr, &name, RPMSG_NS_CREATE) == 0 {
+                lprintf(&[L::S(b"rpmsg: announced \""), L::S(n), L::S(b"\" to Linux\n")]);
+            } else {
+                lprintf(&[L::S(b"rpmsg: failed to announce \""), L::S(n), L::S(b"\"\n")]);
+            }
+        }
+        st.pending_announcements = false;
+    }
+
+    let mut processed = 0;
+    loop {
+        let desc_idx = vring_get_avail(&st.rx_vring, &mut st.rx_last_avail_idx);
+        if desc_idx < 0 {
+            break;
+        }
+        let hdr = st.rx_vring.desc_addr(desc_idx as u32);
+        let (src, dst, len) = unsafe {
+            (read_volatile(hdr as *const u32), read_volatile(hdr.add(4) as *const u32), read_volatile(hdr.add(12) as *const u16))
+        };
+
+        if let Some(ept) = find_endpoint(st, dst) {
+            // The remote address for rpmsg_sendto()
+            if ept.dst == RPMSG_ADDR_ANY {
+                ept.dst = src;
+            }
+            if let Some(cb) = ept.cb {
+                cb(src, unsafe { core::slice::from_raw_parts(hdr.add(RPMSG_HDR_SIZE as usize), len as usize) });
+            }
+        } else {
+            lprintf(&[L::S(b"rpmsg: no endpoint for dst="), L::U(dst), L::S(b" (from src="), L::U(src), L::S(b")\n")]);
+        }
+
+        // Return the buffer to Linux via the used ring
+        vring_put_used(&st.rx_vring, desc_idx as u16, RPMSG_BUF_SIZE);
+        processed += 1;
+    }
+
+    // Kick Linux: buffers returned (vring1)
+    if processed > 0 {
+        rpmsg_kick(1);
+    }
+    processed
+}
+
+// The TX vring's available index: how many empty buffers Linux has posted
+// (0 on a cold boot)
+pub fn rpmsg_tx_avail_idx() -> u16 {
+    mb();
+    STATE.get().tx_vring.avail_idx()
+}
+
+// After a warm restart: match Linux's current position
+pub fn rpmsg_sync_indices() {
+    mb();
+    let st = STATE.get();
+    st.rx_last_avail_idx = st.rx_vring.avail_idx();
+    st.tx_last_avail_idx = st.tx_vring.used_idx();
+}
+
+pub fn rpmsg_clear_pending_announcements() {
+    STATE.get().pending_announcements = false;
+}
diff --git a/firmware/src/hifi4/rpmsg_transport.rs b/firmware/src/hifi4/rpmsg_transport.rs
new file mode 100644
index 0000000..bd9614d
--- /dev/null
+++ b/firmware/src/hifi4/rpmsg_transport.rs
@@ -0,0 +1,73 @@
+// RPMsg transport integration for HiFi4 DSP: the MSGBOX hardware kicks
+// and the RPMsg virtio layer (src/hifi4/rpmsg_transport.c).
+//
+// Copyright (C) 2026  James Turton <james.turton@gmx.com>
+//
+// This file may be distributed under the terms of the GNU GPLv3 license.
+use super::com::{com_set_endpoint, rpmsg_notify_rx};
+use super::lib::msgbox::{msgbox_enable_rx_irq, msgbox_init, msgbox_recv_blocking, msgbox_send, msgbox_set_rx_callback};
+use super::log::{lprintf, L};
+use super::rpmsg::{
+    rpmsg_clear_pending_announcements, rpmsg_create_ept, rpmsg_init, rpmsg_process, rpmsg_sync_indices, rpmsg_tx_avail_idx, RPMSG_NUM_BUFS,
+    VRING_RX_ADDR, VRING_TX_ADDR,
+};
+use crate::decl_init;
+use crate::sched::R;
+
+// The MSGBOX channels of the RPMsg kicks (the mboxes of the device tree)
+const MSGBOX_RPMSG_RX_CHANNEL: u8 = 0;
+const MSGBOX_RPMSG_TX_CHANNEL: u8 = 0;
+
+// Notify Linux that we've updated a vring (0: TX, 1: RX)
+pub fn rpmsg_kick(vq_id: u32) {
+    msgbox_send(MSGBOX_RPMSG_TX_CHANNEL, vq_id);
+}
+
+// Linux kicked us: process its messages
+fn rpmsg_msgbox_rx_callback(_channel: u8, _message: u32) {
+    rpmsg_process();
+}
+
+// Linux's messages to the "rpmsg-tty" endpoint: the command receive
+// pipeline
+fn klipper_rpmsg_cb(_src: u32, data: &[u8]) {
+    rpmsg_notify_rx(data);
+}
+
+pub fn rpmsg_transport_init() -> R {
+    lprintf(&[L::S(b"rpmsg: initializing transport\n")]);
+
+    msgbox_init();
+    rpmsg_init(VRING_TX_ADDR, VRING_RX_ADDR, RPMSG_NUM_BUFS);
+
+    // On a cold boot the TX vring has no buffers yet (avail->idx == 0);
+    // after a soft reset Linux never tore it down
+    let cold_boot = rpmsg_tx_avail_idx() == 0;
+    if cold_boot {
+        // Wait for Linux to finish virtio setup
+        msgbox_recv_blocking(MSGBOX_RPMSG_RX_CHANNEL);
+    } else {
+        rpmsg_sync_indices();
+    }
+
+    // Create the endpoint before enabling irqs
+    let Some(ept) = rpmsg_create_ept(b"rpmsg-tty", 1024, klipper_rpmsg_cb) else {
+        return Ok(());
+    };
+    if cold_boot {
+        com_set_endpoint(ept);
+        // The name service announcement and any pending messages, before
+        // the MSGBOX irq is enabled
+        rpmsg_process();
+    } else {
+        // Warm restart: Linux already knows us, at the address it assigned
+        ept.dst = 0x400;
+        com_set_endpoint(ept);
+        rpmsg_clear_pending_announcements();
+    }
+
+    msgbox_set_rx_callback(MSGBOX_RPMSG_RX_CHANNEL, rpmsg_msgbox_rx_callback);
+    msgbox_enable_rx_irq(MSGBOX_RPMSG_RX_CHANNEL);
+    Ok(())
+}
+decl_init!(rpmsg_transport_init);
diff --git a/firmware/src/hifi4/startup.rs b/firmware/src/hifi4/startup.rs
new file mode 100644
index 0000000..6e1b982
--- /dev/null
+++ b/firmware/src/hifi4/startup.rs
@@ -0,0 +1,352 @@
+// The reset code and the interrupt / exception vectors of the HiFi4 DSP
+// (lib/hifi4/startup.S, lib/hifi4/vectors.S), the call0 ABI. The literals
+// are explicit l32r words: hifi4.ld places every literal section before
+// the code.
+//
+// Copyright (C) 2025  James Turton <james.turton@gmx.com>
+//
+// This file may be distributed under the terms of the GNU GPLv3 license.
+use crate::sched::{sched_main_loop, Shutdown};
+use core::arch::{asm, global_asm};
+
+unsafe extern "C" {
+    pub fn _start();
+    static __stack: u8;
+}
+
+global_asm!(
+    // Reset vector: jump to _start
+    ".section .ResetVector.literal, \"a\"",
+    ".align 4",
+    ".Lstart_addr:",
+    ".word _start",
+    ".section .ResetVector.text, \"ax\"",
+    ".global _ResetVector",
+    ".align 4",
+    "_ResetVector:",
+    "l32r a0, .Lstart_addr",
+    "jx a0",
+    // _start's literals
+    ".section .literal.hifi4_start, \"ax\"",
+    ".align 4",
+    ".Lvecbase: .word _memmap_vecbase_reset",
+    ".Lstack: .word __stack",
+    ".Lrodata_lma: .word _rodata_lma",
+    ".Lrodata_start: .word _rodata_start",
+    ".Lrodata_end: .word _rodata_end",
+    ".Ldata_lma: .word _data_lma",
+    ".Ldata_start: .word _data_start",
+    ".Ldata_end: .word _data_end",
+    ".Lbss_start: .word _bss_start",
+    ".Lbss_end: .word _bss_end",
+    ".Lhang_addr: .word .Lhang",
+    ".section .text.hifi4_start, \"ax\"",
+    ".align 4",
+    ".global _start",
+    ".type _start, @function",
+    "_start:",
+    // Initialize PS: PS.WOE=0 (no windowed calls), INTLEVEL=0, EXCM=0
+    "movi a2, 0",
+    "wsr.ps a2",
+    "rsync",
+    // Set interrupt vector base
+    "l32r a2, .Lvecbase",
+    "wsr.vecbase a2",
+    "rsync",
+    // Initialize stack pointer
+    "l32r a1, .Lstack",
+    // Copy .rodata and .data from IRAM (LMA) to DRAM0 (VMA): IRAM only
+    // supports 32-bit aligned access, so word reads and writes
+    "l32r a2, .Lrodata_lma",
+    "l32r a3, .Lrodata_start",
+    "l32r a4, .Lrodata_end",
+    ".Lrodata_copy:",
+    "bgeu a3, a4, .Lrodata_done",
+    "l32i a5, a2, 0",
+    "s32i a5, a3, 0",
+    "addi a2, a2, 4",
+    "addi a3, a3, 4",
+    "j .Lrodata_copy",
+    ".Lrodata_done:",
+    "l32r a2, .Ldata_lma",
+    "l32r a3, .Ldata_start",
+    "l32r a4, .Ldata_end",
+    ".Ldata_copy:",
+    "bgeu a3, a4, .Ldata_done",
+    "l32i a5, a2, 0",
+    "s32i a5, a3, 0",
+    "addi a2, a2, 4",
+    "addi a3, a3, 4",
+    "j .Ldata_copy",
+    ".Ldata_done:",
+    // Clear BSS before calling main
+    "l32r a2, .Lbss_start",
+    "l32r a3, .Lbss_end",
+    "movi a4, 0",
+    ".Lbss_loop:",
+    "bgeu a2, a3, .Lbss_done",
+    "s32i a4, a2, 0",
+    "addi a2, a2, 4",
+    "j .Lbss_loop",
+    ".Lbss_done:",
+    // Return address: the hang loop, in case main returns
+    "l32r a0, .Lhang_addr",
+    "call0 main",
+    // (a call0 target: 4-byte aligned, which GNU as does by itself)
+    ".align 4",
+    ".Lhang:",
+    "call0 .Lhang",
+    // The shared interrupt entry: called from the level vectors with a0 =
+    // the interrupt level and the interrupted a0 in EXCSAVEn
+    ".set FRAME_PC, 0",
+    ".set FRAME_PS, 4",
+    ".set FRAME_A0, 8",
+    ".set FRAME_A2, 16",
+    ".set FRAME_A3, 20",
+    ".set FRAME_A4, 24",
+    ".set FRAME_A5, 28",
+    ".set FRAME_A6, 32",
+    ".set FRAME_A7, 36",
+    ".set FRAME_A8, 40",
+    ".set FRAME_A9, 44",
+    ".set FRAME_A10, 48",
+    ".set FRAME_A11, 52",
+    ".set FRAME_A12, 56",
+    ".set FRAME_A13, 60",
+    ".set FRAME_A14, 64",
+    ".set FRAME_A15, 68",
+    ".set FRAME_SAR, 72",
+    ".set FRAME_LEVEL, 76",
+    ".set FRAME_LBEG, 80",
+    ".set FRAME_LEND, 84",
+    ".set FRAME_LCOUNT, 88",
+    ".set FRAME_SIZE, 96",
+    ".section ._xt_int_enter.literal, \"a\"",
+    ".align 4",
+    ".L_handler:",
+    ".word hal_irq_dispatch",
+    ".section .text._xt_int_enter, \"ax\"",
+    ".global _xt_int_enter",
+    ".type _xt_int_enter, @function",
+    ".align 4",
+    "_xt_int_enter:",
+    "addi a1, a1, -FRAME_SIZE",
+    "s32i a0, a1, FRAME_LEVEL",
+    "s32i a2, a1, FRAME_A2",
+    "s32i a3, a1, FRAME_A3",
+    "s32i a4, a1, FRAME_A4",
+    "s32i a5, a1, FRAME_A5",
+    "s32i a6, a1, FRAME_A6",
+    "s32i a7, a1, FRAME_A7",
+    "s32i a8, a1, FRAME_A8",
+    "s32i a9, a1, FRAME_A9",
+    "s32i a10, a1, FRAME_A10",
+    "s32i a11, a1, FRAME_A11",
+    "s32i a12, a1, FRAME_A12",
+    "s32i a13, a1, FRAME_A13",
+    "s32i a14, a1, FRAME_A14",
+    "s32i a15, a1, FRAME_A15",
+    "rsr a2, sar",
+    "s32i a2, a1, FRAME_SAR",
+    "rsr a2, lbeg",
+    "s32i a2, a1, FRAME_LBEG",
+    "rsr a2, lend",
+    "s32i a2, a1, FRAME_LEND",
+    "rsr a2, lcount",
+    "s32i a2, a1, FRAME_LCOUNT",
+    "beqi a0, 1, .Llevel1_save",
+    "beqi a0, 2, .Llevel2_save",
+    "beqi a0, 3, .Llevel3_save",
+    "beqi a0, 4, .Llevel4_save",
+    "beqi a0, 5, .Llevel5_save",
+    "j .Lsave_done",
+    ".Llevel1_save:",
+    "rsr a2, excsave1",
+    "s32i a2, a1, FRAME_A0",
+    "rsr a2, epc1",
+    "s32i a2, a1, FRAME_PC",
+    "j .Lsave_done",
+    ".Llevel2_save:",
+    "rsr a2, excsave2",
+    "s32i a2, a1, FRAME_A0",
+    "rsr a2, epc2",
+    "s32i a2, a1, FRAME_PC",
+    "rsr a2, eps2",
+    "s32i a2, a1, FRAME_PS",
+    "j .Lsave_done",
+    ".Llevel3_save:",
+    "rsr a2, excsave3",
+    "s32i a2, a1, FRAME_A0",
+    "rsr a2, epc3",
+    "s32i a2, a1, FRAME_PC",
+    "rsr a2, eps3",
+    "s32i a2, a1, FRAME_PS",
+    "j .Lsave_done",
+    ".Llevel4_save:",
+    "rsr a2, excsave4",
+    "s32i a2, a1, FRAME_A0",
+    "rsr a2, epc4",
+    "s32i a2, a1, FRAME_PC",
+    "rsr a2, eps4",
+    "s32i a2, a1, FRAME_PS",
+    "j .Lsave_done",
+    ".Llevel5_save:",
+    "rsr a2, excsave5",
+    "s32i a2, a1, FRAME_A0",
+    "rsr a2, epc5",
+    "s32i a2, a1, FRAME_PC",
+    "rsr a2, eps5",
+    "s32i a2, a1, FRAME_PS",
+    ".Lsave_done:",
+    "rsync",
+    "memw",
+    // Call the dispatcher with the level as argument
+    "l32i a2, a1, FRAME_LEVEL",
+    "l32r a0, .L_handler",
+    "callx0 a0",
+    "memw",
+    // Restore all registers
+    "l32i a2, a1, FRAME_LCOUNT",
+    "wsr a2, lcount",
+    "l32i a2, a1, FRAME_LBEG",
+    "wsr a2, lbeg",
+    "l32i a2, a1, FRAME_LEND",
+    "wsr a2, lend",
+    "l32i a2, a1, FRAME_SAR",
+    "wsr a2, sar",
+    "isync",
+    "l32i a15, a1, FRAME_A15",
+    "l32i a14, a1, FRAME_A14",
+    "l32i a13, a1, FRAME_A13",
+    "l32i a12, a1, FRAME_A12",
+    "l32i a11, a1, FRAME_A11",
+    "l32i a10, a1, FRAME_A10",
+    "l32i a9, a1, FRAME_A9",
+    "l32i a8, a1, FRAME_A8",
+    "l32i a7, a1, FRAME_A7",
+    "l32i a6, a1, FRAME_A6",
+    "l32i a5, a1, FRAME_A5",
+    "l32i a4, a1, FRAME_A4",
+    "l32i a3, a1, FRAME_A3",
+    "l32i a2, a1, FRAME_A2",
+    "l32i a0, a1, FRAME_A0",
+    "l32i a0, a1, FRAME_LEVEL",
+    "beqi a0, 1, .Llevel1_restore",
+    "beqi a0, 2, .Llevel2_restore",
+    "beqi a0, 3, .Llevel3_restore",
+    "beqi a0, 4, .Llevel4_restore",
+    "beqi a0, 5, .Llevel5_restore",
+    "rfe",
+    ".Llevel1_restore:",
+    "l32i a0, a1, FRAME_PC",
+    "wsr a0, epc1",
+    "addi a1, a1, FRAME_SIZE",
+    "rsr a0, excsave1",
+    "rfe",
+    ".Llevel2_restore:",
+    "l32i a0, a1, FRAME_PC",
+    "wsr a0, epc2",
+    "l32i a0, a1, FRAME_PS",
+    "wsr a0, eps2",
+    "addi a1, a1, FRAME_SIZE",
+    "rsr a0, excsave2",
+    "rfi 2",
+    ".Llevel3_restore:",
+    "l32i a0, a1, FRAME_PC",
+    "wsr a0, epc3",
+    "l32i a0, a1, FRAME_PS",
+    "wsr a0, eps3",
+    "addi a1, a1, FRAME_SIZE",
+    "rsr a0, excsave3",
+    "rfi 3",
+    ".Llevel4_restore:",
+    "l32i a0, a1, FRAME_PC",
+    "wsr a0, epc4",
+    "l32i a0, a1, FRAME_PS",
+    "wsr a0, eps4",
+    "addi a1, a1, FRAME_SIZE",
+    "rsr a0, excsave4",
+    // (rfdd: not in the LLVM assembler)
+    ".byte 0x10, 0xe0, 0xf1",
+    ".Llevel5_restore:",
+    "l32i a0, a1, FRAME_PC",
+    "wsr a0, epc5",
+    "l32i a0, a1, FRAME_PS",
+    "wsr a0, eps5",
+    "addi a1, a1, FRAME_SIZE",
+    "rsr a0, excsave5",
+    "rfe",
+    // Level 2 interrupt vector (medium priority interrupts)
+    ".section .Level2InterruptVector.text, \"ax\"",
+    ".global _Level2InterruptVector",
+    ".align 4",
+    "_Level2InterruptVector:",
+    "wsr a0, excsave2",
+    "movi a0, 2",
+    "j _xt_int_enter",
+    // Level 3 interrupt vector (high priority interrupts)
+    ".section .Level3InterruptVector.text, \"ax\"",
+    ".global _Level3InterruptVector",
+    ".align 4",
+    "_Level3InterruptVector:",
+    "wsr a0, excsave3",
+    "movi a0, 3",
+    "j _xt_int_enter",
+    // Debug exception vector
+    ".section .DebugExceptionVector.text, \"ax\"",
+    ".global _DebugExceptionVector",
+    ".align 4",
+    "_DebugExceptionVector:",
+    "wsr a0, excsave4",
+    "movi a0, 4",
+    "j _xt_int_enter",
+    // Kernel exception vector
+    ".section .KernelExceptionVector.text, \"ax\"",
+    ".global _KernelExceptionVector",
+    ".align 4",
+    "_KernelExceptionVector:",
+    "wsr a0, excsave1",
+    "movi a0, 1",
+    "j _xt_int_enter",
+    // User exception vector
+    ".section .UserExceptionVector.text, \"ax\"",
+    ".global _UserExceptionVector",
+    ".align 4",
+    "_UserExceptionVector:",
+    "wsr a0, excsave5",
+    "movi a0, 5",
+    "j _xt_int_enter",
+    // Double exception vector: hang
+    ".section .DoubleExceptionVector.text, \"ax\"",
+    ".global _DoubleExceptionVector",
+    ".align 4",
+    "_DoubleExceptionVector:",
+    "rsr a2, exccause",
+    "rsr a3, excvaddr",
+    ".Ldouble_hang:",
+    "j .Ldouble_hang",
+);
+
+// A shutdown inside an irq handler: C's longjmp() to sched_main() (it
+// leaves exception mode, PS.EXCM, and restores the stack), here a jump to
+// the top of the stack and sched_main_loop()
+pub fn hifi4_irq_shutdown(s: Shutdown) -> ! {
+    let ps = super::lib::hal_core::xtensa_get_ps() & !super::lib::hal_core::PS_EXCM;
+    unsafe {
+        asm!(
+            "wsr.ps {ps}",
+            "isync",
+            "mov a1, {stack}",
+            "jx {entry}",
+            ps = in(reg) ps,
+            stack = in(reg) core::ptr::addr_of!(__stack),
+            entry = in(reg) hifi4_irq_shutdown_entry as extern "C" fn(u32) -> !,
+            in("a2") s.reason() as u32,
+            options(noreturn),
+        )
+    }
+}
+
+extern "C" fn hifi4_irq_shutdown_entry(reason: u32) -> ! {
+    sched_main_loop(Some(reason as u8))
+}

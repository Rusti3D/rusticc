 # Output: src/plugins/mirror/<module>.py (one per klippy module) and
 # src/plugins/mirror_ids.rs (the ID -> qualified name table, same order).
 #
-# usage: gen_mirror.py KALICO_DIR OUT_DIR   (OUT_DIR = kaliru/src/plugins)
+# usage: gen_mirror.py KALICO_DIR OUT_DIR [BASE_IDS]   (OUT_DIR = kaliru/src/plugins)
+# BASE_IDS: an existing mirror_ids.rs whose IDs are kept, new names appended
+# (Rusticc mirrors its COSMOS reference, Kalico plus COSMOS's patches)
 import ast
 import builtins
 import pathlib
@@ -71,11 +73,16 @@ def statement_loads(node):
 
 
 class Ids:
-    def __init__(self):
-        self.names = []
+    def __init__(self, base=()):
+        # base: an earlier table whose IDs stay (new names are appended)
+        self.names = list(base)
+        self.index = {n: i for i, n in enumerate(self.names)}
 
     def new(self, qualname):
+        if qualname in self.index:
+            return self.index[qualname]
         self.names.append(qualname)
+        self.index[qualname] = len(self.names) - 1
         return len(self.names) - 1
 
 
@@ -386,7 +393,12 @@ def main():
     kalico, out = pathlib.Path(sys.argv[1]), pathlib.Path(sys.argv[2])

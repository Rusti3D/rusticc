+        base = [l.strip()[1:-2] for l in text.split("pub static IDS")[1].splitlines() if l.strip().startswith('"')]
+        rev = rev or text.splitlines()[0].split(" from Kalico ")[1].split(":")[0] + " with patches"
+    ids = Ids(base)
     mdir = out / "mirror"

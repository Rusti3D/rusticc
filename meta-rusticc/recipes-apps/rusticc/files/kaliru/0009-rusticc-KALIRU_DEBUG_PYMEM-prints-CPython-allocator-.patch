From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: shawn-makes-stuff <shawn.rains@rocketmail.com>
Date: Sat, 24 Oct 2026 21:17:51 +0300
Subject: [PATCH 09/20] rusticc: KALIRU_DEBUG_PYMEM prints CPython allocator
 stats (debugging)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/webhooks.rs | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/src/webhooks.rs b/src/webhooks.rs
index 44382cc..7ba4e39 100644
--- a/src/webhooks.rs
+++ b/src/webhooks.rs
@@ -983,6 +983,13 @@ impl QueryStatusHelper {
                     }
                     logging::info(&format!("debug_subs: {}", parts.join(" ")));
                 }
+                // KALIRU_DEBUG_PYMEM=1: CPython's allocator totals to stderr
+                #[cfg(feature = "plugins")]
+                if std::env::var_os("KALIRU_DEBUG_PYMEM").is_some() && crate::plugins::started() {
+                    if let Ok(f) = crate::plugins::py::lookup("sys", "_debugmallocstats") {
+                        let _ = f.call(&[]);
+                    }
+                }
             }
         }
         // Generate get_status() info for each client

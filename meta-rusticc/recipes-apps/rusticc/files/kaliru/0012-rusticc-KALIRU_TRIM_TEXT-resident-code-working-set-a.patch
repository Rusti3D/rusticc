 src/printer.rs  |  1 +
 src/webhooks.rs |  3 ++-
 3 files changed, 28 insertions(+), 1 deletion(-)

diff --git a/src/pcprof.rs b/src/pcprof.rs
index 9ef6a4b..c748a94 100644
--- a/src/pcprof.rs
+++ b/src/pcprof.rs
@@ -177,3 +177,28 @@ pub fn reactor_prof_tick(eventtime: f64) {
         crate::logging::info(&format!("reactor_prof: {:8.3}ms {:7} calls {}", *ns as f64 / 1e6, n, k));
     }
 }
+
+/// KALIRU_TRIM_TEXT=SECS: SECS seconds after start, drop the page-table
+/// entries of the executable's and libpython's code (MADV_DONTNEED on a
+/// private file mapping: the pages stay in the page cache and refault only
+/// where they run again), so resident code is the working set, not startup
+/// plus read-around (MADV_RANDOM first)
+pub fn trim_text_later() {
+    let Some(secs) = std::env::var("KALIRU_TRIM_TEXT").ok().and_then(|s| s.parse::<u64>().ok()) else { return };
+    std::thread::spawn(move || {
+        std::thread::sleep(std::time::Duration::from_secs(secs));
+        let exe = std::env::current_exe().map(|p| p.to_string_lossy().into_owned()).unwrap_or_default();
+        for l in std::fs::read_to_string("/proc/self/maps").unwrap_or_default().lines() {
+            let f: Vec<&str> = l.split_whitespace().collect();
+            if f.len() < 6 || !f[1].contains('x') || !(f[5] == exe || f[5].contains("libpython")) {
+                continue;
+            }
+            let Some((lo, hi)) = f[0].split_once('-') else { continue };
+            let (lo, hi) = (usize::from_str_radix(lo, 16).unwrap_or(0), usize::from_str_radix(hi, 16).unwrap_or(0));
+            unsafe {
+                libc::madvise(lo as *mut libc::c_void, hi - lo, libc::MADV_RANDOM);
+                libc::madvise(lo as *mut libc::c_void, hi - lo, libc::MADV_DONTNEED);
+            }
+        }
+    });
+}

new file mode 100644
index 0000000..9c17d5e
--- /dev/null
+++ b/rusticc/Cargo.toml
@@ -0,0 +1,32 @@
+# Rusticc's klippy binary: kaliru (this tree, with Rusticc's patches) and the
+# native plugins Rusticc ships (kaliru docs/PLUGINS.md, "Native plugins")
+[package]
+name = "rusticc"
+version = "0.1.0"
+edition = "2021"
+license = "GPL-3.0-only"
+publish = false
+
+[[bin]]
+name = "rusticc"
+path = "src/main.rs"
+
+[dependencies]
+kaliru = { path = "..", default-features = false, features = ["plugins"] }
+rust-afc = { git = "https://github.com/Rusti3D/Rust-AFC", rev = "3ea26b12f6d00b237d18aa1681735d227dd454ad" }
+
+# the plugins are built against this kaliru, not the one they name
+[patch."https://github.com/Rusti3D/kaliru"]
+kaliru = { path = ".." }
+
+[patch.crates-io]
+corosensei = { path = "../vendor/corosensei" }
+
+[profile.release]
+opt-level = "s"
+strip = true
+lto = true
+codegen-units = 1
+
+# (its own workspace: kaliru's tree is not one)
+[workspace]
diff --git a/rusticc/src/main.rs b/rusticc/src/main.rs
new file mode 100644
index 0000000..e4436fb
--- /dev/null
+++ b/rusticc/src/main.rs
@@ -0,0 +1,5 @@
+// Rusticc's klippy: kaliru with AFC built in (Rust-AFC); any other config
+// or AFC option runs as python on kaliru's plugin layer
+fn main() {
+    kaliru::native_plugin::main(&[rust_afc::PLUGIN]);
+}

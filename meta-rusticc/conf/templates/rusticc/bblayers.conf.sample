# POKY_BBLAYERS_CONF_VERSION is increased each time build/conf/bblayers.conf
# changes incompatibly
POKY_BBLAYERS_CONF_VERSION = "2"

BBPATH = "${TOPDIR}"
BBFILES ?= ""

BBLAYERS ?= " \
  ${TOPDIR}/../cosmos/openembedded-core/meta \
  ${TOPDIR}/../cosmos/meta-yocto/meta-poky \
  ${TOPDIR}/../cosmos/meta-yocto/meta-yocto-bsp \
  ${TOPDIR}/../cosmos/meta-sunxi \
  ${TOPDIR}/../cosmos/meta-arm/meta-arm \
  ${TOPDIR}/../cosmos/meta-arm/meta-arm-toolchain \
  ${TOPDIR}/../cosmos/meta-openembedded/meta-oe \
  ${TOPDIR}/../cosmos/meta-openembedded/meta-python \
  ${TOPDIR}/../cosmos/meta-openembedded/meta-networking \
  ${TOPDIR}/../cosmos/meta-swupdate \
  ${TOPDIR}/../cosmos/meta-opencentauri \
  ${TOPDIR}/../meta-rusticc \
  "
